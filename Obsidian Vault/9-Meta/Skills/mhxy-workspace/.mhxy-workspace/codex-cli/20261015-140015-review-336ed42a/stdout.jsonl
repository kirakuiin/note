y:\\n201:                 c.read_json(path)\\n202:             except Exception as error:\\n203:                 errors.append(error)\\n204: \\n205:     thread = threading.Thread(target=reader)\\n206:     thread.start()\\n207:     for n in range(200):\\n208:         c.write_json(path, {\\\"n\\\": n})\\n209:     thread.join()\\n210:     assert not errors\\n211: \\n212: \\n213: # ---- worker \\u4e0e\\u72b6\\u6001 ----\\n214: \\n215: def worker_job(tmp_path, **state):\\n216:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\", \\\"kind\\\": \\\"investigate\\\", \\\"root\\\": \\\"R\\\", **state})\\n217:     c.write_json(tmp_path / \\\"task.json\\\", {\\\"instructions\\\": \\\"x\\\"})\\n218:     return tmp_path\\n219: \\n220: \\n221: def test_worker_runs_once(tmp_path):\\n222:     job = worker_job(tmp_path)\\n223:     with patch.object(c, \\\"monitor\\\") as run:\\n224:         assert c.worker(job) == 0\\n225:         assert c.worker(job) == 1\\n226:     assert run.call_count == 1\\n227: \\n228: \\n229: @pytest.mark.parametrize(\\\"state\\\", [{\\\"status\\\": \\\"running\\\"}, {\\\"cli_pid\\\": 1}])\\n230: def test_worker_refuses_reentry(tmp_path, state):\\n231:     job = worker_job(tmp_path, **state)\\n232:     with patch.object(c, \\\"monitor\\\") as run, patch.object(c, \\\"alive\\\", return_value=True):\\n233:         assert c.worker(job) == 1\\n234:     run.assert_not_called()\\n235:     assert c.read_json(job / \\\"state.json\\\").get(\\\"monitor_pid\\\") is None\\n236: \\n237: \\n238: def test_status_persists_failure_when_monitor_gone(tmp_path):\\n239:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"running\\\", \\\"monitor_pid\\\": 99})\\n240:     with patch.object(c, \\\"alive\\\", return_value=False):\\n241:         assert c.status(tmp_path)[\\\"status\\\"] == \\\"failed\\\"\\n242:     assert c.read_json(tmp_path / \\\"state.json\\\")[\\\"status\\\"] == \\\"failed\\\"\\n243: \\n244: \\n245: def test_status_detects_dead_worker_before_publish(tmp_path):\\n246:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\"})\\n247:     (tmp_path / \\\"worker.pid\\\").write_text(\\\"99\\\", encoding=\\\"utf-8\\\")\\n248:     with patch.object(c, \\\"alive\\\", return_value=False):\\n249:         assert c.status(tmp_path)[\\\"status\\\"] == \\\"failed\\\"\\n250: \\n251: \\n252: # ---- \\u8bbe\\u5907\\u9501 ----\\n253: \\n254: def publish_worker(argv, **kwargs):\\n255:     \\\"\\\"\\\"\\u6a21\\u62df worker \\u542f\\u52a8\\u540e\\u53d1\\u5e03\\u81ea\\u5df1\\u7684 PID\\u3002\\\"\\\"\\\"\\n256:     job = Path(argv[argv.index(\\\"--job\\\") + 1])\\n257:     state = c.read_json(job / \\\"state.json\\\")\\n258:     state[\\\"monitor_pid\\\"] = 4242\\n259:     c.write_json(job / \\\"state.json\\\", state)\\n260:     process = MagicMock(pid=4242)\\n261:     process.poll.return_value = None\\n262:     return process\\n263: \\n264: \\n265: def silent_worker(exited):\\n266:     def launch(argv, **kwargs):\\n267:         process = MagicMock(pid=4343)\\n268:         process.poll.return_value = 1 if exited else None\\n269:         return process\\n270:     return launch\\n271: \\n272: \\n273: def device_task(tmp_path):\\n274:     task = tmp_path / \\\"task.json\\\"\\n275:     c.write_json(task, {\\\"devid\\\": \\\"dev\\\", \\\"instructions\\\": \\\"t\\\", \\\"write_dirs\\\": []})\\n276:     return task\\n277: \\n278: \\n279: def test_device_locked_across_workspaces(tmp_path):\\n280:     task = device_task(tmp_path)\\n281:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=publish_worker):\\n282:         first = c.start(make_root(tmp_path, \\\"one\\\"), \\\"test\\\", task)\\n283:         with pytest.raises(ValueError, match=\\\"\\u8bbe\\u5907\\u5df2\\u6709\\u4efb\\u52a1\\\"):\\n284:             c.start(make_root(tmp_path, \\\"two\\\"), \\\"test\\\", task)\\n285:     state = c.read_json(Path(first[\\\"job\\\"]) / \\\"state.json\\\")\\n286:     assert Path(state[\\\"lock\\\"]).exists() and state[\\\"released\\\"] is False\\n287: \\n288: \\n289: def test_start_timeout_keeps_starting_and_lock(tmp_path, monkeypatch):\\n290:     monkeypatch.setattr(c, \\\"START_SECONDS\\\", 0.2)\\n291:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=silent_worker(exited=False)):\\n292:         result = c.start(make_root(tmp_path), \\\"test\\\", device_task(tmp_path))\\n293:     state = c.read_json(Path(result[\\\"job\\\"]) / \\\"state.json\\\")\\n294:     assert result[\\\"status\\\"] == \\\"starting\\\" and \\\"note\\\" in result\\n295:     assert state[\\\"status\\\"] == \\\"starting\\\" and Path(state[\\\"lock\\\"]).exists()\\n296: \\n297: \\n298: def test_dead_worker_releases_lock(tmp_path):\\n299:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=silent_worker(exited=True)):\\n300:         result = c.start(make_root(tmp_path), \\\"test\\\", device_task(tmp_path))\\n301:     state = c.read_json(Path(result[\\\"job\\\"]) / \\\"state.json\\\")\\n302:     assert state[\\\"status\\\"] == \\\"failed\\\" and not Path(state[\\\"lock\\\"]).exists()\\n303: \\n304: \\n305: def test_setup_failure_removes_job_and_lock(tmp_path):\\n306:     root = make_root(tmp_path)\\n307:     with patch.object(c, \\\"cli_prefix\\\", side_effect=RuntimeError(\\\"\\u672a\\u5b89\\u88c5 Codex CLI\\\")):\\n308:         with pytest.raises(RuntimeError):\\n309:             c.start(root, \\\"test\\\", device_task(tmp_path))\\n310:     assert list((root / \\\".mhxy-workspace/codex-cli\\\").iterdir()) == []\\n311:     assert not list((tmp_path / \\\"local/mhxy-cli-testing/locks\\\").iterdir())\\n312: \\n313: \\n314: def test_release_rules(tmp_path, capsys):\\n315:     lock = tmp_path / \\\"lock.json\\\"\\n316:     c.write_json(lock, {\\\"job\\\": str(tmp_path)})\\n317:     base = {\\\"kind\\\": \\\"test\\\", \\\"lock\\\": str(lock), \\\"released\\\": False}\\n318:     c.write_json(tmp_path / \\\"state.json\\\", {**base, \\\"status\\\": \\\"running\\\", \\\"monitor_pid\\\": 1})\\n319:     argv = [\\\"codex_cli\\\", \\\"release\\\", \\\"--job\\\", str(tmp_path), \\\"--restored\\\"]\\n320:     with patch.object(sys, \\\"argv\\\", argv), patch.object(c, \\\"alive\\\", return_value=True):\\n321:         assert c.main() == 2\\n322:     c.write_json(tmp_path / \\\"state.json\\\", {**base, \\\"status\\\": \\\"timed_out\\\"})\\n323:     with patch.object(sys, \\\"argv\\\", argv[:-1]):\\n324:         assert c.main() == 2\\n325:     assert lock.exists()\\n326:     with patch.object(sys, \\\"argv\\\", argv):\\n327:         assert c.main() == 0\\n328:     assert not lock.exists()\\n329:     assert c.read_json(tmp_path / \\\"state.json\\\")[\\\"released\\\"] is True\\n330:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"kind\\\": \\\"review\\\", \\\"status\\\": \\\"completed\\\"})\\n331:     with patch.object(sys, \\\"argv\\\", argv):\\n332:         assert c.main() == 2\\n333: \\n334: \\n335: # ---- \\u76d1\\u63a7\\u771f\\u5b9e\\u672c\\u5730\\u5b50\\u8fdb\\u7a0b ----\\n336: \\n337: def run_probe(tmp_path, code, kind=\\\"test\\\", idle=0.4, cancel=False):\\n338:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\", \\\"kind\\\": kind, \\\"restoration\\\": \\\"unknown\\\"})\\n339:     (tmp_path / \\\"prompt.txt\\\").write_text(\\\"probe\\\", encoding=\\\"utf-8\\\")\\n340:     timer = threading.Timer(0.15, lambda: (tmp_path / \\\"cancel\\\").touch()) if cancel else None\\n341:     if timer:\\n342:         timer.start()\\n343:     c.monitor(tmp_path, [sys.executable, \\\"-u\\\", \\\"-c\\\", code], idle_seconds=idle)\\n344:     if timer:\\n345:         timer.join()\\n346:     return c.read_json(tmp_path / \\\"state.json\\\")\\n347: \\n348: \\n349: def result_code(result):\\n350:     return \\\"from pathlib import Path; Path('result.json').write_text(\\\" + repr(json.dumps(result, ensure_ascii=False)) + \\\", encoding='utf-8')\\\"\\n351: \\n352: \\n353: def test_silent_process_is_stopped(tmp_path):\\n354:     state = run_probe(tmp_path, \\\"import time; time.sleep(10)\\\")\\n355:     assert state[\\\"status\\\"] == \\\"timed_out\\\" and state[\\\"exit_code\\\"] is not None\\n356: \\n357: \\n358: def test_output_refreshes_idle_and_records_session(tmp_path):\\n359:     code = (\\\"import time,sys\\\\nprint('{\\\\\\\"type\\\\\\\":\\\\\\\"thread.started\\\\\\\",\\\\\\\"thread_id\\\\\\\":\\\\\\\"T1\\\\\\\"}', flush=True)\\\\n\\\"\\n360:             \\\"for i in range(8):\\\\n sys.stderr.write('x'); sys.stderr.flush(); time.sleep(.1)\\\\n\\\" + result_code(TEST_RESULT))\\n361:     state = run_probe(tmp_path, code)\\n362:     assert state[\\\"status\\\"] == \\\"completed\\\" and state[\\\"result\\\"] == TEST_RESULT\\n363:     assert state[\\\"restoration\\\"] == \\\"not_needed\\\" and state[\\\"session_id\\\"] == \\\"T1\\\"\\n364: \\n365: \\n366: def test_review_result_is_formatted(tmp_path):\\n367:     result = {\\\"summary\\\": \\\"s\\\", \\\"items\\\": [{\\\"level\\\": \\\"\\u5fc5\\u987b\\u4fee\\u6539\\\", \\\"location\\\": \\\"a.py:3\\\", \\\"problem\\\": \\\"p\\\",\\n368:                                          \\\"basis\\\": \\\"b\\\", \\\"suggestion\\\": \\\"fix\\\"}]}\\n369:     state = run_probe(tmp_path, result_code(result), kind=\\\"review\\\")\\n370:     assert state[\\\"status\\\"] == \\\"completed\\\" and state[\\\"must_fix\\\"] == 1\\n371:     assert state[\\\"formatted\\\"] == [\\\"[\\u5fc5\\u987b\\u4fee\\u6539] a.py:3 \\u2014\\u2014 p\\uff1bb\\uff1bfix\\\"]\\n372: \\n373: \\n374: def test_zero_exit_without_valid_result_is_failed(tmp_path):\\n375:     state = run_probe(tmp_path, result_code({\\\"conclusion\\\": \\\"x\\\"}), kind=\\\"investigate\\\")\\n376:     assert state[\\\"status\\\"] == \\\"failed\\\" and state[\\\"exit_code\\\"] == 0\\n377: \\n378: \\n379: def test_nonzero_exit_cannot_pass(tmp_path):\\n380:     state = run_probe(tmp_path, result_code(TEST_RESULT) + \\\"; raise SystemExit(3)\\\")\\n381:     assert state[\\\"status\\\"] == \\\"failed\\\"\\n382: \\n383: \\n384: def test_cancel_stops_process(tmp_path):\\n385:     state = run_probe(tmp_path, \\\"import time; time.sleep(10)\\\", cancel=True)\\n386:     assert state[\\\"status\\\"] == \\\"cancelled\\\" and state[\\\"restoration\\\"] == \\\"unknown\\\"\\n387: \\n388: \\n389: def test_monitor_failure_never_records_command(tmp_path):\\n390:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\", \\\"kind\\\": \\\"test\\\"})\\n391:     (tmp_path / \\\"prompt.txt\\\").write_text(\\\"probe\\\", encoding=\\\"utf-8\\\")\\n392:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=OSError(\\\"secret-auth-value\\\")):\\n393:         c.monitor(tmp_path, [\\\"secret-auth-value\\\"], idle_seconds=.1)\\n394:     state = c.read_json(tmp_path / \\\"state.json\\\")\\n395:     assert state[\\\"status\\\"] == \\\"failed\\\" and \\\"secret-auth-value\\\" not in json.dumps(state)\\n396: \\n397: \\n398: def test_outside_and_linked_write_directory_rejected(tmp_path):\\n399:     base = tmp_path / \\\".mhxy-workspace\\\"\\n400:     base.mkdir()\\n401:     with pytest.raises(ValueError):\\n402:         c.checked_directory(tmp_path / \\\"business\\\", base)\\n403:     with pytest.raises(ValueError):\\n404:         c.checked_directory(base, base)\\n405:     assert c.checked_directory(base / \\\"tests\\\", base) == base / \\\"tests\\\"\", \"tests/test_precommit.py\": \"1: \\\"\\\"\\\"\\u63d0\\u4ea4\\u524d\\u81ea\\u68c0\\u7684\\u9694\\u79bb\\u6d4b\\u8bd5\\uff1bsvn \\u8c03\\u7528\\u5168\\u90e8\\u66ff\\u6362\\u4e3a\\u5047\\u6570\\u636e\\u3002\\\"\\\"\\\"\\n2: import contextlib\\n3: import io\\n4: import json\\n5: from pathlib import Path\\n6: import subprocess\\n7: import sys\\n8: import tempfile\\n9: import unittest\\n10: from unittest.mock import patch\\n11: \\n12: sys.dont_write_bytecode = True\\n13: sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \\\"scripts\\\"))\\n14: import precommit as p  # noqa: E402\\n15: \\n16: STATUS_XML = \\\"\\\"\\\"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\\n17: <status>\\n18: <target path=\\\".\\\">\\n19: <entry path=\\\".mhxy-workspace\\\"><wc-status item=\\\"unversioned\\\" props=\\\"none\\\"/></entry>\\n20: <entry path=\\\"prot\\\"><wc-status item=\\\"external\\\" props=\\\"none\\\"/></entry>\\n21: <entry path=\\\"gameplay\\\\\\\\chat\\\\\\\\a.py\\\"><wc-status item=\\\"modified\\\" props=\\\"none\\\"/></entry>\\n22: <entry path=\\\"gameplay\\\\\\\\new.py\\\"><wc-status item=\\\"unversioned\\\" props=\\\"none\\\"/></entry>\\n23: <entry path=\\\"gameplay\\\\\\\\gone.py\\\"><wc-status item=\\\"missing\\\" props=\\\"none\\\"/></entry>\\n24: <entry path=\\\"gameplay\\\\\\\\c.py\\\"><wc-status item=\\\"conflicted\\\" props=\\\"none\\\"/></entry>\\n25: <entry path=\\\"data\\\\\\\\table.py\\\"><wc-status item=\\\"modified\\\" props=\\\"none\\\"/></entry>\\n26: <entry path=\\\"lib\\\"><wc-status item=\\\"normal\\\" props=\\\"modified\\\"/></entry>\\n27: <entry path=\\\"old.py\\\"><wc-status item=\\\"deleted\\\" props=\\\"none\\\"/></entry>\\n28: </target>\\n29: <changelist name=\\\"ignore-on-commit\\\">\\n30: <entry path=\\\"AGENTS.md\\\"><wc-status item=\\\"modified\\\" props=\\\"none\\\"/></entry>\\n31: </changelist>\\n32: </status>\\\"\\\"\\\".encode(\\\"utf-8\\\")\\n33: \\n34: \\n35: class PrecommitTests(unittest.TestCase):\\n36:     def setUp(self):\\n37:         self.temp = tempfile.TemporaryDirectory()\\n38:         self.root = Path(self.temp.name).resolve()\\n39: \\n40:     def tearDown(self):\\n41:         self.temp.cleanup()\\n42: \\n43:     def write(self, relative, data):\\n44:         path = self.root / relative\\n45:         path.parent.mkdir(parents=True, exist_ok=True)\\n46:         path.write_bytes(data if isinstance(data, bytes) else data.encode(\\\"utf-8\\\"))\\n47:         return path\\n48: \\n49:     def test_status_parsing_and_classification(self):\\n50:         with patch.object(p, \\\"run_svn\\\", return_value=STATUS_XML):\\n51:             entries = p.svn_status(self.root)\\n52:         self.assertIn({\\\"path\\\": \\\"AGENTS.md\\\", \\\"item\\\": \\\"modified\\\", \\\"props\\\": \\\"none\\\", \\\"tree_conflict\\\": False,\\n53:                        \\\"changelist\\\": \\\"ignore-on-commit\\\"}, entries)\\n54:         result = p.classify(entries)\\n55:         self.assertEqual(result[\\\"commit\\\"], [\\\"gameplay/chat/a.py\\uff08modified\\uff09\\\", \\\"lib\\uff08\\u5c5e\\u6027\\u4fee\\u6539\\uff09\\\", \\\"old.py\\uff08deleted\\uff09\\\"])\\n56:         self.assertEqual(sorted(result[\\\"excluded_local_only\\\"]), [\\\".mhxy-workspace\\\", \\\"AGENTS.md\\\"])\\n57:         self.assertEqual(result[\\\"excluded_data\\\"], [\\\"data/table.py\\\"])\\n58:         self.assertEqual(result[\\\"unversioned\\\"], [\\\"gameplay/new.py\\\"])\\n59:         self.assertEqual(result[\\\"property_changes\\\"], [\\\"lib\\\"])\\n60:         self.assertEqual(len(result[\\\"blocking\\\"]), 2)\\n61:         self.assertTrue(any(\\\"gone.py\\\" in item and \\\"missing\\\" in item for item in result[\\\"blocking\\\"]))\\n62: \\n63:     def test_builtin_source_checks(self):\\n64:         good = self.write(\\\"good.py\\\", \\\"# -*- coding: utf-8 -*-\\\\r\\\\nx = '\\u4e2d\\u6587'\\\\r\\\\n\\\")\\n65:         gbk = self.write(\\\"gbk.py\\\", \\\"# -*- coding: gbk -*-\\\\nx = 1\\\\n\\\")\\n66:         bad_bytes = self.write(\\\"bad.py\\\", \\\"x = '\\u4e2d\\u6587'\\\\n\\\".encode(\\\"gb18030\\\"))\\n67:         syntax = self.write(\\\"syntax.py\\\", \\\"def f(:\\\\n\\\")\\n68:         mixed = self.write(\\\"mixed.py\\\", \\\"a = 1\\\\r\\\\nb = 2\\\\n\\\")\\n69:         blocking, warnings, method = p.check_sources(self.root, [good, gbk, bad_bytes, syntax, mixed])\\n70:         self.assertIn(\\\"\\u5185\\u7f6e\\u68c0\\u67e5\\\", method)\\n71:         self.assertEqual(len(blocking), 3)\\n72:         self.assertTrue(any(\\\"gbk.py\\\" in item and \\\"\\u7f16\\u7801\\u58f0\\u660e\\\" in item for item in blocking))\\n73:         self.assertTrue(any(\\\"bad.py\\\" in item and \\\"UTF-8\\\" in item for item in blocking))\\n74:         self.assertTrue(any(\\\"syntax.py:1\\\" in item for item in blocking))\\n75:         self.assertEqual(warnings, [\\\"mixed.py\\uff1a\\u6df7\\u7528 CRLF \\u548c LF \\u6362\\u884c\\\"])\\n76: \\n77:     def test_project_encoding_tool_is_preferred(self):\\n78:         source = self.write(\\\"a.py\\\", \\\"x = 1\\\\n\\\")\\n79:         self.write(p.ENCODING_TOOL, \\\"import sys\\\\nprint('ERROR\\\\\\\\ta.py\\\\\\\\tbad header')\\\\nprint('OK\\\\\\\\tdone')\\\\nsys.exit(1)\\\\n\\\")\\n80:         blocking, warnings, method = p.check_sources(self.root, [source])\\n81:         self.assertEqual(method, p.ENCODING_TOOL)\\n82:         self.assertEqual(blocking, [\\\"ERROR\\\\ta.py\\\\tbad header\\\"])\\n83:         self.write(p.ENCODING_TOOL, \\\"print('WARN\\\\\\\\ta.py\\\\\\\\tmojibake?')\\\\n\\\")\\n84:         blocking, warnings, _ = p.check_sources(self.root, [source])\\n85:         self.assertEqual((blocking, warnings), ([], [\\\"WARN\\\\ta.py\\\\tmojibake?\\\"]))\\n86: \\n87:     def test_leftovers_from_new_and_modified_files(self):\\n88:         self.write(\\\"gameplay/new.py\\\", \\\"import pdb\\\\nprint('x')\\\\nDEV = 'mh_at_\\\" + \\\"a\\\" * 32 + \\\"'\\\\n\\\")\\n89:         self.write(\\\"gameplay/a.py\\\", \\\"value = 1\\\\n\\\")\\n90:         diff = \\\"--- a.py\\\\n+++ a.py\\\\n@@\\\\n-old\\\\n+    print('debug')\\\\n+value = 1\\\\n\\\".encode(\\\"utf-8\\\")\\n91:         entries = [{\\\"path\\\": \\\"gameplay/new.py\\\", \\\"item\\\": \\\"unversioned\\\"}, {\\\"path\\\": \\\"gameplay/a.py\\\", \\\"item\\\": \\\"modified\\\"},\\n92:                    {\\\"path\\\": \\\"data/t.py\\\", \\\"item\\\": \\\"modified\\\"}, {\\\"path\\\": \\\"readme.md\\\", \\\"item\\\": \\\"modified\\\"}]\\n93:         with patch.object(p, \\\"run_svn\\\", return_value=diff) as run:\\n94:             warnings = p.check_leftovers(self.root, entries)\\n95:         run.assert_called_once()\\n96:         self.assertEqual(len(warnings), 4)\\n97:         self.assertTrue(any(\\\"\\u8c03\\u8bd5\\u65ad\\u70b9\\\" in w for w in warnings))\\n98:         self.assertTrue(any(\\\"\\u5199\\u6b7b\\u7684\\u8bbe\\u5907 ID\\\" in w for w in warnings))\\n99:         self.assertTrue(any(w.startswith(\\\"gameplay/a.py\\uff1a\\u65b0\\u589e print\\\") for w in warnings))\\n100: \\n101:     def test_ignore_on_commit_files_are_not_commit_candidates(self):\\n102:         entries = [{\\\"path\\\": \\\"gameplay/local.py\\\", \\\"item\\\": \\\"modified\\\", \\\"props\\\": \\\"none\\\", \\\"tree_conflict\\\": False,\\n103:                     \\\"changelist\\\": \\\"ignore-on-commit\\\"},\\n104:                    {\\\"path\\\": \\\"lib\\\", \\\"item\\\": \\\"normal\\\", \\\"props\\\": \\\"modified\\\", \\\"tree_conflict\\\": False,\\n105:                     \\\"changelist\\\": \\\"ignore-on-commit\\\"},\\n106:                    {\\\"path\\\": \\\"CLAUDE.md\\\", \\\"item\\\": \\\"modified\\\", \\\"props\\\": \\\"none\\\", \\\"tree_conflict\\\": False,\\n107:                     \\\"changelist\\\": \\\"ignore-on-commit\\\"},\\n108:                    {\\\"path\\\": \\\"gameplay/b.py\\\", \\\"item\\\": \\\"modified\\\", \\\"props\\\": \\\"none\\\", \\\"tree_conflict\\\": False,\\n109:                     \\\"changelist\\\": \\\"feature\\\"}]\\n110:         self.write(\\\"gameplay/local.py\\\", \\\"print('local')\\\\n\\\")\\n111:         result = p.classify(entries)\\n112:         self.assertEqual(result[\\\"commit\\\"], [\\\"gameplay/b.py\\uff08modified\\uff09\\\"])\\n113:         self.assertEqual(result[\\\"ignore_on_commit\\\"], [\\\"gameplay/local.py\\uff08modified\\uff09\\\", \\\"lib\\uff08\\u5c5e\\u6027\\u4fee\\u6539\\uff09\\\"])\\n114:         self.assertEqual(result[\\\"excluded_local_only\\\"], [\\\"CLAUDE.md\\\"])\\n115:         self.assertEqual(result[\\\"property_changes\\\"], [])\\n116:         # \\u4e0d\\u63d0\\u4ea4\\u7684\\u6587\\u4ef6\\u4e5f