\u7ad9\\u4efb\\u52a1\\u7684 `cur_ver` \\u67e5\\u8be2\\uff1b\\u65e7\\u7684 `--revision` \\u53c2\\u6570\\u4ec5\\u4e3a\\u517c\\u5bb9\\u4fdd\\u7559\\uff0c\\u5df2\\u5ffd\\u7565\\u3002\\u4e0d\\u4e0e\\u672c\\u5730 SVN \\u6216\\u5ba2\\u6237\\u7aef\\u7248\\u672c\\u6bd4\\u8f83\\uff0c\\u4f46\\u4f1a\\u6838\\u5bf9\\u4efb\\u52a1\\u3001\\u5206\\u652f\\u548c\\u63d0\\u4ea4\\u8bb0\\u5f55\\u7684\\u8eab\\u4efd\\u3002\\n72: - \\u811a\\u672c\\u53ea\\u8c03\\u7528\\u7f51\\u7ad9\\u7684 GET \\u67e5\\u8be2\\u63a5\\u53e3\\uff0c\\u4e0d\\u6267\\u884c reset\\u3001ignore\\u3001confirm \\u7b49\\u5199\\u64cd\\u4f5c\\u3002\\n73: \\n74: **\\u8ba4\\u8bc1**\\n75: - \\u9ed8\\u8ba4\\u7528\\u7528\\u6237\\u7ea7\\u914d\\u7f6e\\u4e2d\\u7684 OpenID \\u8d26\\u5bc6\\u767b\\u5f55\\u3002\\u914d\\u7f6e\\u65b9\\u6cd5\\u548c\\u65e0\\u4ea4\\u4e92\\u7ec8\\u7aef\\u65f6\\u7684\\u5904\\u7406\\u89c1 workspace-management.md\\u300c\\u914d\\u7f6e\\u300d\\u300c\\u5bc6\\u7801\\u300d\\u3002\\u767b\\u5f55\\u9700\\u8981\\u652f\\u6301 SM4 \\u7684 `cryptography`\\uff0c\\u4f1a\\u8bdd\\u53ea\\u4fdd\\u5b58\\u5728\\u8fdb\\u7a0b\\u5185\\u5b58\\u4e2d\\u3002\\n76: - `--auth-file`\\uff08\\u6216\\u73af\\u5883\\u53d8\\u91cf `MHXY_COVERAGE_AUTH_FILE`\\uff09\\u53ef\\u4ee5\\u6539\\u7528\\u5df2\\u6709\\u4f1a\\u8bdd\\u3002\\u8ba4\\u8bc1\\u6587\\u4ef6\\u662f\\u53ea\\u542b `Cookie`\\uff0f`Authorization` \\u8bf7\\u6c42\\u5934\\u7684 JSON \\u5bf9\\u8c61\\uff0c\\u7531\\u7528\\u6237\\u5728\\u672c\\u673a\\u81ea\\u884c\\u914d\\u7f6e\\uff1b\\u4e0d\\u8981\\u5199\\u5165\\u914d\\u7f6e\\u3001\\u5de5\\u4f5c\\u533a\\u3001Mock\\u3001\\u5165\\u53e3\\u6587\\u4ef6\\u6216\\u804a\\u5929\\u5185\\u5bb9\\uff0c\\u4e5f\\u4e0d\\u8981\\u81ea\\u52a8\\u63d0\\u53d6\\u6d4f\\u89c8\\u5668\\u767b\\u5f55\\u6001\\u3002\\u6ca1\\u6709\\u8ba4\\u8bc1\\u6216\\u8ba4\\u8bc1\\u8fc7\\u671f\\u65f6\\u8fd4\\u56de `auth_required`\\u3002\\n77: - `--openid-user` \\u53ef\\u4ee5\\u6307\\u5b9a\\u4ea4\\u4e92\\u767b\\u5f55\\u7684\\u8d26\\u53f7\\uff1b\\u4e0e\\u914d\\u7f6e\\u4e2d\\u7684\\u8d26\\u53f7\\u4e