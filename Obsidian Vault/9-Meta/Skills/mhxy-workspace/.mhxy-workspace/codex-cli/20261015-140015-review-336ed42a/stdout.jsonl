   # svn info \\u8fd4\\u56de\\u7684 URL \\u662f URI \\u7f16\\u7801\\u7684\\uff0c\\u7f51\\u7ad9\\u548c\\u65e5\\u5fd7\\u91cc\\u7684\\u8def\\u5f84\\u662f\\u89e3\\u7801\\u540e\\u7684\\n607:     return unquote(match.group(1)) if match else None\\n608: \\n609: \\n610: def svn_branch(root):\\n611:     \\\"\\\"\\\"\\u53ea\\u8bfb\\u8bfb\\u53d6\\u5de5\\u4f5c\\u526f\\u672c\\u7684\\u4ed3\\u5e93 URL \\u5e76\\u5206\\u7c7b\\uff1bsvn \\u4e0d\\u53ef\\u7528\\u6216\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\u65f6\\u8fd4\\u56de None\\u3002\\n612: \\n613:     \\u6bcf\\u6b21\\u73b0\\u573a\\u8bfb\\u53d6\\u3001\\u4e0d\\u843d\\u76d8\\uff0c\\u56e0\\u6b64\\u4e0d\\u53d7\\u4e2a\\u4eba\\u76ee\\u5f55\\u6e05\\u7406\\u5f71\\u54cd\\u3002`path` \\u89c1 branch_path\\u3002\\n614:     \\\"\\\"\\\"\\n615:     try:\\n616:         completed = subprocess.run([\\\"svn\\\", \\\"info\\\", \\\"--show-item\\\", \\\"url\\\", \\\"--non-interactive\\\", \\\".\\\"],\\n617:                                    cwd=root, capture_output=True, timeout=20)\\n618:     except (OSError, subprocess.SubprocessError):\\n619:         return None\\n620:     url = decode_output(completed.stdout).strip()\\n621:     if completed.returncode or not url:\\n622:         return None\\n623:     return {\\\"url\\\": url, \\\"name\\\": unquote(url.rstrip(\\\"/\\\").rsplit(\\\"/\\\", 1)[-1]), \\\"path\\\": branch_path(url),\\n624:             \\\"kind\\\": classify_branch(url)}\\n625: \\n626: \\n627: def svn_changelist(root, name):\\n628:     \\\"\\\"\\\"\\u53ea\\u8bfb\\u67e5\\u8be2\\u6587\\u4ef6\\u6240\\u5728\\u7684 SVN \\u53d8\\u66f4\\u5217\\u8868\\u3002\\n629: \\n630:     Returns:\\n631:         \\u53d8\\u66f4\\u5217\\u8868\\u540d\\uff1b\\u4e0d\\u5728\\u4efb\\u4f55\\u5217\\u8868\\u4e2d\\u65f6\\u4e3a\\u7a7a\\u5b57\\u7b26\\u4e32\\uff1b\\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\uff08\\u542b\\u76ee\\u5f55\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\uff09\\u65f6\\u4e3a None\\u3002\\n632: \\n633:     Raises:\\n634:         WorkspaceError: svn \\u4e0d\\u53ef\\u7528\\u6216\\u5176\\u4ed6\\u67e5\\u8be2\\u5931\\u8d25\\u3002\\n635:     \\\"\\\"\\\"\\n636:     try:\\n637:         completed = subprocess.run([\\\"svn\\\", \\\"info\\\", \\\"--show-item\\\", \\\"changelist\\\", \\\"--non-interactive\\\", name],\\n638:                                    cwd=root, capture_output=True, timeout=20)\\n639:     except (OSError, subprocess.SubprocessError) as error:\\n640:         raise WorkspaceError(f\\\"svn \\u4e0d\\u53ef\\u7528\\uff1a{error}\\\") from None\\n641:     if completed.returncode:\\n642:         if b\\\"W155010\\\" in completed.stderr or b\\\"E155007\\\" in completed.stderr:  # \\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\uff0f\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\n643:             return None\\n644:         raise WorkspaceError(decode_output(completed.stderr).strip() or \\\"svn info \\u5931\\u8d25\\\")\\n645:     return decode_output(completed.stdout).strip()\\n646: \\n647: \\n648: def plan_ignore_on_commit(root):\\n649:     \\\"\\\"\\\"\\u627e\\u51fa\\u9700\\u8981\\u653e\\u5165 ignore-on-commit \\u53d8\\u66f4\\u5217\\u8868\\u7684\\u5165\\u53e3\\u6587\\u4ef6\\uff0c\\u5e76\\u7ed9\\u51fa\\u65e0\\u6cd5\\u5904\\u7406\\u7684\\u539f\\u56e0\\u3002\\n650: \\n651:     \\u53ea\\u5904\\u7406\\u53d7\\u7248\\u672c\\u63a7\\u5236\\u7684 ENTRY_FILES\\uff1a\\u5df2\\u5728\\u8be5\\u5217\\u8868\\u4e2d\\u7684\\u8df3\\u8fc7\\uff1b\\u5728\\u7528\\u6237\\u81ea\\u5df1\\u7684\\u5176\\u4ed6\\u53d8\\u66f4\\u5217\\u8868\\u4e2d\\u7684\\n652:     \\u4e0d\\u79fb\\u52a8\\uff0c\\u53ea\\u7ed9\\u51fa\\u8b66\\u544a\\u3002svn \\u4e0d\\u53ef\\u7528\\u65f6\\u6574\\u4f53\\u8df3\\u8fc7\\u5e76\\u7ed9\\u51fa\\u8b66\\u544a\\u3002\\n653: \\n654:     Returns:\\n655:         (\\u5f85\\u52a0\\u5165\\u7684\\u6587\\u4ef6\\u540d\\u5217\\u8868, \\u8b66\\u544a\\u5217\\u8868)\\u3002\\n656:     \\\"\\\"\\\"\\n657:     pending, warnings = [], []\\n658:     for name in ENTRY_FILES:\\n659:         if not exists(root / name):\\n660:             continue\\n661:         try:\\n662:             current = svn_changelist(root, name)\\n663:         except WorkspaceError as error:\\n664:             return [], [f\\\"\\u672a\\u80fd\\u628a\\u5165\\u53e3\\u6587\\u4ef6\\u52a0\\u5165 {IGNORE_ON_COMMIT}\\uff1a{error}\\\"]\\n665:         if current == \\\"\\\":\\n666:             pending.append(name)\\n667:         elif current not in (None, IGNORE_ON_COMMIT):\\n668:             warnings.append(f\\\"{name} \\u5df2\\u5728\\u53d8\\u66f4\\u5217\\u8868 {current} \\u4e2d\\uff0c\\u672a\\u79fb\\u5165 {IGNORE_ON_COMMIT}\\\")\\n669:     return pending, warnings\\n670: \\n671: \\n672: def apply_ignore_on_commit(root, names):\\n673:     \\\"\\\"\\\"\\u628a\\u6587\\u4ef6\\u52a0\\u5165 ignore-on-commit \\u53d8\\u66f4\\u5217\\u8868\\uff08\\u53ea\\u6539\\u672c\\u5730\\u5de5\\u4f5c\\u526f\\u672c\\u5143\\u6570\\u636e\\uff0c\\u4e0d\\u5f71\\u54cd\\u670d\\u52a1\\u5668\\uff09\\u3002\\n674: \\n675:     Returns:\\n676:         \\u8b66\\u544a\\u5217\\u8868\\uff1b\\u5931\\u8d25\\u4e0d\\u629b\\u51fa\\uff0c\\u56e0\\u4e3a\\u914d\\u7f6e\\u6587\\u4ef6\\u6b64\\u65f6\\u5df2\\u7ecf\\u5199\\u5165\\u3002\\n677:     \\\"\\\"\\\"\\n678:     if not names:\\n679:         return []\\n680:     try:\\n681:         completed = subprocess.run([\\\"svn\\\", \\\"changelist\\\", IGNORE_ON_COMMIT, \\\"--non-interactive\\\", *names],\\n682:                                    cwd=root, capture_output=True, timeout=20)\\n683:     except (OSError, subprocess.SubprocessError) as error:\\n684:         return [f\\\"\\u672a\\u80fd\\u628a {', '.join(names)} \\u52a0\\u5165 {IGNORE_ON_COMMIT}\\uff1a{error}\\\"]\\n685:     if completed.returncode:\\n686:         detail = decode_output(completed.stderr).strip()\\n687:         return [f\\\"\\u672a\\u80fd\\u628a {', '.join(names)} \\u52a0\\u5165 {IGNORE_ON_COMMIT}\\uff1a{detail}\\\"]\\n688:     return []\\n689: \\n690: \\n691: def read_index_state(personal):\\n692:     \\\"\\\"\\\"\\u8bfb\\u53d6\\u7d22\\u5f15\\u6536\\u5f55\\u72b6\\u6001\\uff1b\\u7f3a\\u5931\\u65f6\\u4ee5\\u5f53\\u524d\\u65f6\\u95f4\\u4e3a\\u8d77\\u70b9\\u65b0\\u5efa\\uff0c\\u540d\\u5355\\u4e3a\\u7a7a\\u3002\\n693: \\n694:     \\u4ece 0.2.x \\u5347\\u7ea7\\u65f6\\uff0c\\u65e7\\u7248\\u624b\\u5199\\u7d22\\u5f15\\u91cc\\u767b\\u8bb0\\u8fc7\\u7684 spec \\u8def\\u5f84\\u4f1a\\u8fc1\\u5165\\u540d\\u5355\\uff0c\\u907f\\u514d\\u4e22\\u5931\\u3002\\n695: \\n696:     Returns:\\n697:         (\\u72b6\\u6001\\u6587\\u4ef6\\u8def\\u5f84, \\u539f\\u59cb\\u5b57\\u8282\\u6216 None, \\u72b6\\u6001)\\u3002\\u72b6\\u6001\\u542b since\\uff08\\u5e26\\u65f6\\u533a\\u7684 ISO \\u65f6\\u95f4\\uff09\\u3001\\n698:         specs\\uff08\\u6536\\u5f55\\u540d\\u5355\\uff09\\u548c excluded\\uff08\\u7528\\u6237\\u79fb\\u51fa\\u3001\\u4e0d\\u518d\\u81ea\\u52a8\\u6536\\u5f55\\u7684\\u540d\\u5355\\uff09\\uff0c\\u8def\\u5f84\\u90fd\\u76f8\\u5bf9\\u9879\\u76ee\\u6839\\u3002\\n699:         0.3.18 \\u53ca\\u4e4b\\u524d\\u5199\\u5165\\u7684\\u72b6\\u6001\\u6ca1\\u6709 excluded\\uff0c\\u6309\\u7a7a\\u540d\\u5355\\u8bfb\\u53d6\\u3002\\n700: \\n701:     Raises:\\n702:         WorkspaceError: \\u72b6\\u6001\\u6587\\u4ef6\\u635f\\u574f\\u3002\\n703:     \\\"\\\"\\\"\\n704:     path = personal / INDEX_STATE\\n705:     old = read_bytes(path)\\n706:     if old is not None:\\n707:         state = parse_json(old, path)\\n708:         state.setdefault(\\\"excluded\\\", [])\\n709:         if (set(state) != {\\\"since\\\", \\\"specs\\\", \\\"excluded\\\"}\\n710:                 or not all(isinstance(state[key], list) and all(isinstance(item, str) for item in state[key])\\n711:                            for key in (\\\"specs\\\", \\\"excluded\\\"))):\\n712:             raise WorkspaceError(f\\\"\\u7d22\\u5f15\\u72b6\\u6001\\u7ed3\\u6784\\u65e0\\u6548\\uff1a{path}\\\")\\n713:         try:\\n714:             datetime.fromisoformat(state[\\\"since\\\"]).timestamp()\\n715:         except (TypeError, ValueError):\\n716:             raise WorkspaceError(f\\\"\\u7d22\\u5f15\\u72b6\\u6001\\u8d77\\u70b9\\u65f6\\u95f4\\u65e0\\u6548\\uff1a{path}\\\") from None\\n717:         return path, old, state\\n718:     specs = []\\n719:     legacy = read_bytes(personal / INDEX_FILE)\\n720:     if legacy is not None:\\n721:         text = decode_document(legacy)[0]\\n722:         if not text.startswith(INDEX_HEADER):\\n723:             specs = re.findall(r\\\"^\\\\s*-\\\\s*(spec/.+?\\\\.md)\\\\s*[\\uff1a:]\\\", text, re.M)\\n724:     return path, None, {\\\"since\\\": datetime.now().astimezone().isoformat(timespec=\\\"seconds\\\"),\\n725:                         \\\"specs\\\": specs, \\\"excluded\\\": []}\\n726: \\n727: \\n728: def render_index(since, entries):\\n729:     \\\"\\\"\\\"\\u628a\\u6536\\u5f55\\u6761\\u76ee\\u6e32\\u67d3\\u4e3a\\u7d22\\u5f15 Markdown\\uff1b\\u540c\\u6837\\u7684\\u540d\\u5355\\u548c spec \\u5185\\u5bb9\\u603b\\u662f\\u5f97\\u5230\\u76f8\\u540c\\u5b57\\u8282\\u3002\\\"\\\"\\\"\\n730:     lines = [INDEX_HEADER + \\\"\\u6536\\u5f55\\u540d\\u5355\\u89c1 index-state.json\\uff1b\\u624b\\u5de5\\u4fee\\u6539\\u672c\\u6587\\u4ef6\\u4f1a\\u88ab\\u8986\\u76d6\\u3002 -->\\\",\\n731:              f\\\"\\u6536\\u5f55 {since} \\u4e4b\\u540e\\u65b0\\u5efa\\u6216\\u4fee\\u6539\\u7684 spec\\uff0c\\u5171 {len(entries)} \\u7bc7\\u3002\\u6309\\u7ec4\\u540d\\uff08spec/ \\u4e00\\u7ea7\\u5b50\\u76ee\\u5f55\\uff09\\u3001\\u6807\\u9898\\u6216\\u6458\\u8981\\u641c\\u7d22\\u5b9a\\u4f4d\\u3002\\\", \\\"\\\"]\\n732:     for group, items in itertools.groupby(entries, key=lambda entry: entry[0]):\\n733:         items = list(items)\\n734:         lines.append(f\\\"# {group or 'spec \\u6839\\u76ee\\u5f55'}\\uff08{len(items)}\\uff09\\\")\\n735:         lines.extend(f\\\"- {path}\\uff1a{title}\\\" + (f\\\" \\u2014 {summary}\\\" if summary else \\\"\\\") for _, path, title, summary in items)\\n736:         lines.append(\\\"\\\")\\n737:     return \\\"\\\\n\\\".join(lines).encode(\\\"utf-8\\\")\\n738: \\n739: \\n740: def mtime(path):\\n741:     \\\"\\\"\\\"\\u8fd4\\u56de\\u6587\\u4ef6\\u4fee\\u6539\\u65f6\\u95f4\\uff1b\\u6587\\u4ef6\\u5df2\\u4e0d\\u5b58\\u5728\\uff08\\u4f8b\\u5982\\u521a\\u88ab\\u5220\\u9664\\u6216\\u6539\\u540d\\uff09\\u65f6\\u8fd4\\u56de None\\u3002\\\"\\\"\\\"\\n742:     try:\\n743:         return path.stat().st_mtime\\n744:     except FileNotFoundError:\\n745:         return None\\n746: \\n747: \\n748: def plan_index(root, personal, add=(), remove=(), scan=True, written=()):\\n749:     \\\"\\\"\\\"\\u8ba1\\u7b97\\u65b0\\u7684\\u6536\\u5f55\\u540d\\u5355\\u4e0e\\u7d22\\u5f15\\u5185\\u5bb9\\uff0c\\u53ea\\u8fd4\\u56de\\u53d8\\u66f4\\uff0c\\u4e0d\\u5199\\u5165\\u3002\\n750: \\n751:     \\u540d\\u5355\\u53ea\\u589e\\u4e0d\\u51cf\\u3002\\u65b0\\u589e\\u6765\\u6e90\\uff1a\\n752:     - add\\uff1a\\u7528\\u6237\\u624b\\u52a8\\u6536\\u5f55\\uff0c\\u4e0d\\u53d7\\u8d77\\u70b9\\u9650\\u5236\\uff0c\\u540c\\u65f6\\u4ece\\u6392\\u9664\\u540d\\u5355\\u4e2d\\u53bb\\u6389\\uff1b\\n753:     - written\\uff1ahook \\u62a5\\u544a\\u521a\\u5199\\u5165\\u7684 spec\\uff0c\\u4e0d\\u53d7\\u8d77\\u70b9\\u9650\\u5236\\uff1b\\n754:     - scan \\u65f6\\u201c\\u8d77\\u70b9\\u4e4b\\u540e\\u4fee\\u6539\\u3001\\u4e14 svn \\u663e\\u793a\\u672c\\u5730\\u6709\\u6539\\u52a8\\u201d\\u7684 spec\\u3002svn update \\u62c9\\u4e0b\\u7684\\u4ed6\\u4eba spec\\n755:       \\u5728\\u672c\\u5730\\u65e0\\u6539\\u52a8\\uff0c\\u56e0\\u6b64\\u4e0d\\u4f1a\\u88ab\\u6536\\u5f55\\uff1b\\u6709\\u672a\\u63d0\\u4ea4\\u7684\\u5408\\u5e76\\u65f6\\u8df3\\u8fc7\\u8fd9\\u4e00\\u6765\\u6e90\\uff08\\u89c1 svn_local_changes\\uff09\\u3002\\n756:     remove \\u4e2d\\u7684\\u6761\\u76ee\\u79fb\\u51fa\\u540d\\u5355\\u5e76\\u8bb0\\u5165\\u6392\\u9664\\u540d\\u5355\\uff0cwritten \\u548c scan \\u4e0d\\u4f1a\\u518d\\u6536\\u5f55\\u5b83\\u4eec\\u3002\\u6587\\u4ef6\\u5df2\\u4e0d\\u5b58\\u5728\\u7684\\n757:     \\u6761\\u76ee\\u4ece\\u4e24\\u4e2a\\u540d\\u5355\\u4e2d\\u79fb\\u51fa\\u3002\\n758: \\n759:     Returns:\\n760:         (changes, stats, entries)\\u3002changes \\u53ef\\u4ea4\\u7ed9 apply_changes\\uff1bentries \\u4e3a\\u6309\\u7ec4\\u6392\\u5e8f\\u7684\\n761:         [(\\u7ec4\\u540d, \\u8def\\u5f84, \\u6807\\u9898, \\u6458\\u8981)]\\u3002\\n762:     \\\"\\\"\\\"\\n763:     state_path, old_state, state = read_index_state(personal)\\n764:     since = datetime.fromisoformat(state[\\\"since\\\"]).timestamp()\\n765:     excluded = (set(state[\\\"excluded\\\"]) | set(remove)) - set(add)\\n766:     members = set(state[\\\"specs\\\"]) | set(add) | (set(written) - excluded)\\n767:     svn = \\\"skipped\\\"\\n768:     if scan:\\n769:         svn, changed = svn_local_changes(root)\\n770:         members |= {rel for rel in changed - excluded if (mtime(root / rel) or 0) > since}\\n771: \\n772:     def present(rel):\\n773:         return (root / rel).is_file() and not is_link(root / rel)\\n774:     members = sorted(rel for rel in members - excluded if present(rel))\\n775:     excluded = sorted(rel for rel in excluded if present(rel))\\n776:     entries = sorted((Path(rel).parts[1] if len(Path(rel).parts) > 2 else \\\"\\\", rel, *spec_summary(root / rel))\\n777:                      for rel in members)\\n778:     index_path = personal / INDEX_FILE\\n779:     new_state = {\\\"since\\\": state[\\\"since\\\"], \\\"specs\\\": members, \\\"excluded\\\": excluded}\\n780:     candidates = ((state_path, old_state, json_bytes(new_state)),\\n781:                   (index_path, read_bytes(index_path), render_index(state[\\\"since\\\"], entries)))\\n782:     changes = [change for change in candidates if change[1] != change[2]]\\n783:     stats = {\\\"path\\\": f\\\"{DIRECTORY}/{INDEX_FILE}\\\", \\\"specs\\\": len(members), \\\"since\\\": state[\\\"since\\\"], \\\"svn\\\": svn}\\n784:     return changes, stats, entries\\n785: \\n786: \\n787: def refresh_index(root, personal, add=(), remove=(), scan=True, written=()):\\n788:     \\\"\\\"\\\"\\u6309 plan_index \\u66f4\\u65b0\\u6536\\u5f55\\u540d\\u5355\\u548c\\u7d22\\u5f15\\uff0c\\u65e0\\u53d8\\u5316\\u4e0d\\u5199\\u5165\\uff1b\\u8fd4\\u56de (\\u7edf\\u8ba1\\u4fe1\\u606f, entries)\\u3002\\\"\\\"\\\"\\n789:     changes, stats, entries = plan_index(root, personal, add, remove, scan, written)\\n790:     apply_changes(changes)\\n791:     return {**stats, \\\"updated\\\": bool(changes)}, entries\\n792: \\n793: \\n794: def require_initialized(root):\\n795:     \\\"\\\"\\\"\\u53ea\\u6709 sync \\u80fd\\u521d\\u59cb\\u5316\\u5de5\\u4f5c\\u533a\\uff1b\\u5176\\u4ed6\\u4f1a\\u5199\\u4e2a\\u4eba\\u76ee\\u5f55\\u7684\\u547d\\u4ee4\\u8981\\u6c42\\u6839\\u76ee\\u5f55 AGENTS.md \\u5df2\\u6709\\u53d7\\u7ba1\\u533a\\u6bb5\\u3002\\n796: \\n797:     \\u9632\\u6b62\\u4ece\\u5b50\\u76ee\\u5f55\\u4f20 `--root \\\".\\\"` \\u65f6\\u5728\\u9519\\u8bef\\u7684\\u4f4d\\u7f6e\\u65b0\\u5efa `.mhxy-workspace/`\\u3002\\n798: \\n799:     Raises:\\n800:         WorkspaceError: AGENTS.md \\u4e0d\\u5b58\\u5728\\u3001\\u65e0\\u6cd5\\u89e3\\u7801\\u6216\\u6ca1\\u6709\\u53d7\\u7ba1\\u533a\\u6bb5\\u3002\\n801:     \\\"\\\"\\\"\\n802:     if block_info(decode_document(read_bytes(root / ENTRY_FILES[0]))[0]) is None:\\n803:         raise WorkspaceError(f\\\"{root} \\u4e0d\\u662f\\u5df2\\u521d\\u59cb\\u5316\\u7684\\u5de5\\u4f5c\\u533a\\uff08AGENTS.md \\u4e2d\\u6ca1\\u6709 {NAME} \\u53d7\\u7ba1\\u533a\\u6bb5\\uff09\\uff1b\\\"\\n804:                              \\\"\\u8bf7\\u628a --root \\u6307\\u5411\\u9879\\u76ee\\u6839\\u76ee\\u5f55\\uff0c\\u6216\\u5148\\u6309 SKILL.md \\u521d\\u59cb\\u5316\\\")\\n805: \\n806: \\n807: def query_index(root_arg, global_arg, terms=(), add=(), remove=(), limit=50):\\n808:     \\\"\\\"\\\"\\u5237\\u65b0\\u7d22\\u5f15\\uff0c\\u53ef\\u540c\\u65f6\\u624b\\u52a8\\u6536\\u5f55\\u6216\\u79fb\\u51fa spec\\uff0c\\u518d\\u6309\\u5173\\u952e\\u8bcd\\uff08\\u5168\\u90e8\\u547d\\u4e2d\\u3001\\u4e0d\\u533a\\u5206\\u5927\\u5c0f\\u5199\\uff09\\u5339\\u914d\\u3002\\n809: \\n810:     Raises:\\n811:         WorkspaceError: \\u5de5\\u4f5c\\u533a\\u672a\\u521d\\u59cb\\u5316\\uff1badd\\uff0fremove \\u7684\\u8def\\u5f84\\u4e0d\\u662f spec/ \\u4e0b\\u7684 Markdown\\uff0c\\n812:             \\u6216\\u8981\\u6536\\u5f55\\u7684\\u6587\\u4ef6\\u4e0d\\u5b58\\u5728\\u3002\\n813:     \\\"\\\"\\\"\\n814:     root, personal, _ = paths(root_arg, global_arg)\\n815:     require_initialized(root)\\n816:     normalized = {}\\n817:     for label, values in ((\\\"add\\\", add), (\\\"remove\\\", remove)):\\n818:         normalized[label] = []\\n819:         for value in values:\\n820:             rel = spec_relative(root, value)\\n821:             if rel is None or (label == \\\"add\\\" and not (root / rel).is_file()):\\n822:                 raise WorkspaceError(f\\\"\\u4e0d\\u662f\\u5df2\\u5b58\\u5728\\u7684 spec/ \\u4e0b Markdown \\u6587\\u4ef6\\uff1a{value}\\\")\\n823:             normalized[label].append(rel)\\n824:     stats, entries = refresh_index(root, personal, normalized[\\\"add\\\"], normalized[\\\"remove\\\"])\\n825:     needles = [term.lower() for term in terms if term.strip()]\\n826:     matches = [f\\\"{path}\\uff1a{title}\\\" + (f\\\" \\u2014 {summary}\\\" if summary else \\\"\\\")\\n827:                for group, path, title, summary in entries\\n828:                if all(n in f\\\"{group} {path} {title} {summary}\\\".lower() for n in needles)]\\n829:     return {\\\"index\\\": stats, \\\"matches\\\": matches[:limit], \\\"truncated\\\": len(matches) > limit}\\n830: \\n831: \\n832: def record_hook_write(root_arg, global_arg, payload):\\n833:     \\\"\\\"\\\"Claude Code PostToolUse hook\\uff1a\\u5de5\\u5177\\u521a\\u5199\\u5165 spec/ \\u4e0b\\u7684 Markdown \\u65f6\\u6536\\u5f55\\u8be5\\u6587\\u4ef6\\u3002\\n834: \\n835:     \\u5176\\u4ed6\\u6587\\u4ef6\\u76f4\\u63a5\\u5ffd\\u7565\\uff1b\\u7528\\u6237\\u79fb\\u51fa\\u8fc7\\u7684 spec \\u4e0d\\u518d\\u6536\\u5f55\\u3002\\u53ea\\u66f4\\u65b0\\u540d\\u5355\\u548c\\u7d22\\u5f15\\uff0c\\u4e0d\\u8fd0\\u884c svn\\u3002\\n836:     \\\"\\\"\\\"\\n837:     tool_input = payload.get(\\\"tool_input\\\") if isinstance(payload, dict) else None\\n838:     file_path = tool_input.get(\\\"file_path\\\") if isinstance(tool_input, dict) else None\\n839:     if not isinstance(file_path, str):\\n840:         return\\n841:     root, personal, _ = paths(root_arg, global_arg)\\n842:     rel = spec_relative(root, file_path)\\n843:     if rel and (root / rel).is_file():\\n844:         require_initialized(root)\\n845:         refresh_index(root, personal, scan=False, written=[rel])\\n846: \\n847: \\n848: def context(root_arg, global_arg):\\n849:     \\\"\\\"\\\"\\u4f1a\\u8bdd\\u5f00\\u59cb\\u65f6\\u4e00\\u6b21\\u6027\\u52a0\\u8f7d\\uff1a\\u5f53\\u524d\\u5206\\u652f\\u3001\\u8131\\u654f\\u914d\\u7f6e\\u3001\\u8ffd\\u8e2a\\u5de5\\u5355\\u3001\\u8986\\u76d6\\u7387\\u8eab\\u4efd\\u548c\\u6700\\u8fd1\\u7684 spec\\u3002\\n850: \\n851:     \\u5404\\u90e8\\u5206\\u72ec\\u7acb\\u8bfb\\u53d6\\uff0c\\u67d0\\u90e8\\u5206\\u5931\\u8d25\\u53ea\\u8bb0\\u5165 problems\\uff0c\\u4e0d\\u5f71\\u54cd\\u5176\\u4f59\\u90e8\\u5206\\u3002\\u4e0d\\u521b\\u5efa\\u914d\\u7f6e\\u6216\\u8ffd\\u8e2a\\u6587\\u4ef6\\uff1b\\n852:     \\u7d22\\u5f15\\u72b6\\u6001\\u7f3a\\u5931\\uff08\\u9996\\u6b21\\u6216\\u6e05\\u7406\\u540e\\uff09\\u65f6\\u4ee5\\u5f53\\u524d\\u65f6\\u95f4\\u4e3a\\u8d77\\u70b9\\u65b0\\u5efa\\u7a7a\\u540d\\u5355\\u3002branch \\u4e3a None \\u8868\\u793a\\n853:     svn \\u4e0d\\u53ef\\u7528\\u6216\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\u3002\\n854: \\n855:     Raises:\\n856:         WorkspaceError: \\u5de5\\u4f5c\\u533a\\u672a\\u521d\\u59cb\\u5316\\uff08\\u89c1 require_initialized\\uff09\\uff0c\\u6b64\\u65f6\\u4e0d\\u5199\\u5165\\u4efb\\u4f55\\u6587\\u4ef6\\u3002\\n857:     \\\"\\\"\\\"\\n858:     root, personal, _ = paths(root_arg, global_arg)\\n859:     require_initialized(root)\\n860:     result, problems = {\\\"root\\\": str(root), \\\"branch\\\": svn_branch(root)}, []\\n861:     try:\\n862:         result[\\\"effective_config\\\"] = masked_config(load_config(root_arg, global_arg))\\n863:     except (WorkspaceError, OSError) as error:\\n864:         problems.append(f\\\"\\u914d\\u7f6e\\uff1a{error}\\\")\\n865:     try:\\n866:         tracking = read_tracking(personal)[2]\\n867:         result[\\\"tracked_tasks\\\"] = tracking[\\\"tracked_tasks\\\"]\\n868:         result[\\\"coverage_tasks\\\"] = tracking[\\\"coverage_tasks\\\"]\\n869:     except (WorkspaceError, OSError) as error:\\n870:         problems.append(f\\\"\\u8ffd\\u8e2a\\uff1a{error}\\\")\\n871:     try:\\n872:         stats, entries = refresh_index(root, personal)\\n873:         recent = sorted(entries, key=lambda entry: mtime(root / entry[1]) or 0, reverse=True)\\n874:         stats[\\\"recent\\\"] = [f\\\"{path}\\uff1a{title}\\\" for _, path, title, _ in recent[:INDEX_RECENT_LIMIT]]\\n875:         result[\\\"index\\\"] = stats\\n876:     except (WorkspaceError, OSError) as error:\\n877:         problems.append(f\\\"\\u7d22\\u5f15\\uff1a{error}\\\")\\n878:     result[\\\"problems\\\"] = problems\\n879:     return result\\n880: \\n881: \\n882: def claude_hook_change(root, script):\\n883:     \\\"\\\"\\\"\\u751f\\u6210\\u5728\\u5de5\\u4f5c\\u533a .claude/settings.local.json \\u4e2d\\u767b\\u8bb0\\u672c skill hooks \\u7684\\u53d8\\u66f4\\u3002\\n884: \\n885:     - SessionStart\\uff1a\\u4f1a\\u8bdd\\u5f00\\u59cb\\u3001\\u6062\\u590d\\u3001\\u6e05\\u7a7a\\u548c\\u4e0a\\u4e0b\\u6587\\u538b\\u7f29\\u540e\\u8fd0\\u884c `context`\\uff0c\\u628a\\u7ed3\\u679c\\u6ce8\\u5165\\u4e0a\\u4e0b\\u6587\\u3002\\n886:     - PostToolUse\\uff08Write/Edit/MultiEdit\\uff09\\uff1a\\u5199\\u5165 spec/ \\u4e0b\\u7684 Markdown \\u540e\\u7acb\\u5373\\u6536\\u5f55\\u8fdb\\u7d22\\u5f15\\u3002\\n887: \\n888:     \\u53ea\\u589e\\u6539\\u547d\\u4ee4\\u4e2d\\u5e26 HOOK_FLAG \\u7684\\u672c skill \\u6761\\u76ee\\uff0c\\u4fdd\\u7559\\u5176\\u4ed6\\u8bbe\\u7f6e\\uff1b\\u5df2\\u662f\\u6700\\u65b0\\u65f6\\u8fd4\\u56de None\\u3002\\n889:     \\\"\\\"\\\"\\n890:     path = root / \\\".claude\\\" / \\\"settings.local.json\\\"\\n891:     old = read_bytes(path)\\n892:     settings = parse_json(old, path) if old is not None else {}\\n893:     hooks = settings.get(\\\"hooks\\\", {})\\n894:     if not isinstance(hooks, dict):\\n895:         raise WorkspaceError(f\\\"\\u65e0\\u6cd5\\u8bc6\\u522b\\u7684 hooks \\u7ed3\\u6784\\uff1a{path}\\\")\\n896:     prefix = f'python \\\"{script.as_posix()}\\\"'\\n897:     root_arg = f'--root \\\"{root.as_posix()}\\\" {HOOK_FLAG}'\\n898:     desired = {\\n899:         \\\"SessionStart\\\": {\\\"hooks\\\": [{\\\"type\\\": \\\"command\\\", \\\"command\\\": f\\\"{prefix} context {root_arg}\\\", \\\"timeout\\\": 30}]},\\n900:         \\\"PostToolUse\\\": {\\\"matcher\\\": \\\"Write|Edit|MultiEdit\\\",\\n901:                         \\\"hooks\\\": [{\\\"type\\\": \\\"command\\\", \\\"command\\\": f\\\"{prefix} index {root_arg}\\\", \\\"timeout\\\": 30}]},\\n902:     }\\n903: \\n904:     def is_ours(hook):\\n905:         command = str(hook.get(\\\"command\\\", \\\"\\\")) if isinstance(hook, dict) else \\\"\\\"\\n906:         return HOOK_FLAG in command and \\\"workspace.py\\\" in command\\n907: \\n908:     new_hooks = dict(hooks)\\n909:     for event, ours in desired.items():\\n910:         entries = hooks.get(event, [])\\n911:         if not isinstance(entries, list):\\n912:             raise WorkspaceError(f\\\"\\u65e0\\u6cd5\\u8bc6\\u522b\\u7684 hooks \\u7ed3\\u6784\\uff1a{path}\\\")\\n913:         # \\u53ea\\u79fb\\u9664\\u672c skill \\u7684\\u547d\\u4ee4\\u5bf9\\u8c61\\uff1b\\u7528\\u6237\\u7684\\u547d\\u4ee4\\u4e0e\\u4e4b\\u540c\\u5728\\u4e00\\u4e2a\\u6761\\u76ee\\u65f6\\u4fdd\\u7559\\u8be5\\u6761\\u76ee\\u548c\\u7528\\u6237\\u547d\\u4ee4\\u3002\\n914:         # \\u65b0\\u6761\\u76ee\\u653e\\u5728\\u7b2c\\u4e00\\u6b21\\u51fa\\u73b0\\u672c skill \\u547d\\u4ee4\\u7684\\u4f4d\\u7f6e\\uff0c\\u6ca1\\u6709\\u51fa\\u73b0\\u8fc7\\u65f6\\u8ffd\\u52a0\\u5230\\u672b\\u5c3e\\u3002\\n915:         updated, position = [], None\\n916:         for entry in entries:\\n917:             commands = entry.get(\\\"hooks\\\") if isinstance(entry, dict) else None\\n918:             kept = [hook for hook in commands if not is_ours(hook)] if isinstance(commands, list) else None\\n919:             if kept is None or len(kept) == len(commands):\\n920:                 updated.append(entry)\\n921:                 continue\\n922:             if position is None:\\n923:                 position = len(updated)\\n924:             if kept:\\n925:                 updated.append({**entry, \\\"hooks\\\": kept})\\n926:         updated.insert(len(updated) if position is None else position, ours)\\n927:         new_hooks[event] = updated\\n928:     if new_hooks == hooks:\\n929:         return None\\n930:     return path, old, json_bytes({**settings, \\\"hooks\\\": new_hooks})\\n931: \\n932: \\n933: def validate_coverage(task):\\n934:     \\\"\\\"\\\"\\u6821\\u9a8c\\u5df2\\u7ecf\\u6838\\u5b9e\\u5b58\\u5728\\u7684\\u8fdc\\u7aef\\u8986\\u76d6\\u7387\\u8eab\\u4efd\\uff0c\\u4e0d\\u4ee3\\u8868\\u672c\\u8f6e\\u901a\\u8fc7\\u3002\\\"\\\"\\\"\\n935:     if set(task) != {\\\"task_name\\\", \\\"branch\\\", \\\"redmine_id\\\", \\\"coder_name\\\", \\\"created\\\"} or task[\\\"created\\\"] is not True:\\n936:         raise WorkspaceError(\\\"\\u8986\\u76d6\\u7387\\u4efb\\u52a1\\u5b57\\u6bb5\\u65e0\\u6548\\\")\\n937:     for key in (\\\"task_name\\\", \\\"branch\\\", \\\"redmine_id\\\", \\\"coder_name\\\"):\\n938:         if not isinstance(task[key], str) or not task[key] or any(c in task[key] for c in \\\"\\\\r\\\\n\\\\x00`\\\"):\\n939:             raise WorkspaceError(f\\\"\\u8986\\u76d6\\u7387\\u4efb\\u52a1\\u5b57\\u6bb5\\u65e0\\u6548\\uff1a{key}\\\")\\n940:     validate_issue_id(task[\\\"redmine_id\\\"])\\n941: \\n942: \\n943: def validate_issue_id(issue_id):\\n944:     \\\"\\\"\\\"\\u5de5\\u5355\\u53f7\\u540c\\u65f6\\u7528\\u4f5c\\u76ee\\u5f55\\u540d\\uff0c\\u53ea\\u63a5\\u53d7\\u6b63\\u6574\\u6570\\u5b57\\u7b26\\u4e32\\u3002\\\"\\\"\\\"\\n945:     if not isinstance(issue_id, str) or not re.fullmatch(r\\\"[1-9][0-9]*\\\", issue_id):\\n946:         raise WorkspaceError(\\\"\\u5de5\\u5355\\u53f7\\u5fc5\\u987b\\u4e3a\\u6b63\\u6574\\u6570\\\")\\n947: \\n948: \\n949: def issue_entry(issue_id, title):\\n950:     \\\"\\\"\\\"\\u751f\\u6210\\u4e0d\\u542b\\u6b63\\u6587\\u7684\\u5de5\\u5355\\u5b9a\\u4f4d\\u4fe1\\u606f\\uff0c\\u8def\\u5f84\\u59cb\\u7ec8\\u76f8\\u5bf9\\u4e8e\\u9879\\u76ee\\u6839\\u76ee\\u5f55\\u3002\\\"\\\"\\\"\\n951:     validate_issue_id(issue_id)\\n952:     if not isinstance(title, str) or not title.strip() or any(c in title for c in \\\"\\\\r\\\\n\\\\x00\\\"):\\n953:         raise WorkspaceError(\\\"\\u5de5\\u5355\\u6807\\u9898\\u5fc5\\u987b\\u4e3a\\u975e\\u7a7a\\u5355\\u884c\\u6587\\u672c\\\")\\n954:     return {\\\"issue_id\\\": issue_id, \\\"title\\\": title,\\n955:             \\\"description_path\\\": f\\\"{DIRECTORY}/tasks/{issue_id}/issue.md\\\"}\\n956: \\n957: \\n958: def read_tracking(personal):\\n959:     \\\"\\\"\\\"\\u8bfb\\u53d6\\u672c\\u5730\\u8ffd\\u8e2a\\u72b6\\u6001\\uff1b\\u7f3a\\u5931\\u8868\\u793a\\u7a7a\\u72b6\\u6001\\uff0c\\u4e0d\\u9690\\u5f0f\\u521b\\u5efa\\u6587\\u4ef6\\u3002\\\"\\\"\\\"\\n960:     path = personal / \\\"tracking.json\\\"\\n961:     old = read_bytes(path)\\n962:     value = parse_json(old, path) if old is not None else {\\\"tracked_tasks\\\": [], \\\"coverage_tasks\\\": []}\\n963:     if set(value) != {\\\"tracked_tasks\\\", \\\"coverage_tasks\\\"} or any(\\n964:             not isinstance(value[key], list) for key in value):\\n965:         raise WorkspaceError(\\\"tracking.json \\u7ed3\\u6784\\u65e0\\u6548\\\")\\n966:     seen = set()\\n967:     for task in value[\\\"tracked_tasks\\\"]:\\n968:         if not isinstance(task, dict) or task != issue_entry(task.get(\\\"issue_id\\\"), task.get(\\\"title\\\")):\\n969:             raise WorkspaceError(\\\"\\u8ffd\\u8e2a\\u5de5\\u5355\\u5b57\\u6bb5\\u65e0\\u6548\\\")\\n970:         if task[\\\"issue_id\\\"] in seen:\\n971:             raise WorkspaceError(\\\"\\u8ffd\\u8e2a\\u5de5\\u5355\\u91cd\\u590d\\\")\\n972:         seen.add(task[\\\"issue_id\\\"])\\n973:     identities = set()\\n974:     for task in value[\\\"coverage_tasks\\\"]:\\n975:         if not isinstance(task, dict):\\n976:             raise WorkspaceError(\\\"\\u8986\\u76d6\\u7387\\u4efb\\u52a1\\u5b57\\u6bb5\\u65e0\\u6548\\\")\\n977:         validate_coverage(task)\\n978:         identity = (task[\\\"redmine_id\\\"], task[\\\"branch\\\"])\\n979:         if identity in identities:\\n980:             raise WorkspaceError(\\\"\\u540c\\u5de5\\u5355\\u540c\\u5206\\u652f\\u7684\\u8986\\u76d6\\u7387\\u8eab\\u4efd\\u91cd\\u590d\\\")\\n981:         identities.add(identity)\\n982:     return path, old, value\\n983: \\n984: \\n985: def save_tracking(path, old, value, action, apply):\\n986:     \\\"\\\"\\\"\\u65e0\\u5dee\\u5f02\\u4e0d\\u5199\\u5165\\uff1b\\u6cbf\\u7528\\u6587\\u4ef6\\u5e76\\u53d1\\u68c0\\u67e5\\u548c\\u5931\\u8d25\\u6062\\u590d\\u3002\\\"\\\"\\\"\\n987:     new = json_bytes(value)\\n988:     changes = [(path, old, new)] if old != new else []\\n989:     if apply:\\n990:         apply_changes(changes)\\n991:     return {\\\"action\\\": action, \\\"applied\\\": apply, \\\"tracking\\\": value,\\n992:             \\\"changes\\\": [str(item[0]) for item in changes]}\\n993: \\n994: \\n995: def track_tasks(root_arg, global_arg, issue_ids, replace=False, remove=False, apply=False):\\n996:     \\\"\\\"\\\"\\u4ece\\u811a\\u672c\\u67e5\\u8be2\\u6e05\\u5355\\u8ffd\\u52a0\\u6216\\u66ff\\u6362\\u7528\\u6237\\u9009\\u4e2d\\u7684\\u5de5\\u5355\\uff1b\\u53d6\\u6d88\\u8ffd\\u8e2a\\u4e0d\\u5220\\u9664\\u6b63\\u6587\\u3002\\\"\\\"\\\"\\n997:     root, personal, _ = paths(root_arg, global_arg)\\n998:     if not issue_ids:\\n999:         raise WorkspaceError(\\\"\\u8bf7\\u6307\\u5b9a\\u81f3\\u5c11\\u4e00\\u4e2a --issue-id\\\")\\n1000:     for issue_id in issue_ids:\\n1001:         validate_issue_id(issue_id)\\n1002:     path, old, value = read_tracking(personal)\\n1003:     if remove:\\n1004:         value[\\\"tracked_tasks\\\"] = [t for t in value[\\\"tracked_tasks\\\"] if t[\\\"issue_id\\\"] not in issue_ids]\\n1005:     else:\\n1006:         index_path = personal / \\\"tasks/index.json\\\"\\n1007:         raw = read_bytes(index_path)\\n1008:         if raw is None:\\n1009:             raise WorkspaceError(\\\"\\u8bf7\\u5148\\u83b7\\u53d6\\u5f53\\u524d\\u4efb\\u52a1\\uff0c\\u751f\\u6210\\u672c\\u5730\\u5de5\\u5355\\u6e05\\u5355\\\")\\n1010:         index = parse_json(raw, index_path)\\n1011:         if not isinstance(index.get(\\\"tasks\\\"), list):\\n1012:             raise WorkspaceError(\\\"\\u5de5\\u5355\\u6e05\\u5355\\u7f3a\\u5c11 tasks \\u5217\\u8868\\\")\\n1013:         available = {}\\n1014:         for item in index[\\\"tasks\\\"]:\\n1015:             if not isinstance(item, dict):\\n1016:                 raise WorkspaceError(\\\"\\u5de5\\u5355\\u6e05\\u5355\\u6761\\u76ee\\u65e0\\u6548\\\")\\n1017:             entry = issue_entry(item.get(\\\"issue_id\\\"), item.get(\\\"title\\\"))\\n1018:             if item != entry:\\n1019:                 raise WorkspaceError(\\\"\\u5de5\\u5355\\u6e05\\u5355\\u6761\\u76ee\\u65e0\\u6548\\\")\\n1020:             available[entry[\\\"issue_id\\\"]] = entry\\n1021:         selected = {} if replace else {t[\\\"issue_id\\\"]: t for t in value[\\\"tracked_tasks\\\"]}\\n1022:         for issue_id in issue_ids:\\n1023:             if issue_id not in available or read_bytes(root / available[issue_id][\\\"description_path\\\"]) is None:\\n1024:                 raise WorkspaceError(f\\\"\\u5de5\\u5355 {issue_id} \\u4e0d\\u5728\\u5f53\\u524d\\u6e05\\u5355\\u6216\\u6b63\\u6587\\u7f3a\\u5931\\uff0c\\u8bf7\\u91cd\\u65b0\\u83b7\\u53d6\\\")\\n1025:             selected[issue_id] = available[issue_id]\\n1026:         value[\\\"tracked_tasks\\\"] = list(selected.values())\\n1027:     return save_tracking(path, old, value, \\\"untrack\\\" if remove else \\\"track\\\", apply)\\n1028: \\n1029: \\n1030: def record_coverage_task(root_arg, global_arg, task, apply=False):\\n1031:     \\\"\\\"\\\"\\u6309\\u5de5\\u5355\\u548c\\u5206\\u652f\\u767b\\u8bb0\\u8986\\u76d6\\u7387\\u8eab\\u4efd\\uff0c\\u4ec5\\u5199\\u4e2a\\u4eba\\u76ee\\u5f55\\uff0c\\u4e0d\\u66f4\\u65b0\\u5165\\u53e3\\u6587\\u4ef6\\u3002\\\"\\\"\\\"\\n1032:     validate_coverage(task)\\n1033:     _, personal, _ = paths(root_arg, global_arg)\\n1034:     path, old, value = read_tracking(personal)\\n1035:     value[\\\"coverage_tasks\\\"] = [t for t in value[\\\"coverage_tasks\\\"]\\n1036:                                if (t[\\\"redmine_id\\\"], t[\\\"branch\\\"]) != (task[\\\"redmine_id\\\"], task[\\\"branch\\\"])]\\n1037:     value[\\\"coverage_tasks\\\"].append(task)\\n1038:     value[\\\"coverage_tasks\\\"].sort(key=lambda t: (t[\\\"redmine_id\\\"], t[\\\"branch\\\"]))\\n1039:     return save_tracking(path, old, value, \\\"coverage-task\\\", apply)\\n1040: \\n1041: \\n1042: def busy_codex_jobs(personal):\\n1043:     \\\"\\\"\\\"\\u8fd4\\u56de\\u4e0d\\u80fd\\u6e05\\u7406\\u7684 codex-cli \\u4efb\\u52a1\\uff1a\\u4ecd\\u5728\\u8fd0\\u884c\\uff08starting\\uff0frunning\\uff09\\uff0c\\u6216 test \\u4efb\\u52a1\\u7684\\u8bbe\\u5907\\u5c1a\\u672a release\\u3002\\n1044: \\n1045:     state.json \\u65e0\\u6cd5\\u8bfb\\u53d6\\u65f6\\u4e5f\\u7b97\\u5728\\u5185\\uff0c\\u7531\\u7528\\u6237\\u6838\\u5b9e\\u540e\\u518d\\u6e05\\u7406\\u3002\\n1046:     \\\"\\\"\\\"\\n1047:     jobs = personal / CODEX_JOBS\\n1048:     no_links(jobs)\\n1049:     if not jobs.is_dir():\\n1050:         return []\\n1051:     busy = []\\n1052:     for job in sorted(jobs.iterdir()):\\n1053:         state_path = job / \\\"state.json\\\"\\n1054:         try:\\n1055:             raw = read_bytes(state_path)\\n1056:             if raw is None:\\n1057:                 continue\\n1058:             state = parse_json(raw, state_path)\\n1059:         except (WorkspaceError, OSError) as error:\\n1060:             busy.append(f\\\"{job.name}\\uff08state.json \\u65e0\\u6cd5\\u8bfb\\u53d6\\uff1a{error}\\uff09\\\")\\n1061:             continue\\n1062:         status = state.get(\\\"status\\\")\\n1063:         if isinstance(status, str) and status.startswith(CODEX_ACTIVE):\\n1064:             busy.append(f\\\"{job.name}\\uff08{status}\\uff09\\\")\\n1065:         elif state.get(\\\"kind\\\") == \\\"test\\\" and state.get(\\\"released\\\") is not True:\\n1066:             busy.append(f\\\"{job.name}\\uff08test \\u4efb\\u52a1\\u5c1a\\u672a release\\uff09\\\")\\n1067:     return busy\\n1068: \\n1069: \\n1070: def clean(root_arg, global_arg, apply=False):\\n1071:     \\\"\\\"\\\"\\u6e05\\u7a7a\\u4e2a\\u4eba\\u76ee\\u5f55\\uff1bcodex-cli \\u6709\\u672a\\u7ed3\\u675f\\u6216\\u672a release \\u7684\\u4efb\\u52a1\\u65f6\\u62d2\\u7edd\\uff0c\\u4e0d\\u5220\\u9664\\u4efb\\u4f55\\u5185\\u5bb9\\u3002\\\"\\\"\\\"\\n1072:     root, personal, global_config = paths(root_arg, global_arg)\\n1073:     if not exists(personal):\\n1074:         return {\\\"action\\\": \\\"clean\\\", \\\"applied\\\": apply, \\\"target\\\": str(personal), \\\"entries\\\": []}\\n1075:     busy = busy_codex_jobs(personal)\\n1076:     if busy:\\n1077:         raise WorkspaceError(\\\"codex-cli \\u8fd8\\u6709\\u672a\\u7ed3\\u675f\\u6216\\u672a release \\u7684\\u4efb\\u52a1\\uff0c\\u8bf7\\u5148\\u7b49\\u5f85\\u5b8c\\u6210\\u3001\\u53d6\\u6d88\\u6216 release \\u540e\\u518d\\u6e05\\u7406\\uff1a\\\"\\n1078:                              + \\\"\\u3001\\\".join(busy))\\n1079:     identity = personal.stat()\\n1080:     items = []\\n1081: \\n1082:     def scan(directory):\\n1083:         for path in sorted(directory.iterdir()):\\n1084:             no_links(path)\\n1085:             if not path.is_relative_to(personal):\\n1086:                 raise WorkspaceError(f\\\"\\u8d8a\\u754c\\u8def\\u5f84\\uff1a{path}\\\")\\n1087:             info = path.lstat()\\n1088:             if stat.S_ISDIR(info.st_mode):\\n1089:                 scan(path)\\n1090:             elif not stat.S_ISREG(info.st_mode):\\n1091:                 raise WorkspaceError(f\\\"\\u62d2\\u7edd\\u7279\\u6b8a\\u6587\\u4ef6\\uff1a{path}\\\")\\n1092:             items.append((path, info))\\n1093: \\n1094:     scan(personal)  # Complete preflight before any deletion.\\n1095:     entries = [str(path.relative_to(personal)) for path in sorted(personal.iterdir())]\\n1096:     if apply:\\n1097:         try:\\n1098:             for path, before in items:\\n1099:                 no_links(personal)\\n1100:                 current_root = personal.stat()\\n1101:                 if (identity.st_dev, identity.st_ino) != (current_root.st_dev, current_root.st_ino):\\n1102:                     raise WorkspaceError(\\\"\\u4e2a\\u4eba\\u76ee\\u5f55\\u8eab\\u4efd\\u53d1\\u751f\\u53d8\\u5316\\\")\\n1103:                 no_links(path)\\n1104:                 now = path.lstat()\\n1105:                 if (before.st_dev, before.st_ino, before.st_mode) != (now.st_dev, now.st_ino, now.st_mode):\\n1106:                     raise WorkspaceError(f\\\"\\u5f85\\u6e05\\u7406\\u5bf9\\u8c61\\u5df2\\u53d8\\u5316\\uff1a{path}\\\")\\n1107:                 if stat.S_ISDIR(now.st_mode):\\n1108:                     path.rmdir()\\n1109:                 else:\\n1110:                     if (before.st_size, before.st_mtime_ns) != (now.st_size, now.st_mtime_ns):\\n1111:                         raise WorkspaceError(f\\\"\\u5f85\\u6e05\\u7406\\u6587\\u4ef6\\u5df2\\u53d8\\u5316\\uff1a{path}\\\")\\n1112:                     path.unlink()\\n1113:             if any(personal.iterdir()):\\n1114:                 raise WorkspaceError(\\\"\\u6e05\\u7406\\u671f\\u95f4\\u51fa\\u73b0\\u65b0\\u6587\\u4ef6\\\")\\n1115:         except Exception as error:\\n1116:             raise WorkspaceError(f\\\"\\u6e05\\u7406\\u4e2d\\u6b62\\uff0c\\u53ef\\u80fd\\u5df2\\u90e8\\u5206\\u6e05\\u7406\\uff1a{error}\\\") from error\\n1117:     return {\\\"action\\\": \\\"clean\\\", \\\"applied\\\": apply, \\\"target\\\": str(personal), \\\"entries\\\": entries}\\n1118: \\n1119: \\n1120: def main():\\n1121:     for stream in (sys.stdout, sys.stderr):\\n1122:         if hasattr(stream, \\\"reconfigure\\\"):\\n1123:             stream.reconfigure(encoding=\\\"utf-8\\\")\\n1124:     parser = argparse.ArgumentParser(description=__doc__)\\n1125:     parser.add_argument(\\\"action\\\", choices=(\\\"sync\\\", \\\"context\\\", \\\"index\\\", \\\"clean\\\", \\\"coverage-task\\\", \\\"config\\\",\\n1126:                                            \\\"show-config\\\", \\\"track\\\", \\\"untrack\\\"))\\n1127:     parser.add_argument(\\\"--query\\\", action=\\\"append\\\", default=[], help=\\\"index\\uff1a\\u6309\\u5173\\u952e\\u8bcd\\u8fc7\\u6ee4\\uff0c\\u53ef\\u91cd\\u590d\\uff0c\\u5168\\u90e8\\u547d\\u4e2d\\\")\\n1128:     parser.add_argument(\\\"--add\\\", action=\\\"append\\\", default=[], help=\\\"index\\uff1a\\u624b\\u52a8\\u6536\\u5f55 spec\\uff0c\\u53ef\\u91cd\\u590d\\\")\\n1129:     parser.add_argument(\\\"--remove\\\", action=\\\"append\\\", default=[], help=\\\"index\\uff1a\\u79fb\\u51fa spec\\uff0c\\u53ef\\u91cd\\u590d\\\")\\n1130:     parser.add_argument(HOOK_FLAG, dest=\\\"from_hook\\\", action=\\\"store_true\\\",\\n1131:                         help=\\\"context\\uff0findex\\uff1a\\u7531 Claude Code hook \\u8c03\\u7528\\uff08context \\u8f93\\u51fa\\u6ce8\\u5165\\u683c\\u5f0f\\uff0cindex \\u4ece stdin \\u8bfb\\u53d6\\u5199\\u5165\\u4e8b\\u4ef6\\uff09\\\")\\n1132:     parser.add_argument(\\\"--issue-id\\\", action=\\\"append\\\", default=[])\\n1133:     parser.add_argument(\\\"--replace\\\", action=\\\"store_true\\\", help=\\\"\\u66ff\\u6362\\u8ffd\\u8e2a\\u5217\\u8868\\uff1b\\u9ed8\\u8ba4\\u8ffd\\u52a0\\\")\\n1134:     parser.add_argument(\\\"--prompt-password\\\", action=\\\"store_true\\\")\\n1135:     parser.add_argument(\\\"--task-name\\\")\\n1136:     parser.add_argument(\\\"--branch\\\", help=\\\"coverage-task\\uff1a\\u4ed3\\u5e93\\u76f8\\u5bf9\\u8def\\u5f84\\uff08\\u5982 branchs/2026_dev/x\\uff09\\uff0c\\u7701\\u7565\\u65f6\\u4ece svn \\u63a8\\u65ad\\\")\\n1137:     parser.add_argument(\\\"--redmine-id\\\")\\n1138:     parser.add_argument(\\\"--coder-name\\\")\\n1139:     parser.add_argument(\\\"--root\\\", default=os.getcwd())\\n1140:     parser.add_argument(\\\"--global-config\\\", default=str(Path.home() / DIRECTORY / \\\"config.json\\\"))\\n1141:     parser.add_argument(\\\"--set-global\\\", action=\\\"append\\\", default=[])\\n1142:     parser.add_argument(\\\"--set-local\\\", action=\\\"append\\\", default=[])\\n1143:     parser.add_argument(\\\"--apply\\\", action=\\\"store_true\\\")\\n1144:     args = parser.parse_args()\\n1145:     try:\\n1146:         if args.replace and args.action != \\\"track\\\":\\n1147:             raise WorkspaceError(\\\"--replace \\u4ec5\\u7528\\u4e8e track\\\")\\n1148:         if args.issue_id and args.action not in (\\\"track\\\", \\\"untrack\\\"):\\n1149:             raise WorkspaceError(\\\"--issue-id \\u4ec5\\u7528\\u4e8e track \\u6216 untrack\\\")\\n1150:         if args.action not in (\\\"sync\\\", \\\"config\\\") and (args.set_global or args.set_local):\\n1151:             raise WorkspaceError(\\\"\\u6b64\\u64cd\\u4f5c\\u4e0d\\u63a5\\u53d7 --set-global \\u6216 --set-local\\\")\\n1152:         if args.action != \\\"config\\\" and args.prompt_password:\\n1153:             raise WorkspaceError(\\\"--prompt-password \\u4ec5\\u7528\\u4e8e config\\\")\\n1154:         if args.action == \\\"config\\\" and args.set_local:\\n1155:             raise WorkspaceError(\\\"config \\u4ec5\\u66f4\\u65b0\\u7528\\u6237\\u7ea7\\u914d\\u7f6e\\\")\\n1156:         if (args.query or args.add or args.remove) and args.action != \\\"index\\\":\\n1157:             raise WorkspaceError(\\\"--query\\u3001--add\\u3001--remove \\u4ec5\\u7528\\u4e8e index\\\")\\n1158:         if args.from_hook and args.action not in (\\\"context\\\", \\\"index\\\"):\\n1159:             raise WorkspaceError(f\\\"{HOOK_FLAG} \\u4ec5\\u7528\\u4e8e context \\u6216 index\\\")\\n1160:         if args.action == \\\"index\\\" and args.from_hook:\\n1161:             # \\u5199\\u5165\\u540e\\u7684 hook \\u4e0d\\u5f97\\u5e72\\u6270\\u5de5\\u5177\\u8c03\\u7528\\uff1a\\u9759\\u9ed8\\u5904\\u7406\\uff0c\\u5931\\u8d25\\u4e5f\\u4ee5 0 \\u9000\\u51fa\\u3002\\n1162:             try:\\n1163:                 payload = json.loads(sys.stdin.buffer.read().decode(\\\"utf-8-sig\\\") or \\\"{}\\\")\\n1164:                 record_hook_write(args.root, args.global_config, payload)\\n1165:             except Exception:  # noqa: BLE001\\n1166:                 pass\\n1167:             return 0\\n1168:         if args.action == \\\"context\\\" and args.from_hook:\\n1169:             # hook \\u4e0d\\u5f97\\u963b\\u65ad\\u4f1a\\u8bdd\\uff1a\\u4efb\\u4f55\\u5931\\u8d25\\u90fd\\u4f5c\\u4e3a\\u6587\\u672c\\u6ce8\\u5165\\uff0c\\u5e76\\u4ee5 0 \\u9000\\u51fa\\u3002\\n1170:             try:\\n1171:                 text = json.dumps(context(args.root, args.global_config), ensure_ascii=False, indent=2)\\n1172:             except Exception as error:  # noqa: BLE001\\n1173:                 text = json.dumps({\\\"problems\\\": [f\\\"context \\u5931\\u8d25\\uff1a{error}\\\"]}, ensure_ascii=False)\\n1174:             print(json.dumps({\\\"hookSpecificOutput\\\": {\\n1175:                 \\\"hookEventName\\\": \\\"SessionStart\\\",\\n1176:                 \\\"additionalContext\\\": \\\"mhxy-workspace context\\uff08\\u4f1a\\u8bdd\\u5f00\\u59cb\\u65f6\\u7531 hook \\u81ea\\u52a8\\u8fd0\\u884c\\uff0c\\u672c\\u4f1a\\u8bdd\\u65e0\\u9700\\u518d\\u8fd0\\u884c\\uff09\\uff1a\\\\n\\\" + text,\\n1177:             }}, ensure_ascii=False))\\n1178:             return 0\\n1179:         if args.action == \\\"context\\\":\\n1180:             result = context(args.root, args.global_config)\\n1181:         elif args.action == \\\"index\\\":\\n1182:             result = query_index(args.root, args.global_config, args.query, args.add, args.remove)\\n1183:         elif args.action == \\\"sync\\\":\\n1184:             result = sync(args.root, args.global_config, args.set_global, args.apply,\\n1185:                           local_assignments=args.set_local)\\n1186:         elif args.action == \\\"show-config\\\":  # \\u517c\\u5bb9 0.2.x \\u5165\\u53e3\\uff1b\\u65b0\\u5165\\u53e3\\u7edf\\u4e00\\u4f7f\\u7528 context\\u3002\\n1187:             result = {\\\"effective_config\\\": masked_config(load_config(args.root, args.global_config))}\\n1188:         elif args.action == \\\"config\\\":\\n1189:             password = None\\n1190:             if args.prompt_password:\\n1191:                 if not args.apply:\\n1192:                     raise WorkspaceError(\\\"--prompt-password \\u9700\\u8981\\u540c\\u65f6\\u52a0 --apply\\uff0c\\u5426\\u5219\\u8f93\\u5165\\u7684\\u5bc6\\u7801\\u4e0d\\u4f1a\\u4fdd\\u5b58\\\")\\n1193:                 # Claude Code \\u7b49\\u547d\\u4ee4\\u5de5\\u5177\\u7684 stdin \\u53ef\\u80fd\\u662f NUL\\uff08Windows \\u4e0b\\u662f\\u5b57\\u7b26\\u8bbe\\u5907\\uff0cisatty \\u4e3a\\u771f\\uff09\\uff0c\\n1194:                 # getpass \\u4f1a\\u4e00\\u76f4\\u7b49\\u5f85\\uff1bstderr \\u4e0d\\u662f\\u7ec8\\u7aef\\u65f6\\u540c\\u6837\\u89c6\\u4e3a\\u6ca1\\u6709\\u4ea4\\u4e92\\u7ec8\\u7aef\\u3002\\n1195:                 if not (sys.stdin.isatty() and sys.stderr.isatty()):\\n1196:                     raise WorkspaceError(\\\"\\u9690\\u85cf\\u8f93\\u5165\\u5bc6\\u7801\\u9700\\u8981\\u4ea4\\u4e92\\u7ec8\\u7aef\\\")\\n1197:                 password = getpass.getpass(\\\"OpenID password (save to user config): \\\")\\n1198:             result = configure_global(args.global_config, args.set_global, password, args.apply)\\n1199:             password = None\\n1200:         elif args.action == \\\"coverage-task\\\":\\n1201:             require_initialized(paths(args.root, args.global_config)[0])\\n1202:             branch =args.branch or (svn_branch(Path(args.root)) or {}).get(\\\"path\\\")\\n1203:             if not branch:\\n1204:                 raise WorkspaceError(\\\"\\u65e0\\u6cd5\\u4ece svn \\u63a8\\u65ad\\u5206\\u652f\\uff0c\\u8bf7\\u7528 --branch \\u4f20\\u4ed3\\u5e93\\u76f8\\u5bf9\\u8def\\u5f84\\uff08\\u5982 branchs/2026_dev/x\\uff09\\\")\\n1205:             result = record_coverage_task(args.root, args.global_config,\\n1206:                 {\\\"task_name\\\": args.task_name, \\\"branch\\\": branch,\\n1207:                  \\\"redmine_id\\\": args.redmine_id, \\\"coder_name\\\": args.coder_name, \\\"created\\\": True}, args.apply)\\n1208:         elif args.action in (\\\"track\\\", \\\"untrack\\\"):\\n1209:             require_initialized(paths(args.root, args.global_config)[0])\\n1210:             result =track_tasks(args.root, args.global_config, args.issue_id,\\n1211:                                  args.replace, args.action == \\\"untrack\\\", args.apply)\\n1212:         else:\\n1213:             result = clean(args.root, args.global_config, args.apply)\\n1214:         print(json.dumps(result, ensure_ascii=False, indent=2))\\n1215:         return 0\\n1216:     except (WorkspaceError, OSError, UnicodeError, KeyError) as error:\\n1217:         print(json.dumps({\\\"error\\\": str(error)}, ensure_ascii=False), file=sys.stderr)\\n1218:         return 1\\n1219: \\n1220: \\n1221: if __name__ == \\\"__main__\\\":\\n1222:     sys.exit(main())\", \"tests/test_codex_cli.py\": \"1: \\\"\\\"\\\"codex_cli\\uff1a\\u547d\\u4ee4\\u6784\\u9020\\u3001\\u73af\\u5883\\u4e0e\\u9632\\u9012\\u5f52\\u3001\\u7eed\\u63a5\\u3001\\u5e76\\u53d1\\u72b6\\u6001\\u8bfb\\u5199\\u548c\\u8bbe\\u5907\\u9501\\uff1b\\u4e0d\\u8c03\\u7528\\u771f\\u5b9e Codex\\u3002\\\"\\\"\\\"\\n2: import importlib.util\\n3: import json\\n4: from pathlib import Path\\n5: import sys\\n6: import threading\\n7: from unittest.mock import MagicMock, patch\\n8: \\n9: import pytest\\n10: \\n11: spec = importlib.util.spec_from_file_location(\\\"codex_cli\\\", Path(__file__).resolve().parents[1] / \\\"scripts/codex_cli.py\\\")\\n12: c = importlib.util.module_from_spec(spec)\\n13: spec.loader.exec_module(c)\\n14: \\n15: CONFIG = {\\\"model_provider\\\": \\\"p\\\", \\\"model_providers\\\": {\\\"p\\\": {\\\"base_url\\\": \\\"http://x\\\"}},\\n16:           \\\"mcp_servers\\\": {\\\"mh-game-mcp\\\": {\\\"url\\\": \\\"https://game/mcp\\\", \\\"disabled_tools\\\": [\\\"x\\\"]},\\n17:                           \\\"other\\\": {\\\"url\\\": \\\"http://other\\\"}}}\\n18: TEST_RESULT = {\\\"status\\\": \\\"passed\\\", \\\"cases\\\": [\\\"local probe\\\"], \\\"errors\\\": [],\\n19:                \\\"unverified\\\": [], \\\"restoration\\\": \\\"not_needed\\\"}\\n20: \\n21: \\n22: @pytest.fixture(autouse=True)\\n23: def fake_cli(monkeypatch, tmp_path):\\n24:     monkeypatch.setattr(c, \\\"cli_prefix\\\", lambda: [\\\"codex\\\"])\\n25:     monkeypatch.setattr(c, \\\"user_config\\\", lambda: CONFIG)\\n26:     monkeypatch.setenv(\\\"LOCALAPPDATA\\\", str(tmp_path / \\\"local\\\"))\\n27:     monkeypatch.delenv(c.GUARD, raising=False)\\n28: \\n29: \\n30: def option(command, value):\\n31:     \\\"\\\"\\\"\\u8fd4\\u56de\\u67d0\\u4e2a -c \\u8986\\u76d6\\u662f\\u5426\\u5b58\\u5728\\u3002\\\"\\\"\\\"\\n32:     return any(a == \\\"-c\\\" and b == value for a, b in zip(command, command[1:]))\\n33: \\n34: \\n35: def make_root(tmp_path, name=\\\"proj\\\"):\\n36:     root = tmp_path / name\\n37:     (root / \\\".mhxy-workspace\\\").mkdir(parents=True)\\n38:     (root / \\\"AGENTS.md\\\").write_text(\\\"rules\\\", encoding=\\\"utf-8\\\")\\n39:     return root\\n40: \\n41: \\n42: # ---- \\u547d\\u4ee4\\u6784\\u9020 ----\\n43: \\n44: @pytest.mark.parametrize(\\\"kind\\\", [\\\"investigate\\\", \\\"review\\\"])\\n45: def test_read_only_kinds_use_project_root_and_no_mcp(tmp_path, kind):\\n46:     command = c.cli_command(tmp_path, {\\\"instructions\\\": \\\"x\\\"}, {\\\"kind\\\": kind, \\\"root\\\": \\\"R\\\"})\\n47:     assert command[:2] == [\\\"codex\\\", \\\"exec\\\"] and command[-1] == \\\"-\\\"\\n48:     assert command[command.index(\\\"--sandbox\\\") + 1] == \\\"read-only\\\"\\n49:     assert command[command.index(\\\"-C\\\") + 1] == \\\"R\\\"\\n50:     assert command[command.index(\\\"-m\\\") + 1] == \\\"gpt-6.1-sol\\\"\\n51:     for value in ('model_reasoning_effort=\\\"high\\\"', \\\"agents.enabled=false\\\", \\\"features.multi_agent=false\\\",\\n52:                   \\\"features.hooks=false\\\", \\\"plugins={}\\\", \\\"mcp_servers={}\\\", 'approval_policy=\\\"never\\\"',\\n53:                   'model_provider=\\\"p\\\"'):\\n54:         assert option(command, value), value\\n55:     assert \\\"--ignore-user-config\\\" in command and \\\"--output-schema\\\" in command and \\\"--add-dir\\\" not in command\\n56: \\n57: \\n58: def test_test_kind_whitelists_mcp_and_write_dirs(tmp_path):\\n59:     task = {\\\"mcp_tools\\\": {\\\"mh-game-mcp\\\": [\\\"execute_code\\\"]}, \\\"write_dirs\\\": [\\\"W\\\"]}\\n60:     command = c.cli_command(tmp_path, task, {\\\"kind\\\": \\\"test\\\", \\\"root\\\": \\\"R\\\"})\\n61:     assert command[command.index(\\\"--sandbox\\\") + 1] == \\\"workspace-write\\\"\\n62:     assert command[command.index(\\\"-C\\\") + 1] == str(tmp_path)\\n63:     assert command[command.index(\\\"--add-dir\\\") + 1] == \\\"W\\\"\\n64:     servers = [b for a, b in zip(command, command[1:]) if a == \\\"-c\\\" and b.startswith(\\\"mcp_servers=\\\")]\\n65:     assert \\\"execute_code\\\" in servers[0] and '\\\"approve\\\"' in servers[0]\\n66:     assert \\\"other\\\" not in servers[0] and \\\"disabled_tools\\\" not in servers[0]\\n67: \\n68: \\n69: def test_unconfigured_mcp_rejected(tmp_path):\\n70:     with pytest.raises(ValueError, match=\\\"\\u672a\\u914d\\u7f6e\\\"):\\n71:         c.cli_command(tmp_path, {\\\"mcp_tools\\\": {\\\"nope\\\": [\\\"a\\\"]}}, {\\\"kind\\\": \\\"test\\\", \\\"root\\\": \\\"R\\\"})\\n72: \\n73: \\n74: def test_resume_command_continues_session(tmp_path):\\n75:     command = c.cli_command(tmp_path, {}, {\\\"kind\\\": \\\"review\\\", \\\"root\\\": \\\"R\\\", \\\"resume_session\\\": \\\"S1\\\"})\\n76:     assert command[:3] == [\\\"codex\\\", \\\"exec\\\", \\\"resume\\\"]\\n77:     assert command[-2:] == [\\\"S1\\\", \\\"-\\\"]\\n78:     assert \\\"--sandbox\\\" not in command and \\\"-C\\\" not in command\\n79:     assert option(command, 'sandbox_mode=\\\"read-only\\\"') and option(command, \\\"agents.enabled=false\\\")\\n80: \\n81: \\n82: # ---- \\u73af\\u5883\\u4e0e\\u9632\\u9012\\u5f52 ----\\n83: \\n84: def test_child_env_strips_codex_vars_and_sets_guard():\\n85:     env = c.child_env({\\\"CODEX_THREAD_ID\\\": \\\"t\\\", \\\"codex_x\\\": \\\"y\\\", \\\"CODEX_HOME\\\": \\\"h\\\", \\\"PATH\\\": \\\"p\\\"})\\n86:     assert env == {\\\"CODEX_HOME\\\": \\\"h\\\", \\\"PATH\\\": \\\"p\\\", c.GUARD: \\\"1\\\"}\\n87: \\n88: \\n89: def test_start_refuses_inside_child(tmp_path, monkeypatch):\\n90:     monkeypatch.setenv(c.GUARD, \\\"1\\\")\\n91:     with pytest.raises(ValueError, match=\\\"\\u4e0d\\u5f97\\u518d\\u59d4\\u6d3e\\\"):\\n92:         c.start(make_root(tmp_path), \\\"investigate\\\", tmp_path / \\\"missing.json\\\")\\n93: \\n94: \\n95: def test_monitor_launches_cli_with_child_env(tmp_path, monkeypatch):\\n96:     monkeypatch.setenv(\\\"CODEX_SESSION_ID\\\", \\\"parent\\\")\\n97:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\", \\\"kind\\\": \\\"investigate\\\"})\\n98:     (tmp_path / \\\"prompt.txt\\\").write_text(\\\"p\\\", encoding=\\\"utf-8\\\")\\n99:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=OSError(\\\"x\\\")) as launch:\\n100:         c.monitor(tmp_path, [\\\"codex\\\"], idle_seconds=.1)\\n101:     env = launch.call_args.kwargs[\\\"env\\\"]\\n102:     assert env[c.GUARD] == \\\"1\\\" and \\\"CODEX_SESSION_ID\\\" not in env\\n103: \\n104: \\n105: # ---- \\u4efb\\u52a1\\u5185\\u5bb9 ----\\n106: \\n107: def test_references_append_to_defaults(tmp_path):\\n108:     root = make_root(tmp_path)\\n109:     refs = c.references(root, \\\"review\\\", {\\\"references\\\": [\\\"X.md\\\", str(root / \\\"AGENTS.md\\\")]})\\n110:     assert refs[0] == str(root / \\\"AGENTS.md\\\")\\n111:     assert refs[1].endswith(\\\"code-review.md\\\") and refs[2].endswith(\\\"engineering-principles.md\\\")\\n112:     assert refs[-1] == \\\"X.md\\\" and len(refs) == 4\\n113: \\n114: \\n115: def test_prompt_keeps_default_references_and_no_delegation(tmp_path):\\n116:     root = make_root(tmp_path)\\n117:     task = tmp_path / \\\"t.json\\\"\\n118:     c.write_json(task, {\\\"instructions\\\": \\\"q\\\", \\\"references\\\": [\\\"extra.md\\\"]})\\n119:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=publish_worker):\\n120:         job = Path(c.start(root, \\\"investigate\\\", task)[\\\"job\\\"])\\n121:     prompt = (job / \\\"prompt.txt\\\").read_text(encoding=\\\"utf-8\\\")\\n122:     payload = json.loads(prompt[prompt.index(\\\"{\\\"):])\\n123:     assert payload[\\\"references\\\"] == [str(root / \\\"AGENTS.md\\\"), \\\"extra.md\\\"]\\n124:     assert \\\"\\u4e0d\\u5f97\\u6d3e\\u751f\\u3001\\u8c03\\u7528\\u6216\\u8005\\u8bf7\\u6c42\\u65b0\\u7684\\u5b50\\u4ee3\\u7406\\\" in prompt\\n125:     assert job.parent == root / \\\".mhxy-workspace\\\" / \\\"codex-cli\\\"\\n126: \\n127: \\n128: def test_non_test_kind_rejects_device_fields(tmp_path):\\n129:     with pytest.raises(ValueError, match=\\\"\\u53ea\\u6709 test\\\"):\\n130:         c.prepare(tmp_path, \\\"investigate\\\", {\\\"instructions\\\": \\\"x\\\", \\\"devid\\\": \\\"d\\\"}, None)\\n131: \\n132: \\n133: def test_resume_requires_finished_review(tmp_path):\\n134:     previous = tmp_path / \\\"prev\\\"\\n135:     previous.mkdir()\\n136:     c.write_json(previous / \\\"state.json\\\", {\\\"kind\\\": \\\"review\\\", \\\"status\\\": \\\"running\\\", \\\"session_id\\\": \\\"S\\\"})\\n137:     with pytest.raises(ValueError, match=\\\"\\u4f1a\\u8bdd ID\\\"):\\n138:         c.prepare(tmp_path, \\\"review\\\", {\\\"instructions\\\": \\\"x\\\"}, previous)\\n139:     c.write_json(previous / \\\"state.json\\\", {\\\"kind\\\": \\\"review\\\", \\\"status\\\": \\\"completed\\\", \\\"session_id\\\": \\\"S\\\"})\\n140:     with pytest.raises(ValueError, match=\\\"\\u53ea\\u7528\\u4e8e review\\\"):\\n141:         c.prepare(tmp_path, \\\"investigate\\\", {\\\"instructions\\\": \\\"x\\\"}, previous)\\n142:     assert c.prepare(tmp_path, \\\"review\\\", {\\\"instructions\\\": \\\"x\\\"}, previous)[1] == \\\"S\\\"\\n143: \\n144: \\n145: def test_start_resume_records_session(tmp_path):\\n146:     root = make_root(tmp_path)\\n147:     previous = tmp_path / \\\"prev\\\"\\n148:     previous.mkdir()\\n149:     c.write_json(previous / \\\"state.json\\\", {\\\"kind\\\": \\\"review\\\", \\\"status\\\": \\\"completed\\\", \\\"session_id\\\": \\\"S\\\"})\\n150:     task = tmp_path / \\\"t.json\\\"\\n151:     c.write_json(task, {\\\"instructions\\\": \\\"round 2\\\"})\\n152:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=publish_worker):\\n153:         job = Path(c.start(root, \\\"review\\\", task, previous)[\\\"job\\\"])\\n154:     state = c.read_json(job / \\\"state.json\\\")\\n155:     assert state[\\\"resume_session\\\"] == \\\"S\\\" and state[\\\"kind\\\"] == \\\"review\\\"\\n156: \\n157: \\n158: # ---- \\u5e76\\u53d1\\u8bfb\\u5199 ----\\n159: \\n160: def test_read_json_retries_permission_error(tmp_path):\\n161:     path = tmp_path / \\\"s.json\\\"\\n162:     path.write_text('{\\\"a\\\": 1}', encoding=\\\"utf-8\\\")\\n163:     original = Path.read_text\\n164:     calls = []\\n165: \\n166:     def flaky(self, *args, **kwargs):\\n167:         calls.append(1)\\n168:         if len(calls) < 3:\\n169:             raise PermissionError(\\\"busy\\\")\\n170:         return original(self, *args, **kwargs)\\n171: \\n172:     with patch.object(Path, \\\"read_text\\\", flaky), patch.object(c.time, \\\"sleep\\\"):\\n173:         assert c.read_json(path) == {\\\"a\\\": 1}\\n174:     assert len(calls) == 3\\n175: \\n176: \\n177: def test_write_json_retries_replace_and_cleans_temp(tmp_path):\\n178:     original = c.os.replace\\n179:     calls = []\\n180: \\n181:     def flaky(src, dst):\\n182:         calls.append(1)\\n183:         if len(calls) == 1:\\n184:             raise PermissionError(\\\"busy\\\")\\n185:         original(src, dst)\\n186: \\n187:     with patch.object(c.os, \\\"replace\\\", flaky), patch.object(c.time, \\\"sleep\\\"):\\n188:         c.write_json(tmp_path / \\\"s.json\\\", {\\\"b\\\": 2})\\n189:     assert c.read_json(tmp_path / \\\"s.json\\\") == {\\\"b\\\": 2}\\n190:     assert [p.name for p in tmp_path.iterdir()] == [\\\"s.json\\\"]\\n191: \\n192: \\n193: def test_concurrent_reads_during_writes(tmp_path):\\n194:     path = tmp_path / \\\"s.json\\\"\\n195:     c.write_json(path, {\\\"n\\\": 0})\\n196:     errors = []\\n197: \\n198:     def reader():\\n199:         for _ in range(200):\\n200:             try:\\n201:                 c.read_json(path)\\n202:             except Exception as error:\\n203:                 errors.append(error)\\n204: \\n205:     thread = threading.Thread(target=reader)\\n206:     thread.start()\\n207:     for n in range(200):\\n208:         c.write_json(path, {\\\"n\\\": n})\\n209:     thread.join()\\n210:     assert not errors\\n211: \\n212: \\n213: # ---- worker \\u4e0e\\u72b6\\u6001 ----\\n214: \\n215: def worker_job(tmp_path, **state):\\n216:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\", \\\"kind\\\": \\\"investigate\\\", \\\"root\\\": \\\"R\\\", **state})\\n217:     c.write_json(tmp_path / \\\"task.json\\\", {\\\"instructions\\\": \\\"x\\\"})\\n218:     return tmp_path\\n219: \\n220: \\n221: def test_worker_runs_once(tmp_path):\\n222:     job = worker_job(tmp_path)\\n223:     with patch.object(c, \\\"monitor\\\") as run:\\n224:         assert c.worker(job) == 0\\n225:         assert c.worker(job) == 1\\n226:     assert run.call_count == 1\\n227: \\n228: \\n229: @pytest.mark.parametrize(\\\"state\\\", [{\\\"status\\\": \\\"running\\\"}, {\\\"cli_pid\\\": 1}])\\n230: def test_worker_refuses_reentry(tmp_path, state):\\n231:     job = worker_job(tmp_path, **state)\\n232:     with patch.object(c, \\\"monitor\\\") as run, patch.object(c, \\\"alive\\\", return_value=True):\\n233:         assert c.worker(job) == 1\\n234:     run.assert_not_called()\\n235:     assert c.read_json(job / \\\"state.json\\\").get(\\\"monitor_pid\\\") is None\\n236: \\n237: \\n238: def test_status_persists_failure_when_monitor_gone(tmp_path):\\n239:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"running\\\", \\\"monitor_pid\\\": 99})\\n240:     with patch.object(c, \\\"alive\\\", return_value=False):\\n241:         assert c.status(tmp_path)[\\\"status\\\"] == \\\"failed\\\"\\n242:     assert c.read_json(tmp_path / \\\"state.json\\\")[\\\"status\\\"] == \\\"failed\\\"\\n243: \\n244: \\n245: def test_status_detects_dead_worker_before_publish(tmp_path):\\n246:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\"})\\n247:     (tmp_path / \\\"worker.pid\\\").write_text(\\\"99\\\", encoding=\\\"utf-8\\\")\\n248:     with patch.object(c, \\\"alive\\\", return_value=False):\\n249:         assert c.status(tmp_path)[\\\"status\\\"] == \\\"failed\\\"\\n250: \\n251: \\n252: # ---- \\u8bbe\\u5907\\u9501 ----\\n253: \\n254: def publish_worker(argv, **kwargs):\\n255:     \\\"\\\"\\\"\\u6a21\\u62df worker \\u542f\\u52a8\\u540e\\u53d1\\u5e03\\u81ea\\u5df1\\u7684 PID\\u3002\\\"\\\"\\\"\\n256:     job = Path(argv[argv.index(\\\"--job\\\") + 1])\\n257:     state = c.read_json(job / \\\"state.json\\\")\\n258:     state[\\\"monitor_pid\\\"] = 4242\\n259:     c.write_json(job / \\\"state.json\\\", state)\\n260:     process = MagicMock(pid=4242)\\n261:     process.poll.return_value = None\\n262:     return process\\n263: \\n264: \\n265: def silent_worker(exited):\\n266:     def launch(argv, **kwargs):\\n267:         process = MagicMock(pid=4343)\\n268:         process.poll.return_value = 1 if exited else None\\n269:         return process\\n270:     return launch\\n271: \\n272: \\n273: def device_task(tmp_path):\\n274:     task = tmp_path / \\\"task.json\\\"\\n275:     c.write_json(task, {\\\"devid\\\": \\\"dev\\\", \\\"instructions\\\": \\\"t\\\", \\\"write_dirs\\\": []})\\n276:     return task\\n277: \\n278: \\n279: def test_device_locked_across_workspaces(tmp_path):\\n280:     task = device_task(tmp_path)\\n281:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=publish_worker):\\n282:         first = c.start(make_root(tmp_path, \\\"one\\\"), \\\"test\\\", task)\\n283:         with pytest.raises(ValueError, match=\\\"\\u8bbe\\u5907\\u5df2\\u6709\\u4efb\\u52a1\\\"):\\n284:             c.start(make_root(tmp_path, \\\"two\\\"), \\\"test\\\", task)\\n285:     state = c.read_json(Path(first[\\\"job\\\"]) / \\\"state.json\\\")\\n286:     assert Path(state[\\\"lock\\\"]).exists() and state[\\\"released\\\"] is False\\n287: \\n288: \\n289: def test_start_timeout_keeps_starting_and_lock(tmp_path, monkeypatch):\\n290:     monkeypatch.setattr(c, \\\"START_SECONDS\\\", 0.2)\\n291:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=silent_worker(exited=False)):\\n292:         result = c.start(make_root(tmp_path), \\\"test\\\", device_task(tmp_path))\\n293:     state = c.read_json(Path(result[\\\"job\\\"]) / \\\"state.json\\\")\\n294:     assert result[\\\"status\\\"] == \\\"starting\\\" and \\\"note\\\" in result\\n295:     assert state[\\\"status\\\"] == \\\"starting\\\" and Path(state[\\\"lock\\\"]).exists()\\n296: \\n297: \\n298: def test_dead_worker_releases_lock(tmp_path):\\n299:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=silent_worker(exited=True)):\\n300:         result = c.start(make_root(tmp_path), \\\"test\\\", device_task(tmp_path))\\n301:     state = c.read_json(Path(result[\\\"job\\\"]) / \\\"state.json\\\")\\n302:     assert state[\\\"status\\\"] == \\\"failed\\\" and not Path(state[\\\"lock\\\"]).exists()\\n303: \\n304: \\n305: def test_setup_failure_removes_job_and_lock(tmp_path):\\n306:     root = make_root(tmp_path)\\n307:     with patch.object(c, \\\"cli_prefix\\\", side_effect=RuntimeError(\\\"\\u672a\\u5b89\\u88c5 Codex CLI\\\")):\\n308:         with pytest.raises(RuntimeError):\\n309:             c.start(root, \\\"test\\\", device_task(tmp_path))\\n310:     assert list((root / \\\".mhxy-workspace/codex-cli\\\").iterdir()) == []\\n311:     assert not list((tmp_path / \\\"local/mhxy-cli-testing/locks\\\").iterdir())\\n312: \\n313: \\n314: def test_release_rules(tmp_path, capsys):\\n315:     lock = tmp_path / \\\"lock.json\\\"\\n316:     c.write_json(lock, {\\\"job\\\": str(tmp_path)})\\n317:     base = {\\\"kind\\\": \\\"test\\\", \\\"lock\\\": str(lock), \\\"released\\\": False}\\n318:     c.write_json(tmp_path / \\\"state.json\\\", {**base, \\\"status\\\": \\\"running\\\", \\\"monitor_pid\\\": 1})\\n319:     argv = [\\\"codex_cli\\\", \\\"release\\\", \\\"--job\\\", str(tmp_path), \\\"--restored\\\"]\\n320:     with patch.object(sys, \\\"argv\\\", argv), patch.object(c, \\\"alive\\\", return_value=True):\\n321:         assert c.main() == 2\\n322:     c.write_json(tmp_path / \\\"state.json\\\", {**base, \\\"status\\\": \\\"timed_out\\\"})\\n323:     with patch.object(sys, \\\"argv\\\", argv[:-1]):\\n324:         assert c.main() == 2\\n325:     assert lock.exists()\\n326:     with patch.object(sys, \\\"argv\\\", argv):\\n327:         assert c.main() == 0\\n328:     assert not lock.exists()\\n329:     assert c.read_json(tmp_path / \\\"state.json\\\")[\\\"released\\\"] is True\\n330:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"kind\\\": \\\"review\\\", \\\"status\\\": \\\"completed\\\"})\\n331:     with patch.object(sys, \\\"argv\\\", argv):\\n332:         assert c.main() == 2\\n333: \\n334: \\n335: # ---- \\u76d1\\u63a7\\u771f\\u5b9e\\u672c\\u5730\\u5b50\\u8fdb\\u7a0b ----\\n336: \\n337: def run_probe(tmp_path, code, kind=\\\"test\\\", idle=0.4, cancel=False):\\n338:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\", \\\"kind\\\": kind, \\\"restoration\\\": \\\"unknown\\\"})\\n339:     (tmp_path / \\\"prompt.txt\\\").write_text(\\\"probe\\\", encoding=\\\"utf-8\\\")\\n340:     timer = threading.Timer(0.15, lambda: (tmp_path / \\\"cancel\\\").touch()) if cancel else None\\n341:     if timer:\\n342:         timer.start()\\n343:     c.monitor(tmp_path, [sys.executable, \\\"-u\\\", \\\"-c\\\", code], idle_seconds=idle)\\n344:     if timer:\\n345:         timer.join()\\n346:     return c.read_json(tmp_path / \\\"state.json\\\")\\n347: \\n348: \\n349: def result_code(result):\\n350:     return \\\"from pathlib import Path; Path('result.json').write_text(\\\" + repr(json.dumps(result, ensure_ascii=False)) + \\\", encoding='utf-8')\\\"\\n351: \\n352: \\n353: def test_silent_process_is_stopped(tmp_path):\\n354:     state = run_probe(tmp_path, \\\"import time; time.sleep(10)\\\")\\n355:     assert state[\\\"status\\\"] == \\\"timed_out\\\" and state[\\\"exit_code\\\"] is not None\\n356: \\n357: \\n358: def test_output_refreshes_idle_and_records_session(tmp_path):\\n359:     code = (\\\"import time,sys\\\\nprint('{\\\\\\\"type\\\\\\\":\\\\\\\"thread.started\\\\\\\",\\\\\\\"thread_id\\\\\\\":\\\\\\\"T1\\\\\\\"}', flush=True)\\\\n\\\"\\n360:             \\\"for i in range(8):\\\\n sys.stderr.write('x'); sys.stderr.flush(); time.sleep(.1)\\\\n\\\" + result_code(TEST_RESULT))\\n361:     state = run_probe(tmp_path, code)\\n362:     assert state[\\\"status\\\"] == \\\"completed\\\" and state[\\\"result\\\"] == TEST_RESULT\\n363:     assert state[\\\"restoration\\\"] == \\\"not_needed\\\" and state[\\\"session_id\\\"] == \\\"T1\\\"\\n364: \\n365: \\n366: def test_review_result_is_formatted(tmp_path):\\n367:     result = {\\\"summary\\\": \\\"s\\\", \\\"items\\\": [{\\\"level\\\": \\\"\\u5fc5\\u987b\\u4fee\\u6539\\\", \\\"location\\\": \\\"a.py:3\\\", \\\"problem\\\": \\\"p\\\",\\n368:                                          \\\"basis\\\": \\\"b\\\", \\\"suggestion\\\": \\\"fix\\\"}]}\\n369:     state = run_probe(tmp_path, result_code(result), kind=\\\"review\\\")\\n370:     assert state[\\\"status\\\"] == \\\"completed\\\" and state[\\\"must_fix\\\"] == 1\\n371:     assert state[\\\"formatted\\\"] == [\\\"[\\u5fc5\\u987b\\u4fee\\u6539] a.py:3 \\u2014\\u2014 p\\uff1bb\\uff1bfix\\\"]\\n372: \\n373: \\n374: def test_zero_exit_without_valid_result_is_failed(tmp_path):\\n375:     state = run_probe(tmp_path, result_code({\\\"conclusion\\\": \\\"x\\\"}), kind=\\\"investigate\\\")\\n376:     assert state[\\\"status\\\"] == \\\"failed\\\" and state[\\\"exit_code\\\"] == 0\\n377: \\n378: \\n379: def test_nonzero_exit_cannot_pass(tmp_path):\\n380:     state = run_probe(tmp_path, result_code(TEST_RESULT) + \\\"; raise SystemExit(3)\\\")\\n381:     assert state[\\\"status\\\"] == \\\"failed\\\"\\n382: \\n383: \\n384: def test_cancel_stops_process(tmp_path):\\n385:     state = run_probe(tmp_path, \\\"import time; time.sleep(10)\\\", cancel=True)\\n386:     assert state[\\\"status\\\"] == \\\"cancelled\\\" and state[\\\"restoration\\\"] == \\\"unknown\\\"\\n387: \\n388: \\n389: def test_monitor_failure_never_records_command(tmp_path):\\n390:     c.write_json(tmp_path / \\\"state.json\\\", {\\\"status\\\": \\\"starting\\\", \\\"kind\\\": \\\"test\\\"})\\n391:     (tmp_path / \\\"prompt.txt\\\").write_text(\\\"probe\\\", encoding=\\\"utf-8\\\")\\n392:     with patch.object(c.subprocess, \\\"Popen\\\", side_effect=OSError(\\\"secret-auth-value\\\")):\\n393:         c.monitor(tmp_path, [\\\"secret-auth-value\\\"], idle_seconds=.1)\\n394:     state = c.read_json(tmp_path / \\\"state.json\\\")\\n395:     assert state[\\\"status\\\"] == \\\"failed\\\" and \\\"secret-auth-value\\\" not in json.dumps(state)\\n396: \\n397: \\n398: def test_outside_and_linked_write_directory_rejected(tmp_path):\\n399:     base = tmp_path / \\\".mhxy-workspace\\\"\\n400:     base.mkdir()\\n401:     with pytest.raises(ValueError):\\n402:         c.checked_directory(tmp_path / \\\"business\\\", base)\\n403:     with pytest.raises(ValueError):\\n404:         c.checked_directory(base, base)\\n405:     assert c.checked_directory(base / \\\"tests\\\", base) == base / \\\"tests\\\"\", \"tests/test_precommit.py\": \"1: \\\"\\\"\\\"\\u63d0\\u4ea4\\u524d\\u81ea\\u68c0\\u7684\\u9694\\u79bb\\u6d4b\\u8bd5\\uff1bsvn \\u8c03\\u7528\\u5168\\u90e8\\u66ff\\u6362\\u4e3a\\u5047\\u6570\\u636e\\u3002\\\"\\\"\\\"\\n2: import contextlib\\n3: import io\\n4: import json\\n5: from pathlib import Path\\n6: import subprocess\\n7: import sys\\n8: import tempfile\\n9: import unittest\\n10: from unittest.mock import patch\\n11: \\n12: sys.dont_write_bytecode = True\\n13: sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \\\"scripts\\\"))\\n14: import precommit as p  # noqa: E402\\n15: \\n16: STATUS_XML = \\\"\\\"\\\"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?>\\n17: <status>\\n18: <target path=\\\".\\\">\\n19: <entry path=\\\".mhxy-workspace\\\"><wc-status item=\\\"unversioned\\\" props=\\\"none\\\"/></entry>\\n20: <entry path=\\\"prot\\\"><wc-status item=\\\"external\\\" props=\\\"none\\\"/></entry>\\n21: <entry path=\\\"gameplay\\\\\\\\chat\\\\\\\\a.py\\\"><wc-status item=\\\"modified\\\" props=\\\"none\\\"/></entry>\\n22: <entry path=\\\"gameplay\\\\\\\\new.py\\\"><wc-status item=\\\"unversioned\\\" props=\\\"none\\\"/></entry>\\n23: <entry path=\\\"gameplay\\\\\\\\gone.py\\\"><wc-status item=\\\"missing\\\" props=\\\"none\\\"/></entry>\\n24: <entry path=\\\"gameplay\\\\\\\\c.py\\\"><wc-status item=\\\"conflicted\\\" props=\\\"none\\\"/></entry>\\n25: <entry path=\\\"data\\\\\\\\table.py\\\"><wc-status item=\\\"modified\\\" props=\\\"none\\\"/></entry>\\n26: <entry path=\\\"lib\\\"><wc-status item=\\\"normal\\\" props=\\\"modified\\\"/></entry>\\n27: <entry path=\\\"old.py\\\"><wc-status item=\\\"deleted\\\" props=\\\"none\\\"/></entry>\\n28: </target>\\n29: <changelist name=\\\"ignore-on-commit\\\">\\n30: <entry path=\\\"AGENTS.md\\\"><wc-status item=\\\"modified\\\" props=\\\"none\\\"/></entry>\\n31: </changelist>\\n32: </status>\\\"\\\"\\\".encode(\\\"utf-8\\\")\\n33: \\n34: \\n35: class PrecommitTests(unittest.TestCase):\\n36:     def setUp(self):\\n37:         self.temp = tempfile.TemporaryDirectory()\\n38:         self.root = Path(self.temp.name).resolve()\\n39: \\n40:     def tearDown(self):\\n41:         self.temp.cleanup()\\n42: \\n43:     def write(self, relative, data):\\n44:         path = self.root / relative\\n45:         path.parent.mkdir(parents=True, exist_ok=True)\\n46:         path.write_bytes(data if isinstance(data, bytes) else data.encode(\\\"utf-8\\\"))\\n47:         return path\\n48: \\n49:     def test_status_parsing_and_classification(self):\\n50:         with patch.object(p, \\\"run_svn\\\", return_value=STATUS_XML):\\n51:             entries = p.svn_status(self.root)\\n52:         self.assertIn({\\\"path\\\": \\\"AGENTS.md\\\", \\\"item\\\": \\\"modified\\\", \\\"props\\\": \\\"none\\\", \\\"tree_conflict\\\": False,\\n53:                        \\\"changelist\\\": \\\"ignore-on-commit\\\"}, entries)\\n54:         result = p.classify(entries)\\n55:         self.assertEqual(result[\\\"commit\\\"], [\\\"gameplay/chat/a.py\\uff08modified\\uff09\\\", \\\"lib\\uff08\\u5c5e\\u6027\\u4fee\\u6539\\uff09\\\", \\\"old.py\\uff08deleted\\uff09\\\"])\\n56:         self.assertEqual(sorted(result[\\\"excluded_local_only\\\"]), [\\\".mhxy-workspace\\\", \\\"AGENTS.md\\\"])\\n57:         self.assertEqual(result[\\\"excluded_data\\\"], [\\\"data/table.py\\\"])\\n58:         self.assertEqual(result[\\\"unversioned\\\"], [\\\"gameplay/new.py\\\"])\\n59:         self.assertEqual(result[\\\"property_changes\\\"], [\\\"lib\\\"])\\n60:         self.assertEqual(len(result[\\\"blocking\\\"]), 2)\\n61:         self.assertTrue(any(\\\"gone.py\\\" in item and \\\"missing\\\" in item for item in result[\\\"blocking\\\"]))\\n62: \\n63:     def test_builtin_source_checks(self):\\n64:         good = self.write(\\\"good.py\\\", \\\"# -*- coding: utf-8 -*-\\\\r\\\\nx = '\\u4e2d\\u6587'\\\\r\\\\n\\\")\\n65:         gbk = self.write(\\\"gbk.py\\\", \\\"# -*- coding: gbk -*-\\\\nx = 1\\\\n\\\")\\n66:         bad_bytes = self.write(\\\"bad.py\\\", \\\"x = '\\u4e2d\\u6587'\\\\n\\\".encode(\\\"gb18030\\\"))\\n67:         syntax = self.write(\\\"syntax.py\\\", \\\"def f(:\\\\n\\\")\\n68:         mixed = self.write(\\\"mixed.py\\\", \\\"a = 1\\\\r\\\\nb = 2\\\\n\\\")\\n69:         blocking, warnings, method = p.check_sources(self.root, [good, gbk, bad_bytes, syntax, mixed])\\n70:         self.assertIn(\\\"\\u5185\\u7f6e\\u68c0\\u67e5\\\", method)\\n71:         self.assertEqual(len(blocking), 3)\\n72:         self.assertTrue(any(\\\"gbk.py\\\" in item and \\\"\\u7f16\\u7801\\u58f0\\u660e\\\" in item for item in blocking))\\n73:         self.assertTrue(any(\\\"bad.py\\\" in item and \\\"UTF-8\\\" in item for item in blocking))\\n74:         self.assertTrue(any(\\\"syntax.py:1\\\" in item for item in blocking))\\n75:         self.assertEqual(warnings, [\\\"mixed.py\\uff1a\\u6df7\\u7528 CRLF \\u548c LF \\u6362\\u884c\\\"])\\n76: \\n77:     def test_project_encoding_tool_is_preferred(self):\\n78:         source = self.write(\\\"a.py\\\", \\\"x = 1\\\\n\\\")\\n79:         self.write(p.ENCODING_TOOL, \\\"import sys\\\\nprint('ERROR\\\\\\\\ta.py\\\\\\\\tbad header')\\\\nprint('OK\\\\\\\\tdone')\\\\nsys.exit(1)\\\\n\\\")\\n80:         blocking, warnings, method = p.check_sources(self.root, [source])\\n81:         self.assertEqual(method, p.ENCODING_TOOL)\\n82:         self.assertEqual(blocking, [\\\"ERROR\\\\ta.py\\\\tbad header\\\"])\\n83:         self.write(p.ENCODING_TOOL, \\\"print('WARN\\\\\\\\ta.py\\\\\\\\tmojibake?')\\\\n\\\")\\n84:         blocking, warnings, _ = p.check_sources(self.root, [source])\\n85:         self.assertEqual((blocking, warnings), ([], [\\\"WARN\\\\ta.py\\\\tmojibake?\\\"]))\\n86: \\n87:     def test_leftovers_from_new_and_modified_files(self):\\n88:         self.write(\\\"gameplay/new.py\\\", \\\"import pdb\\\\nprint('x')\\\\nDEV = 'mh_at_\\\" + \\\"a\\\" * 32 + \\\"'\\\\n\\\")\\n89:         self.write(\\\"gameplay/a.py\\\", \\\"value = 1\\\\n\\\")\\n90:         diff = \\\"--- a.py\\\\n+++ a.py\\\\n@@\\\\n-old\\\\n+    print('debug')\\\\n+value = 1\\\\n\\\".encode(\\\"utf-8\\\")\\n91:         entries = [{\\\"path\\\": \\\"gameplay/new.py\\\", \\\"item\\\": \\\"unversioned\\\"}, {\\\"path\\\": \\\"gameplay/a.py\\\", \\\"item\\\": \\\"modified\\\"},\\n92:                    {\\\"path\\\": \\\"data/t.py\\\", \\\"item\\\": \\\"modified\\\"}, {\\\"path\\\": \\\"readme.md\\\", \\\"item\\\": \\\"modified\\\"}]\\n93:         with patch.object(p, \\\"run_svn\\\", return_value=diff) as run:\\n94:             warnings = p.check_leftovers(self.root, entries)\\n95:         run.assert_called_once()\\n96:         self.assertEqual(len(warnings), 4)\\n97:         self.assertTrue(any(\\\"\\u8c03\\u8bd5\\u65ad\\u70b9\\\" in w for w in warnings))\\n98:         self.assertTrue(any(\\\"\\u5199\\u6b7b\\u7684\\u8bbe\\u5907 ID\\\" in w for w in warnings))\\n99:         self.assertTrue(any(w.startswith(\\\"gameplay/a.py\\uff1a\\u65b0\\u589e print\\\") for w in warnings))\\n100: \\n101:     def test_ignore_on_commit_files_are_not_commit_candidates(self):\\n102:         entries = [{\\\"path\\\": \\\"gameplay/local.py\\\", \\\"item\\\": \\\"modified\\\", \\\"props\\\": \\\"none\\\", \\\"tree_conflict\\\": False,\\n103:                     \\\"changelist\\\": \\\"ignore-on-commit\\\"},\\n104:                    {\\\"path\\\": \\\"lib\\\", \\\"item\\\": \\\"normal\\\", \\\"props\\\": \\\"modified\\\", \\\"tree_conflict\\\": False,\\n105:                     \\\"changelist\\\": \\\"ignore-on-commit\\\"},\\n106:                    {\\\"path\\\": \\\"CLAUDE.md\\\", \\\"item\\\": \\\"modified\\\", \\\"props\\\": \\\"none\\\", \\\"tree_conflict\\\": False,\\n107:                     \\\"changelist\\\": \\\"ignore-on-commit\\\"},\\n108:                    {\\\"path\\\": \\\"gameplay/b.py\\\", \\\"item\\\": \\\"modified\\\", \\\"props\\\": \\\"none\\\", \\\"tree_conflict\\\": False,\\n109:                     \\\"changelist\\\": \\\"feature\\\"}]\\n110:         self.write(\\\"gameplay/local.py\\\", \\\"print('local')\\\\n\\\")\\n111:         result = p.classify(entries)\\n112:         self.assertEqual(result[\\\"commit\\\"], [\\\"gameplay/b.py\\uff08modified\\uff09\\\"])\\n113:         self.assertEqual(result[\\\"ignore_on_commit\\\"], [\\\"gameplay/local.py\\uff08modified\\uff09\\\", \\\"lib\\uff08\\u5c5e\\u6027\\u4fee\\u6539\\uff09\\\"])\\n114:         self.assertEqual(result[\\\"excluded_local_only\\\"], [\\\"CLAUDE.md\\\"])\\n115:         self.assertEqual(result[\\\"property_changes\\\"], [])\\n116:         # \\u4e0d\\u63d0\\u4ea4\\u7684\\u6587\\u4ef6\\u4e5f\\u4e0d\\u505a\\u7f16\\u7801\\u68c0\\u67e5\\u548c\\u8c03\\u8bd5\\u6b8b\\u7559\\u626b\\u63cf\\u3002\\n117:         self.assertNotIn(self.root / \\\"gameplay\\\" / \\\"local.py\\\", p.source_files(self.root, entries))\\n118: \\n119:     def test_diff_with_mixed_encodings_and_chinese_names(self):\\n120:         # svn diff \\u7684\\u6587\\u4ef6\\u5934\\u7528\\u7cfb\\u7edf\\u4ee3\\u7801\\u9875\\uff08cp936\\uff09\\uff0c\\u5185\\u5bb9\\u884c\\u662f\\u6587\\u4ef6\\u539f\\u59cb\\u5b57\\u8282\\uff08UTF-8\\uff09\\u3002\\n121:         diff = (\\\"Index: \\u754c\\u9762/\\u4e2d\\u6587.py\\\\n\\\" + \\\"=\\\" * 67 + \\\"\\\\n\\\").encode(\\\"gbk\\\")\\n122:         diff += \\\"--- \\u754c\\u9762/\\u4e2d\\u6587.py\\\\t(\\u7248\\u672c 3)\\\\n+++ \\u754c\\u9762/\\u4e2d\\u6587.py\\\\t(\\u5de5\\u4f5c\\u526f\\u672c)\\\\n\\\".encode(\\\"gbk\\\")\\n123:         diff += \\\"@@ -1 +1,3 @@\\\\n-\\u65e7 = 1\\\\n+\\u540d\\u5b57 = '\\u4e2d\\u6587'\\\\n+print('\\u8c03\\u8bd5')\\\\n+++x\\\\n\\\".encode(\\\"utf-8\\\")\\n124:         diff += \\\"+gbk_line = '\\u4e2d'\\\\n\\\".encode(\\\"gb18030\\\")\\n125:         diff += \\\"\\\\nProperty changes on: \\u754c\\u9762/\\u4e2d\\u6587.py\\\\n___\\\\nAdded: svn:eol-style\\\\n## -0,0 +1 ##\\\\n+native\\\\n\\\".encode(\\\"gbk\\\")\\n126:         self.assertEqual(p.diff_added_lines(diff), [\\\"\\u540d\\u5b57 = '\\u4e2d\\u6587'\\\", \\\"print('\\u8c03\\u8bd5')\\\", \\\"++x\\\", \\\"gbk_line = '\\u4e2d'\\\"])\\n127:         self.write(\\\"\\u754c\\u9762/\\u4e2d\\u6587.py\\\", \\\"\\u540d\\u5b57 = '\\u4e2d\\u6587'\\\\n\\\")\\n128:         entries = [{\\\"path\\\": \\\"\\u754c\\u9762/\\u4e2d\\u6587.py\\\", \\\"item\\\": \\\"modified\\\"}]\\n129:         with patch.object(p, \\\"run_svn\\\", return_value=diff):\\n130:             warnings = p.check_leftovers(self.root, entries)\\n131:         self.assertEqual(warnings, [\\\"\\u754c\\u9762/\\u4e2d\\u6587.py\\uff1a\\u65b0\\u589e print\\uff1aprint('\\u8c03\\u8bd5')\\\"])\\n132: \\n133:     def test_leftovers_scan_sources_inside_unversioned_directories(self):\\n134:         self.write(\\\"gameplay/newdir/sub/a.py\\\", \\\"breakpoint()\\\\n\\\")\\n135:         self.write(\\\"gameplay/newdir/b.tmpl\\\", \\\"print('x')\\\\n\\\")\\n136:         self.write(\\\"gameplay/newdir/readme.txt\\\", \\\"print('x')\\\\n\\\")\\n137:         entries = [{\\\"path\\\": \\\"gameplay/newdir\\\", \\\"item\\\": \\\"unversioned\\\"}]\\n138:         files = p.source_files(self.root, entries)\\n139:         self.assertEqual([path.relative_to(self.root).as_posix() for path in files],\\n140:                          [\\\"gameplay/newdir/b.tmpl\\\", \\\"gameplay/newdir/sub/a.py\\\"])\\n141:         warnings = p.check_leftovers(self.root, entries)\\n142:         self.assertEqual(sorted(warnings), [\\\"gameplay/newdir/b.tmpl\\uff1a\\u65b0\\u589e print\\uff1aprint('x')\\\",\\n143:                                             \\\"gameplay/newdir/sub/a.py\\uff1a\\u8c03\\u8bd5\\u65ad\\u70b9\\uff1abreakpoint()\\\"])\\n144: \\n145:     def test_mock_and_tracer_leftovers(self):\\n146:         flagged = {\\n147:             \\\"sys.settrace(tracer)\\\": \\\"\\u8ffd\\u8e2a\\u5668\\u6b8b\\u7559\\\",\\n148:             \\\"threading.setprofile(f)\\\": \\\"\\u8ffd\\u8e2a\\u5668\\u6b8b\\u7559\\\",\\n149:             \\\"[error_watch_start(), exec_check_start(TARGETS, CASES)]\\\": \\\"\\u81ea\\u68c0\\u6a21\\u677f\\u6b8b\\u7559\\\",\\n150:             \\\"from unittest.mock import patch\\\": \\\"Mock \\u6b8b\\u7559\\\",\\n151:             \\\"import mock\\\": \\\"Mock \\u6b8b\\u7559\\\",\\n152:             \\\"with mock.patch('a.b'):\\\": \\\"Mock \\u6b8b\\u7559\\\",\\n153:             \\\"obj = MagicMock()\\\": \\\"Mock \\u6b8b\\u7559\\\",\\n154:             \\\"gameplay.chat.send = lambda *a, **k: None\\\": \\\"\\u7591\\u4f3c monkey patch\\\",\\n155:             \\\"setattr(module, 'send', lambda *a: None)\\\": \\\"\\u7591\\u4f3c monkey patch\\\",\\n156:             \\\"_orig_send = gameplay.chat.send\\\": \\\"\\u7591\\u4f3c Mock \\u4fdd\\u5b58\\u7684\\u539f\\u51fd\\u6570\\\",\\n157:         }\\n158:         normal = [\\\"self.callback = lambda *args: self.close()\\\", \\\"btn.onClick = lambda: self.close()\\\",\\n159:                   \\\"self.settrace_enabled = True\\\", \\\"old_pos = role.pos\\\", \\\"orig_x = self.x\\\", \\\"mocked = 1\\\"]\\n160:         self.write(\\\"gameplay/new.py\\\", \\\"\\\\n\\\".join([*flagged, *normal]) + \\\"\\\\n\\\")\\n161:         warnings = p.check_leftovers(self.root, [{\\\"path\\\": \\\"gameplay/new.py\\\", \\\"item\\\": \\\"unversioned\\\"}])\\n162:         self.assertEqual(len(warnings), len(flagged), warnings)\\n163:         for line, label in flagged.items():\\n164:             self.assertIn(f\\\"gameplay/new.py\\uff1a{label}\\uff1a{line}\\\", warnings)\\n165:         # \\u4e2a\\u4eba\\u76ee\\u5f55\\u4e0b\\u7684\\u7528\\u4f8b\\u811a\\u672c\\u4e0d\\u5728\\u626b\\u63cf\\u8303\\u56f4\\u5185\\u3002\\n166:         self.write(\\\".mhxy-workspace/exec-check/case.py\\\", \\\"sys.settrace(None)\\\\n\\\")\\n167:         self.assertEqual(p.check_leftovers(self.root, [{\\\"path\\\": \\\".mhxy-workspace\\\", \\\"item\\\": \\\"unversioned\\\"}]), [])\\n168: \\n169:     def status(self, path, item, props=\\\"none\\\", changelist=None):\\n170:         return {\\\"path\\\": path, \\\"item\\\": item, \\\"props\\\": props, \\\"tree_conflict\\\": False, \\\"changelist\\\": changelist}\\n171: \\n172:     def test_review_mark_and_changes_since_review(self):\\n173:         self.write(\\\"gameplay/a.py\\\", \\\"a = 1\\\\n\\\")\\n174:         self.write(\\\"gameplay/b.py\\\", \\\"b = 1\\\\n\\\")\\n175:         self.write(\\\"gameplay/newdir/c.py\\\", \\\"c = 1\\\\n\\\")\\n176:         self.write(\\\"data/t.py\\\", \\\"t = 1\\\\n\\\")\\n177:         entries = [self.status(\\\"gameplay/a.py\\\", \\\"modified\\\"), self.status(\\\"gameplay/b.py\\\", \\\"added\\\"),\\n178:                    self.status(\\\"gameplay/newdir\\\", \\\"unversioned\\\"), self.status(\\\"old.py\\\", \\\"deleted\\\"),\\n179:                    self.status(\\\"data/t.py\\\", \\\"modified\\\"), self.status(\\\".mhxy-workspace\\\", \\\"unversioned\\\"),\\n180:                    self.status(\\\"gameplay/local.py\\\", \\\"modified\\\", changelist=\\\"ignore-on-commit\\\"),\\n181:                    self.status(\\\"prot\\\", \\\"external\\\")]\\n182:         self.assertEqual(p.review_delta(self.root, entries), (None, [], []))\\n183:         with patch.object(p, \\\"svn_status\\\", return_value=entries), \\\\\\n184:                 patch.object(p.workspace, \\\"require_initialized\\\") as initialized:\\n185:             marked = p.mark_reviewed(self.root)\\n186:         initialized.assert_called_once_with(self.root)\\n187:         self.assertEqual(marked[\\\"files\\\"], 4)\\n188:         mark = json.loads((self.root / \\\".mhxy-workspace\\\" / p.REVIEW_MARK).read_text(encoding=\\\"utf-8\\\"))\\n189:         self.assertEqual(sorted(mark[\\\"files\\\"]), [\\\"gameplay/a.py\\\", \\\"gameplay/b.py\\\", \\\"gameplay/newdir/c.py\\\", \\\"old.py\\\"])\\n190:         self.assertEqual(p.review_delta(self.root, entries), (marked[\\\"review_mark\\\"], [], []))\\n191:         # \\u6539\\u5185\\u5bb9\\u3001\\u6539\\u72b6\\u6001\\u3001\\u65b0\\u589e\\u6539\\u52a8\\u3001\\u6539\\u52a8\\u6d88\\u5931\\u3001\\u8303\\u56f4\\u5916\\u7684\\u6539\\u52a8\\u4e0d\\u7b97\\u3002\\n192:         self.write(\\\"gameplay/a.py\\\", \\\"a = 2\\\\n\\\")\\n193:         self.write(\\\"data/t.py\\\", \\\"t = 2\\\\n\\\")\\n194:         self.write(\\\"gameplay/newdir/d.py\\\", \\\"d = 1\\\\n\\\")\\n195:         self.write(\\\"gameplay/e.py\\\", \\\"e = 1\\\\n\\\")\\n196:         later = [self.status(\\\"gameplay/a.py\\\", \\\"modified\\\"), self.status(\\\"gameplay/b.py\\\", \\\"modified\\\"),\\n197:                  self.status(\\\"gameplay/newdir\\\", \\\"unversioned\\\"), self.status(\\\"gameplay/e.py\\\", \\\"unversioned\\\"),\\n198:                  self.status(\\\"data/t.py\\\", \\\"modified\\\")]\\n199:         _, changed, warnings = p.review_delta(self.root, later)\\n200:         self.assertEqual(changed, [\\\"gameplay/a.py\\\", \\\"gameplay/b.py\\\", \\\"gameplay/e.py\\\", \\\"gameplay/newdir/d.py\\\",\\n201:                                    \\\"old.py\\\"])\\n202:         self.assertEqual(warnings, [])\\n203:         with patch.object(p, \\\"svn_status\\\", return_value=later), patch.object(p, \\\"run_svn\\\", return_value=b\\\"\\\"), \\\\\\n204:                 patch.object(p.workspace, \\\"svn_branch\\\", return_value=None):\\n205:             result = p.precheck(self.root)\\n206:         self.assertEqual((result[\\\"review_mark\\\"], result[\\\"changed_since_review\\\"]), (marked[\\\"review_mark\\\"], changed))\\n207:         self.assertEqual(result[\\\"blocking\\\"], [])\\n208:         (self.root / \\\".mhxy-workspace\\\" / p.REVIEW_MARK).write_text(\\\"[]\\\")\\n209:         marked_at, changed, warnings = p.review_delta(self.root, later)\\n210:         self.assertEqual((marked_at, changed), (None, []))\\n211:         self.assertIn(\\\"review \\u8bb0\\u5f55\\u65e0\\u6cd5\\u8bfb\\u53d6\\\", warnings[0])\\n212: \\n213:     def test_mark_reviewed_cli_requires_initialized_workspace(self):\\n214:         with patch.object(p, \\\"svn_status\\\", return_value=[]), \\\\\\n215:                 patch.object(sys, \\\"argv\\\", [\\\"precommit.py\\\", \\\"--root\\\", str(self.root), \\\"--mark-reviewed\\\"]), \\\\\\n216:                 contextlib.redirect_stderr(io.StringIO()) as stderr:\\n217:             self.assertEqual(p.main(), 1)\\n218:         self.assertIn(\\\"\\u4e0d\\u662f\\u5df2\\u521d\\u59cb\\u5316\\u7684\\u5de5\\u4f5c\\u533a\\\", json.loads(stderr.getvalue())[\\\"error\\\"])\\n219:         self.assertFalse((self.root / \\\".mhxy-workspace\\\").exists())\\n220: \\n221:     def test_cli_reports_workspace_errors_and_timeouts_as_json(self):\\n222:         for error in (p.workspace.WorkspaceError(\\\"\\u6587\\u6863\\u7f16\\u7801\\u65e0\\u6cd5\\u5904\\u7406\\\"),\\n223:                       subprocess.TimeoutExpired([\\\"python\\\"], 300),\\n224:                       p.SvnTimeout(\\\"svn status \\u8d85\\u8fc7 120 \\u79d2\\u672a\\u7ed3\\u675f\\\")):\\n225:             with self.subTest(error=type(error).__name__):\\n226:                 stderr = io.StringIO()\\n227:                 with patch.object(p, \\\"precheck\\\", side_effect=error), patch.object(sys, \\\"argv\\\", [\\\"precommit.py\\\"]), \\\\\\n228:                         contextlib.redirect_stderr(stderr):\\n229:                     self.assertEqual(p.main(), 1)\\n230:                 self.assertIn(\\\"error\\\", json.loads(stderr.getvalue()))\\n231: \\n232:     def test_svn_timeout_is_distinct_from_unavailable(self):\\n233:         with patch.object(p.subprocess, \\\"run\\\", side_effect=subprocess.TimeoutExpired([\\\"svn\\\"], 5)):\\n234:             with self.assertRaisesRegex(p.SvnTimeout, \\\"\\u8d85\\u8fc7 5 \\u79d2\\u672a\\u7ed3\\u675f\\\"):\\n235:                 p.svn_process(self.root, \\\"status\\\", timeout=5)\\n236:         with patch.object(p.subprocess, \\\"run\\\", side_effect=FileNotFoundError(\\\"svn\\\")):\\n237:             with self.assert