\n208:                                   not Path(value).is_absolute() or any(c in value for c in \\\"\\\\r\\\\n\\\\x00\\\")):\\n209:             raise WorkspaceError(f\\\"{label} \\u7684 {key} \\u5fc5\\u987b\\u662f\\u7edd\\u5bf9\\u8def\\u5f84\\u6216 null\\\")\\n210: \\n211: \\n212: def paths(root_arg, global_arg):\\n213:     root = absolute(root_arg)\\n214:     no_links(root)\\n215:     if not root.is_dir():\\n216:         raise WorkspaceError(f\\\"\\u5de5\\u4f5c\\u533a\\u4e0d\\u5b58\\u5728\\uff1a{root}\\\")\\n217:     root = root.resolve()  # Normalize Windows short names before boundary comparisons.\\n218:     personal = root / DIRECTORY\\n219:     no_links(personal)\\n220:     if exists(personal) and not personal.is_dir():\\n221:         raise WorkspaceError(f\\\"\\u4e2a\\u4eba\\u76ee\\u5f55\\u4e0d\\u662f\\u76ee\\u5f55\\uff1a{personal}\\\")\\n222:     global_config = absolute(global_arg)\\n223:     no_links(global_config)\\n224:     global_config = global_config.resolve()\\n225:     # Never allow the managed directory to contain the home-level configuration,\\n226:     # even when a testing override points elsewhere.\\n227:     for protected in (global_config, absolute(Path.home() / DIRECTORY / \\\"config.json\\\").resolve()):\\n228:         if protected == personal or personal in protected.parents:\\n229:             raise WorkspaceError(\\\"\\u4e2a\\u4eba\\u76ee\\u5f55\\u4e0e\\u7528\\u6237\\u7ea7\\u914d\\u7f6e\\u91cd\\u53e0\\\")\\n230:     return root, personal, global_config\\n231: \\n232: \\n233: def ensure_writable(path):\\n234:     \\\"\\\"\\\"\\u62d2\\u7edd\\u53ea\\u8bfb\\u7684\\u76ee\\u6807\\u6587\\u4ef6\\uff08svn:needs-lock \\u672a\\u52a0\\u9501\\u6216\\u88ab\\u624b\\u52a8\\u8bbe\\u4e3a\\u53ea\\u8bfb\\uff09\\uff0c\\u4e0d\\u81ea\\u884c\\u53bb\\u6389\\u53ea\\u8bfb\\u5c5e\\u6027\\u3002\\\"\\\"\\\"\\n235:     if exists(path) and not path.stat().st_mode & stat.S_IWRITE:\\n236:         raise WorkspaceError(f\\\"\\u76ee\\u6807\\u6587\\u4ef6\\u53ea\\u8bfb\\uff08\\u53ef\\u80fd\\u662f svn:needs-lock \\u672a\\u52a0\\u9501\\u6216\\u88ab\\u624b\\u52a8\\u8bbe\\u4e3a\\u53ea\\u8bfb\\uff09\\uff0c\\\"\\n237:                              f\\\"\\u8bf7\\u5148\\u786e\\u8ba4\\u5e76\\u89e3\\u9664\\u53ea\\u8bfb\\u540e\\u91cd\\u8bd5\\uff1a{path}\\\")\\n238: \\n239: \\n240: def atomic_write(path, data):\\n241:     no_links(path)\\n242:     ensure_writable(path)\\n243:     descriptor, name = tempfile.mkstemp(prefix=\\\".mhxy-write-\\\", dir=path.parent)\\n244:     temporary = Path(name)\\n245:     try:\\n246:         with os.fdopen(descriptor, \\\"wb\\\") as stream:\\n247:             stream.write(data)\\n248:             stream.flush()\\n249:             os.fsync(stream.fileno())\\n250:         if exists(path):\\n251:             # \\u76ee\\u6807\\u5df2\\u786e\\u8ba4\\u53ef\\u5199\\uff0c\\u590d\\u5236\\u6743\\u9650\\u4f4d\\u4e0d\\u4f1a\\u8ba9\\u4e34\\u65f6\\u6587\\u4ef6\\u53d8\\u6210\\u53ea\\u8bfb\\u3002\\n252:             os.chmod(temporary, stat.S_IMODE(path.stat().st_mode))\\n253:         os.replace(temporary, path)\\n254:     except BaseException:\\n255:         # \\u6e05\\u7406\\u5931\\u8d25\\u4e0d\\u80fd\\u63a9\\u76d6\\u539f\\u59cb\\u9519\\u8bef\\uff1b\\u4e34\\u65f6\\u6587\\u4ef6\\u53ef\\u80fd\\u88ab\\u8bbe\\u6210\\u53ea\\u8bfb\\uff0c\\u5148\\u6062\\u590d\\u53ef\\u5199\\u518d\\u5220\\u9664\\u3002\\n256:         try:\\n257:             if exists(temporary):\\n258:                 os.chmod(temporary, stat.S_IREAD | stat.S_IWRITE)\\n259:                 temporary.unlink()\\n260:         except OSError:\\n261:             pass\\n262:         raise\\n263: \\n264: \\n265: def apply_changes(changes):\\n266:     \\\"\\\"\\\"Each change is (path, original bytes or None, desired bytes).\\\"\\\"\\\"\\n267:     completed, created_dirs = [], []\\n268:     try:\\n269:         for path, old, new in changes:\\n270:             if read_bytes(path) != old:\\n271:                 raise WorkspaceError(f\\\"\\u68c0\\u6d4b\\u5230\\u5e76\\u53d1\\u4fee\\u6539\\uff1a{path}\\\")\\n272:             ensure_writable(path)  # \\u5199\\u5165\\u4efb\\u4f55\\u6587\\u4ef6\\u4e4b\\u524d\\u5148\\u53d1\\u73b0\\u53ea\\u8bfb\\u76ee\\u6807\\u3002\\n273:         for path, old, new in changes:\\n274:             missing = []\\n275:             parent = path.parent\\n276:             while not exists(parent):\\n277:                 missing.append(parent)\\n278:                 parent = parent.parent\\n279:             for directory in reversed(missing):\\n280:                 no_links(directory)\\n281:                 directory.mkdir()\\n282:                 created_dirs.append(directory)\\n283:             if read_bytes(path) != old:\\n284:                 raise WorkspaceError(f\\\"\\u68c0\\u6d4b\\u5230\\u5e76\\u53d1\\u4fee\\u6539\\uff1a{path}\\\")\\n285:             atomic_write(path, new)\\n286:             completed.append((path, old, new))\\n287:     except Exception as error:\\n288:         failures = []\\n289:         for path, old, new in reversed(completed):\\n290:             try:\\n291:                 if read_bytes(path) != new:\\n292:                     raise WorkspaceError(\\\"\\u56de\\u6eda\\u524d\\u68c0\\u6d4b\\u5230\\u5e76\\u53d1\\u4fee\\u6539\\\")\\n293:                 if old is None:\\n294:                     path.unlink()\\n295:                 else:\\n296:                     atomic_write(path, old)\\n297:             except Exception as rollback_error:\\n298:                 failures.append(f\\\"{path}: {rollback_error}\\\")\\n299:         for directory in reversed(created_dirs):\\n300:             try:\\n301:                 directory.rmdir()\\n302:             except OSError:\\n303:                 pass\\n304:         detail = \\\"; \\u56de\\u6eda\\u5931\\u8d25\\uff1a\\\" + \\\"; \\\".join(failures) if failures else \\\"; \\u672c\\u8f6e\\u6587\\u4ef6\\u53d8\\u66f4\\u5df2\\u6062\\u590d\\\"\\n305:         raise WorkspaceError(f\\\"\\u66f4\\u65b0\\u5931\\u8d25\\uff1a{error}{detail}\\\") from error\\n306: \\n307: \\n308: def apply_settings(values, assignments, option):\\n309:     result = dict(values)\\n310:     for assignment in assignments:\\n311:         key, separator, value = assignment.partition(\\\"=\\\")\\n312:         if not separator:\\n313:             raise WorkspaceError(f\\\"{option} \\u5e94\\u4e3a \\u952e=\\u503c \\u6216 \\u952e=null\\\")\\n314:         if key == \\\"openid_password\\\" and value != \\\"null\\\":\\n315:             raise WorkspaceError(\\\"\\u5bc6\\u7801\\u901a\\u8fc7 config --prompt-password \\u9690\\u85cf\\u8f93\\u5165\\uff0c\\u4e0d\\u653e\\u5728\\u547d\\u4ee4\\u884c\\u53c2\\u6570\\u4e2d\\\")\\n316:         if key == \\\"openid_username\\\" and result.get(key) != (None if value == \\\"null\\\" else value):\\n317:             result.pop(\\\"openid_password\\\", None)  # An old password must not follow an account change.\\n318:         result[key] = None if value == \\\"null\\\" else value\\n319:     return result\\n320: \\n321: \\n322: def effective_values(global_values, local):\\n323:     \\\"\\\"\\\"Merge non-secret overrides and derive the coder without duplicating state.\\\"\\\"\\\"\\n324:     if set(local) & {\\\"openid_username\\\", \\\"openid_password\\\"}:\\n325:         raise WorkspaceError(\\\"OpenID \\u8d26\\u5bc6\\u4ec5\\u5141\\u8bb8\\u5b58\\u653e\\u5728\\u7528\\u6237\\u7ea7\\u914d\\u7f6e\\\")\\n326:     values = {**global_values, **local}\\n327:     if not values.get(\\\"coder_name\\\") and values.get(\\\"openid_username\\\"):\\n328:         values[\\\"coder_name\\\"] = values[\\\"openid_username\\\"].split(\\\"@\\\", 1)[0]\\n329:     return values\\n330: \\n331: \\n332: def masked_config(values):\\n333:     \\\"\\\"\\\"Return a display-only configuration; never disclose the saved password.\\\"\\\"\\\"\\n334:     return {key: (\\\"***\\\" if value is not None else None) if key == \\\"openid_password\\\" else value\\n335:             for key, value in values.items()}\\n336: \\n337: \\n338: def load_config(root_arg, global_arg):\\n339:     \\\"\\\"\\\"Read effective settings without creating workspace files; internal use only.\\\"\\\"\\\"\\n340:     root, personal, global_path = paths(root_arg, global_arg)\\n341:     defaults = parse_json((SKILL / \\\"config/defaults.json\\\").read_bytes(), \\\"\\u914d\\u7f6e\\u6a21\\u677f\\\")\\n342:     values = []\\n343:     for path in (global_path, personal / \\\"config.json\\\"):\\n344:         data = read_bytes(path)\\n345:         value = parse_json(data, path) if data is not None else {}\\n346:         validate_config(value, defaults, path)\\n347:         values.append(value)\\n348:     return effective_values({**defaults, **values[0]}, values[1])\\n349: \\n350: \\n351: def configure_global(global_arg, assignments=(), password=None, apply=False):\\n352:     \\\"\\\"\\\"Update only the user configuration, preserving unrelated settings.\\\"\\\"\\\"\\n353:     path = absolute(global_arg)\\n354:     old = read_bytes(path)\\n355:     values = parse_json(old, path) if old is not None else {}\\n356:     values = apply_settings(values, assignments, \\\"--set-global\\\")\\n357:     if password is not None:\\n358:         values[\\\"openid_password\\\"] = password\\n359:     defaults = parse_json((SKILL / \\\"config/defaults.json\\\").read_bytes(), \\\"\\u914d\\u7f6e\\u6a21\\u677f\\\")\\n360:     validate_config(values, defaults, path)\\n361:     new = json_bytes(values)\\n362:     changes = [(path, old, new)] if old != new else []\\n363:     if apply:\\n364:         apply_changes(changes)\\n365:     return {\\\"action\\\": \\\"config\\\", \\\"applied\\\": apply, \\\"changes\\\": [str(item[0]) for item in changes],\\n366:             \\\"effective_config\\\": masked_config(effective_values({**defaults, **values}, {}))}\\n367: \\n368: \\n369: def sync(root_arg, global_arg, assignments=(), apply=False, skill=SKILL, local_assignments=()):\\n370:     root, personal, global_config = paths(root_arg, global_arg)\\n371:     metadata = parse_json((skill / \\\"config/version.json\\\").read_bytes(), \\\"\\u53d1\\u5e03\\u7248\\u672c\\\")\\n372:     validate_metadata(metadata)\\n373:     if metadata[\\\"schema_version\\\"] != 2:\\n374:         raise WorkspaceError(\\\"\\u5f53\\u524d\\u6a21\\u677f\\u8981\\u6c42\\u7ed3\\u6784\\u7248\\u672c 2\\\")\\n375:     defaults = parse_json((skill / \\\"config/defaults.json\\\").read_bytes(), \\\"\\u914d\\u7f6e\\u6a21\\u677f\\\")\\n376:     changes, warnings = [], []\\n377: \\n378:     def propose(path, old, new):\\n379:         if old != new:\\n380:             changes.append((path, old, new))\\n381: \\n382:     original_global = read_bytes(global_config)\\n383:     global_values = parse_json(original_global, global_config) if original_global is not None else {}\\n384:     global_values = apply_settings(global_values, assignments, \\\"--set-global\\\")\\n385:     validate_config(global_values, defaults, global_config)\\n386:     local_path = personal / \\\"config.json\\\"\\n387:     original_local = read_bytes(local_path)\\n388:     local = parse_json(original_local, local_path) if original_local is not None else {}\\n389:     local = apply_settings(local, local_assignments, \\\"--set-local\\\")\\n390:     validate_config(local, defaults, local_path)\\n391:     missing = sorted(set(PATH_KEYS) - set(global_values))\\n392:     effective = effective_values({**defaults, **global_values}, local)\\n393:     for key, value in effective.items():\\n394:         if key in PATH_KEYS and value is not None and not Path(value).is_dir():\\n395:             warnings.append(f\\\"{key} \\u76ee\\u5f55\\u5f53\\u524d\\u4e0d\\u53ef\\u7528\\uff0c\\u4fdd\\u7559\\u539f\\u503c\\uff1a{value}\\\")\\n396:     if original_global is None or assignments:\\n397:         if original_global is None or parse_json(original_global, global_config) != global_values:\\n398:             propose(global_config, original_global, json_bytes(global_values))\\n399:     if original_local is None or (local_assignments and parse_json(original_local, local_path) != local):\\n400:         propose(local_path, original_local, json_bytes(local))\\n401: \\n402:     # AGENTS.md \\u627f\\u8f7d\\u5b8c\\u6574\\u89c4\\u5219\\uff08Codex \\u8bfb\\u53d6\\uff09\\uff1bCLAUDE.md \\u53ea\\u653e\\u5143\\u6570\\u636e\\u548c @AGENTS.md \\u5bfc\\u5165\\n403:     # \\uff08Claude Code \\u8bfb\\u53d6\\uff09\\uff0c\\u89c4\\u5219\\u4fdd\\u6301\\u552f\\u4e00\\u6765\\u6e90\\u3002CLAUDE.md \\u533a\\u6bb5\\u5b8c\\u5168\\u7531 AGENTS.md \\u6d3e\\u751f\\uff0c\\n404:     # \\u56e0\\u6b64\\u4e0d\\u518d\\u8981\\u6c42\\u4e24\\u8005\\u5143\\u6570\\u636e\\u4e00\\u81f4\\uff0c\\u53ea\\u4fdd\\u7559\\u62d2\\u7edd\\u964d\\u7ea7\\uff1b\\u65e7\\u7248\\u5199\\u5165\\u7684\\u5b8c\\u6574\\u533a\\u6bb5\\u5728\\u6b64\\u88ab\\u66ff\\u6362\\u3002\\n405:     documents = []\\n406:     for filename, template_name in zip(ENTRY_FILES, (\\\"managed-block.md\\\", \\\"claude-block.md\\\")):\\n407:         path = root / filename\\n408:         old = read_bytes(path)\\n409:         text, encoding, bom, newline = decode_document(old)\\n410:         info = block_info(text)\\n411:         if info and release(info[2][\\\"applied_version\\\"]) > release(metadata[\\\"applied_version\\\"]):\\n412:             raise WorkspaceError(f\\\"\\u62d2\\u7edd\\u964d\\u7ea7\\uff1a{path}\\\")\\n413:         if old is not None and encoding != \\\"utf-8\\\":\\n414:             warnings.append(f\\\"{filename} \\u7684\\u7f16\\u7801\\u662f {encoding.upper()}\\uff0cCodex \\u548c Claude Code \\u6309 UTF-8 \\u8bfb\\u53d6\\uff0c\\\"\\n415:                             \\\"\\u53ef\\u80fd\\u8bfb\\u4e0d\\u5230\\u6216\\u8bfb\\u9519\\u89c4\\u5219\\uff1bsync \\u4fdd\\u7559\\u539f\\u7f16\\u7801\\uff0c\\u5efa\\u8bae\\u7528\\u6237\\u81ea\\u884c\\u8f6c\\u6362\\u4e3a UTF-8\\\")\\n416:         documents.append((path, old, text, encoding, bom, newline, info, template_name))\\n417: \\n418:     variables = {\\n419:         \\\"metadata\\\": json.dumps(metadata, ensure_ascii=False, indent=2),\\n420:         \\\"references_dir\\\": (skill.resolve() / \\\"references\\\").as_posix(),\\n421:         \\\"workspace_script\\\": (skill.resolve() / \\\"scripts/workspace.py\\\").as_posix(),\\n422:     }\\n423:     entry_changed = False\\n424:     for path, old, text, encoding, bom, newline, info, template_name in documents:\\n425:         template = (skill / \\\"assets\\\" / template_name).read_text(encoding=\\\"utf-8\\\").rstrip(\\\"\\\\n\\\")\\n426:         block = re.sub(r\\\"\\\\{\\\\{(\\\\w+)\\\\}\\\\}\\\", lambda match: variables[match[1]], template)\\n427:         rendered = block.replace(\\\"\\\\n\\\", newline)\\n428:         if path.name == ENTRY_FILES[0]:\\n429:             entry_changed = not info or rule_body(text[info[0]:info[1]]) != rule_body(rendered)\\n430:         if info:\\n431:             new_text = text[:info[0]] + rendered + text[info[1]:]\\n432:         else:\\n433:             separator = \\\"\\\" if not text else (newline if text.endswith(\\\"\\\\n\\\") else newline * 2)\\n434:             new_text = text + separator + rendered + newline\\n435:         propose(path, old, bom + new_text.encode(encoding))\\n436:     for change in plan_index(root, personal)[0]:\\n437:         propose(*change)\\n438:     hook = claude_hook_change(root, skill.resolve() / \\\"scripts/workspace.py\\\")\\n439:     if hook:\\n440:         propose(*hook)\\n441:     if apply and missing:\\n442:         raise WorkspaceError(f\\\"\\u7528\\u6237\\u7ea7\\u914d\\u7f6e\\u7f3a\\u5c11\\u5df2\\u786e\\u8ba4\\u5b57\\u6bb5\\uff1a{', '.join(missing)}\\uff1b\\u672a\\u4f7f\\u7528\\u9879\\u53ef\\u663e\\u5f0f\\u8bbe\\u7f6e null\\\")\\n443:     changelist = []\\n444:     if apply:\\n445:         apply_changes(changes)\\n446:         # \\u6587\\u4ef6\\u5199\\u5165\\u540e\\u518d\\u5224\\u65ad\\uff1a\\u9996\\u6b21\\u521b\\u5efa\\u7684\\u5165\\u53e3\\u6587\\u4ef6\\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\uff0c\\u4e0d\\u9700\\u8981\\u5904\\u7406\\u3002\\n447:         changelist, changelist_warnings = plan_ignore_on_commit(root)\\n448:         changelist_warnings += apply_ignore_on_commit(root, changelist)\\n449:     else:\\n450:         changelist, changelist_warnings = plan_ignore_on_commit(root)\\n451:     warnings += changelist_warnings\\n452:     # \\u5f53\\u524d\\u4f1a\\u8bdd\\u91cc\\u5df2\\u52a0\\u8f7d\\u7684\\u662f\\u65e7\\u5165\\u53e3\\u89c4\\u5219\\uff1b\\u660e\\u786e\\u63d0\\u793a\\uff0c\\u907f\\u514d agent \\u51ed\\u5370\\u8c61\\u8ba4\\u4e3a\\u89c4\\u5219\\u6ca1\\u53d8\\u3002\\n453:     # \\u53ea\\u6bd4\\u8f83\\u53bb\\u6389\\u7ba1\\u7406\\u5143\\u6570\\u636e\\u540e\\u7684\\u89c4\\u5219\\u5185\\u5bb9\\uff0c\\u5355\\u7eaf\\u7684\\u7248\\u672c\\u53f7\\u53d8\\u5316\\u4e0d\\u63d0\\u793a\\u3002\\n454:     notice = (\\\"\\u5165\\u53e3\\u89c4\\u5219\\uff08AGENTS.md \\u53d7\\u7ba1\\u533a\\u6bb5\\uff09\\u6709\\u53d8\\u5316\\uff1a\\\" + (\\\"\\u5e94\\u7528\\u540e\\\" if not apply else \\\"\\\")\\n455:               + \\\"\\u8bf7\\u91cd\\u65b0\\u8bfb\\u53d6\\u8be5\\u533a\\u6bb5\\uff0c\\u5e76\\u5411\\u7528\\u6237\\u8bf4\\u660e\\u65b0\\u589e\\u6216\\u53d8\\u5316\\u7684\\u89c4\\u5219\\uff1b\\u5f53\\u524d\\u4f1a\\u8bdd\\u5df2\\u52a0\\u8f7d\\u7684\\u662f\\u65e7\\u7248\\u672c\\u3002\\\") if entry_changed else \\\"\\\"\\n456:     return {\\\"action\\\": \\\"sync\\\", \\\"applied\\\": apply, \\\"root\\\": str(root),\\n457:             \\\"changes\\\": [str(item[0]) for item in changes], \\\"missing_fields\\\": missing,\\n458:             \\\"entry_rules_changed\\\": entry_changed, \\\"notice\\\": notice,\\n459:             \\\"ignore_on_commit\\\": changelist,\\n460:             \\\"optional_fields_to_confirm\\\": sorted({\\\"openid_username\\\", \\\"openid_password\\\"} - set(global_values)) if original_global is None else [],\\n461:             \\\"effective_config\\\": masked_config(effective), \\\"warnings\\\": warnings}\\n462: \\n463: \\n464: def spec_summary(path):\\n465:     \\\"\\\"\\\"\\u63d0\\u53d6\\u4e00\\u7bc7 spec \\u7684\\u6807\\u9898\\uff08\\u9996\\u4e2a\\u6807\\u9898\\u884c\\uff09\\u548c\\u6458\\u8981\\uff08\\u9996\\u4e2a\\u6b63\\u6587\\u884c\\uff09\\u3002\\n466: \\n467:     \\u8df3\\u8fc7\\u5f00\\u5934\\u7684 YAML front matter\\u3001\\u4ee3\\u7801\\u5757\\u3001\\u8868\\u683c\\u3001\\u5206\\u9694\\u7ebf\\u548c HTML \\u6ce8\\u91ca\\uff1b\\u53bb\\u6389\\u5217\\u8868\\u7b26\\u53f7\\u548c\\n468:     \\u7c97\\u4f53\\uff0f\\u884c\\u5185\\u4ee3\\u7801\\u6807\\u8bb0\\u3002\\u65e0\\u6cd5\\u6309 UTF-8\\uff0fUTF-16\\uff0fGB18030 \\u89e3\\u7801\\u65f6\\u4ee5\\u6587\\u4ef6\\u540d\\u4e3a\\u6807\\u9898\\u3002\\n469:     \\\"\\\"\\\"\\n470:     try:\\n471:         text = decode_document(path.read_bytes())[0]\\n472:     except (WorkspaceError, OSError):\\n473:         return path.stem, \\\"\\uff08\\u65e0\\u6cd5\\u8bc6\\u522b\\u7f16\\u7801\\uff09\\\"\\n474:     lines = text.splitlines()\\n475:     if lines and lines[0].strip() == \\\"---\\\":  # front matter\\n476:         closing = next((i for i, line in enumerate(lines[1:], 1) if line.strip() == \\\"---\\\"), None)\\n477:         lines = lines[closing + 1:] if closing else lines\\n478:     title, summary, fenced = None, \\\"\\\", False\\n479:     for raw in lines:\\n480:         line = raw.strip()\\n481:         if line.startswith((\\\"```\\\", \\\"~~~\\\")):\\n482:             fenced = not fenced\\n483:             continue\\n484:         if fenced or not line or line.startswith((\\\"|\\\", \\\"<!--\\\", \\\"---\\\", \\\"***\\\", \\\"===\\\")) or \\\"-*- coding\\\" in line:\\n485:             continue\\n486:         heading = re.fullmatch(r\\\"#{1,6}\\\\s+(.*?)\\\\s*#*\\\", line)\\n487:         if heading:\\n488:             title = title or heading[1]\\n489:             continue\\n490:         summary = re.sub(r\\\"^(?:[-*+>]\\\\s+|\\\\d+[.)]\\\\s+)\\\", \\\"\\\", line).replace(\\\"**\\\", \\\"\\\").replace(\\\"`\\\", \\\"\\\").strip()\\n491:         if summary:\\n492:             break\\n493:     if len(summary) > INDEX_SUMMARY_LIMIT:\\n494:         summary = summary[:INDEX_SUMMARY_LIMIT] + \\\"\\u2026\\\"\\n495:     return title or path.stem, summary\\n496: \\n497: \\n498: def spec_relative(root, value):\\n499:     \\\"\\\"\\\"\\u628a\\u7528\\u6237\\u3001hook \\u6216 svn \\u7ed9\\u51fa\\u7684\\u8def\\u5f84\\u89c4\\u8303\\u4e3a `spec/...md`\\uff1b\\u4e0d\\u662f spec/ \\u4e0b\\u7684 Markdown \\u65f6\\u8fd4\\u56de None\\u3002\\n500: \\n501:     Windows \\u4e0b\\u6309\\u4e0d\\u533a\\u5206\\u5927\\u5c0f\\u5199\\u6bd4\\u8f83\\u6839\\u76ee\\u5f55\\uff0c\\u8df3\\u8fc7\\u9690\\u85cf\\u8def\\u5f84\\u6bb5\\u3002\\n502:     \\\"\\\"\\\"\\n503:     path = Path(os.path.realpath(root / Path(value)))  # \\u4e5f\\u8fd8\\u539f Windows \\u4e0a\\u7684\\u5b9e\\u9645\\u5927\\u5c0f\\u5199\\n504:     try:\\n505:         rel = Path(os.path.relpath(path, root))\\n506:     except ValueError:  # \\u4e0d\\u540c\\u76d8\\u7b26\\n507:         return None\\n508:     parts = rel.parts\\n509:     if (len(parts) < 2 or parts[0].lower() != SPEC_DIRECTORY\\n510:             or not rel.name.lower().endswith(\\\".md\\\") or any(part.startswith(\\\".\\\") for part in parts[1:])):\\n511:         return None\\n512:     return \\\"/\\\".join((SPEC_DIRECTORY, *parts[1:]))\\n513: \\n514: \\n515: def spec_files(path):\\n516:     \\\"\\\"\\\"\\u8fd4\\u56de path\\uff08\\u6587\\u4ef6\\u6216\\u76ee\\u5f55\\uff09\\u4e0b\\u7684 Markdown \\u6587\\u4ef6\\uff1b\\u4e0d\\u8ddf\\u968f\\u94fe\\u63a5\\uff0c\\u8df3\\u8fc7\\u9690\\u85cf\\u9879\\uff0c\\u4e0d\\u5b58\\u5728\\u65f6\\u4e3a\\u7a7a\\u3002\\\"\\\"\\\"\\n517:     if not exists(path) or is_link(path):\\n518:         return []\\n519:     if path.is_file():\\n520:         return [path]\\n521:     found = []\\n522:     for directory, dirnames, filenames in os.walk(path):\\n523:         base = Path(directory)\\n524:         dirnames[:] = [d for d in dirnames if not d.startswith(\\\".\\\") and not is_link(base / d)]\\n525:         found += [base / name for name in filenames\\n526:                   if not name.startswith(\\\".\\\") and name.lower().endswith(\\\".md\\\") and not is_link(base / name)]\\n527:     return found\\n528: \\n529: \\n530: def decode_output(data):\\n531:     \\\"\\\"\\\"\\u89e3\\u7801 svn \\u7684\\u975e XML \\u8f93\\u51fa\\uff1a\\u5148\\u6309 UTF-8 \\u4e25\\u683c\\u89e3\\u7801\\uff0c\\u5931\\u8d25\\u518d\\u6309\\u7cfb\\u7edf\\u533a\\u57df\\u7f16\\u7801\\uff08\\u4e2d\\u6587 Windows \\u4e3a GBK\\uff09\\u3002\\n532: \\n533:     UTF-8 \\u5b57\\u8282\\u6070\\u597d\\u4e5f\\u662f\\u5408\\u6cd5 GBK \\u7684\\u60c5\\u51b5\\u5f88\\u5e38\\u89c1\\uff0c\\u53cd\\u4e4b\\u5f88\\u5c11\\uff0c\\u56e0\\u6b64\\u5148\\u8bd5 UTF-8\\u3002\\n534:     \\\"\\\"\\\"\\n535:     try:\\n536:         return data.decode(\\\"utf-8\\\")\\n537:     except UnicodeDecodeError:\\n538:         return data.decode(locale.getpreferredencoding(False) or \\\"utf-8\\\", \\\"replace\\\")\\n539: \\n540: \\n541: def svn_merge_pending(root, tree):\\n542:     \\\"\\\"\\\"\\u5224\\u65ad\\u5de5\\u4f5c\\u526f\\u672c\\u662f\\u5426\\u6709\\u672a\\u63d0\\u4ea4\\u7684 svn:mergeinfo \\u53d8\\u66f4\\uff08svn merge \\u4e4b\\u540e\\u3001\\u63d0\\u4ea4\\u4e4b\\u524d\\uff09\\u3002\\n543: \\n544:     \\u68c0\\u67e5\\u9879\\u76ee\\u6839\\u76ee\\u5f55\\uff0c\\u4ee5\\u53ca spec \\u72b6\\u6001\\u4e2d\\u5c5e\\u6027\\u6709\\u6539\\u52a8\\u7684\\u6761\\u76ee\\uff1b\\u53ea\\u8bfb\\u3002\\u67e5\\u8be2\\u5931\\u8d25\\u65f6\\u89c6\\u4e3a\\u6ca1\\u6709\\u3002\\n545:     \\\"\\\"\\\"\\n546:     targets = [\\\".\\\"]\\n547:     for entry in tree.iter(\\\"entry\\\"):\\n548:         status = entry.find(\\\"wc-status\\\")\\n549:         if entry.get(\\\"path\\\") and status is not None and status.get(\\\"props\\\") == \\\"modified\\\":\\n550:             targets.append(entry.get(\\\"path\\\"))\\n551:     try:\\n552:         completed = subprocess.run([\\\"svn\\\", \\\"diff\\\", \\\"--properties-only\\\", \\\"--depth\\\", \\\"empty\\\", \\\"--non-interactive\\\",\\n553:                                     *targets], cwd=root, capture_output=True, timeout=20)\\n554:     except (OSError, subprocess.SubprocessError):\\n555:         return False\\n556:     return not completed.returncode and b\\\"svn:mergeinfo\\\" in completed.stdout\\n557: \\n558: \\n559: def svn_local_changes(root):\\n560:     \\\"\\\"\\\"\\u8fd4\\u56de (\\u72b6\\u6001, spec/ \\u4e0b\\u672c\\u5730\\u6709\\u6539\\u52a8\\u7684 Markdown \\u76f8\\u5bf9\\u8def\\u5f84\\u96c6\\u5408)\\u3002\\n561: \\n562:     \\u672c\\u5730\\u6709\\u6539\\u52a8\\u6307\\u4fee\\u6539\\u3001\\u65b0\\u589e\\u3001\\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\u7b49\\uff1b\\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\u7684\\u76ee\\u5f55\\u5c55\\u5f00\\u4e3a\\u5176\\u4e2d\\u7684\\u6587\\u4ef6\\u3002\\n563:     \\u72b6\\u6001\\u4e3a `ok`\\uff1bsvn \\u4e0d\\u53ef\\u7528\\u3001\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\u6216\\u8d85\\u65f6\\u65f6\\u4e3a `unavailable`\\uff1b\\u6709\\u672a\\u63d0\\u4ea4\\u7684\\u5408\\u5e76\\n564:     \\uff08svn:mergeinfo \\u6709\\u6539\\u52a8\\uff09\\u65f6\\u4e3a `merge_pending`\\uff0c\\u6b64\\u65f6\\u5408\\u5e76\\u8fdb\\u6765\\u7684\\u4ed6\\u4eba spec \\u4e5f\\u663e\\u793a\\u4e3a\\u672c\\u5730\\n565:     \\u6539\\u52a8\\uff0c\\u65e0\\u6cd5\\u533a\\u5206\\uff0c\\u96c6\\u5408\\u4e3a\\u7a7a\\u3002\\u540e\\u4e24\\u79cd\\u60c5\\u51b5\\u8c03\\u7528\\u65b9\\u8df3\\u8fc7\\u8fd9\\u4e00\\u6536\\u5f55\\u6765\\u6e90\\uff0c\\u4e0d\\u89c6\\u4e3a\\u9519\\u8bef\\u3002\\u53ea\\u8bfb\\u3002\\n566:     \\\"\\\"\\\"\\n567:     if not (root / SPEC_DIRECTORY).is_dir():\\n568:         return \\\"ok\\\", set()\\n569:     try:\\n570:         completed = subprocess.run([\\\"svn\\\", \\\"status\\\", \\\"--xml\\\", \\\"--non-interactive\\\", SPEC_DIRECTORY],\\n571:                                    cwd=root, capture_output=True, timeout=20)\\n572:         if completed.returncode or b\\\"155007\\\" in completed.stderr:  # \\u975e\\u5de5\\u4f5c\\u526f\\u672c\\u65f6\\u53ea\\u6709\\u8b66\\u544a\\u3001\\u9000\\u51fa\\u7801\\u4e3a 0\\n573:             return \\\"unavailable\\\", set()\\n574:         tree = ElementTree.fromstring(completed.stdout)\\n575:     except (OSError, subprocess.SubprocessError, ElementTree.ParseError):\\n576:         return \\\"unavailable\\\", set()\\n577:     if svn_merge_pending(root, tree):\\n578:         return \\\"merge_pending\\\", set()\\n579:     changed = set()\\n580:     for entry in tree.iter(\\\"entry\\\"):\\n581:         status = entry.find(\\\"wc-status\\\")\\n582:         if not entry.get(\\\"path\\\") or status is None or status.get(\\\"item\\\") not in SVN_LOCAL_CHANGES:\\n583:             continue\\n584:         for path in spec_files(root / entry.get(\\\"path\\\")):\\n585:             rel = spec_relative(root, path)\\n586:             if rel:\\n587:                 changed.add(rel)\\n588:     return \\\"ok\\\", changed\\n589: \\n590: \\n591: def classify_branch(url):\\n592:     \\\"\\\"\\\"\\u6309\\u4ed3\\u5e93 URL \\u5224\\u65ad\\u5206\\u652f\\u7c7b\\u578b\\uff1a`trunk`\\u3001`\\u5468\\u671f\\u5206\\u652f` \\u6216 `\\u7814\\u53d1\\u5206\\u652f`\\u3002\\\"\\\"\\\"\\n593:     if PERIODIC_BRANCH.search(url):\\n594:         return \\\"\\u5468\\u671f\\u5206\\u652f\\\"\\n595:     if re.search(r\\\"/wzimage/trunk/?$\\\", url):\\n596:         return \\\"trunk\\\"\\n597:     return \\\"\\u7814\\u53d1\\u5206\\u652f\\\"\\n598: \\n599: \\n600: def branch_path(url):\\n601:     \\\"\\\"\\\"\\u8fd4\\u56de\\u4ed3\\u5e93\\u76f8\\u5bf9\\u8def\\u5f84\\uff08URL \\u4e2d `wzimage/` \\u4e4b\\u540e\\u7684\\u90e8\\u5206\\uff0c\\u5982 `branchs/2026_dev/x`\\u3001`trunk`\\uff09\\u3002\\n602: \\n603:     \\u8986\\u76d6\\u7387\\u7f51\\u7ad9\\u548c coverage-task \\u767b\\u8bb0\\u90fd\\u7528\\u8fd9\\u4e2a\\u683c\\u5f0f\\uff1b\\u65e0\\u6cd5\\u8bc6\\u522b\\u65f6\\u8fd4\\u56de None\\u3002\\n604:     \\\"\\\"\\\"\\n605:     match = re.search(r\\\"/wzimage/(.+?)/?$\\\", url)\\n606:     # svn info \\u8fd4\\u56de\\u7684 URL \\u662f URI \\u7f16\\u7801\\u7684\\uff0c\\u7f51\\u7ad9\\u548c\\u65e5\\u5fd7\\u91cc\\u7684\\u8def\\u5f84\\u662f\\u89e3\\u7801\\u540e\\u7684\\n607:     return unquote(match.group(1)) if match else None\\n608: \\n609: \\n610: def svn_branch(root):\\n611:     \\\"\\\"\\\"\\u53ea\\u8bfb\\u8bfb\\u53d6\\u5de5\\u4f5c\\u526f\\u672c\\u7684\\u4ed3\\u5e93 URL \\u5e76\\u5206\\u7c7b\\uff1bsvn \\u4e0d\\u53ef\\u7528\\u6216\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\u65f6\\u8fd4\\u56de None\\u3002\\n612: \\n613:     \\u6bcf\\u6b21\\u73b0\\u573a\\u8bfb\\u53d6\\u3001\\u4e0d\\u843d\\u76d8\\uff0c\\u56e0\\u6b64\\u4e0d\\u53d7\\u4e2a\\u4eba\\u76ee\\u5f55\\u6e05\\u7406\\u5f71\\u54cd\\u3002`path` \\u89c1 branch_path\\u3002\\n614:     \\\"\\\"\\\"\\n615:     try:\\n616:         completed = subprocess.run([\\\"svn\\\", \\\"info\\\", \\\"--show-item\\\", \\\"url\\\", \\\"--non-interactive\\\", \\\".\\\"],\\n617:                                    cwd=root, capture_output=True, timeout=20)\\n618:     except (OSError, subprocess.SubprocessError):\\n619:         return None\\n620:     url = decode_output(completed.stdout).strip()\\n621:     if completed.returncode or not url:\\n622:         return None\\n623:     return {\\\"url\\\": url, \\\"name\\\": unquote(url.rstrip(\\\"/\\\").rsplit(\\\"/\\\", 1)[-1]), \\\"path\\\": branch_path(url),\\n624:             \\\"kind\\\": classify_branch(url)}\\n625: \\n626: \\n627: def svn_changelist(root, name):\\n628:     \\\"\\\"\\\"\\u53ea\\u8bfb\\u67e5\\u8be2\\u6587\\u4ef6\\u6240\\u5728\\u7684 SVN \\u53d8\\u66f4\\u5217\\u8868\\u3002\\n629: \\n630:     Returns:\\n631:         \\u53d8\\u66f4\\u5217\\u8868\\u540d\\uff1b\\u4e0d\\u5728\\u4efb\\u4f55\\u5217\\u8868\\u4e2d\\u65f6\\u4e3a\\u7a7a\\u5b57\\u7b26\\u4e32\\uff1b\\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\uff08\\u542b\\u76ee\\u5f55\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\uff09\\u65f6\\u4e3a None\\u3002\\n632: \\n633:     Raises:\\n634:         WorkspaceError: svn \\u4e0d\\u53ef\\u7528\\u6216\\u5176\\u4ed6\\u67e5\\u8be2\\u5931\\u8d25\\u3002\\n635:     \\\"\\\"\\\"\\n636:     try:\\n637:         completed = subprocess.run([\\\"svn\\\", \\\"info\\\", \\\"--show-item\\\", \\\"changelist\\\", \\\"--non-interactive\\\", name],\\n638:                                    cwd=root, capture_output=True, timeout=20)\\n639:     except (OSError, subprocess.SubprocessError) as error:\\n640:         raise WorkspaceError(f\\\"svn \\u4e0d\\u53ef\\u7528\\uff1a{error}\\\") from None\\n641:     if completed.returncode:\\n642:         if b\\\"W155010\\\" in completed.stderr or b\\\"E155007\\\" in completed.stderr:  # \\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\uff0f\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\n643:             return None\\n644:         raise WorkspaceError(decode_output(completed.stderr).strip() or \\\"svn info \\u5931\\u8d25\\\")\\n645:     return decode_output(completed.stdout).strip()\\n646: \\n647: \\n648: def plan_ignore_on_commit(root):\\n649:     \\\"\\\"\\\"\\u627e\\u51fa\\u9700\\u8981\\u653e\\u5165 ignore-on-commit \\u53d8\\u66f4\\u5217\\u8868\\u7684\\u5165\\u53e3\\u6587\\u4ef6\\uff0c\\u5e76\\u7ed9\\u51fa\\u65e0\\u6cd5\\u5904\\u7406\\u7684\\u539f\\u56e0\\u3002\\n650: \\n651:     \\u53ea\\u5904\\u7406\\u53d7\\u7248\\u672c\\u63a7\\u5236\\u7684 ENTRY_FILES\\uff1a\\u5df2\\u5728\\u8be5\\u5217\\u8868\\u4e2d\\u7684\\u8df3\\u8fc7\\uff1b\\u5728\\u7528\\u6237\\u81ea\\u5df1\\u7684\\u5176\\u4ed6\\u53d8\\u66f4\\u5217\\u8868\\u4e2d\\u7684\\n652:     \\u4e0d\\u79fb\\u52a8\\uff0c\\u53ea\\u7ed9\\u51fa\\u8b66\\u544a\\u3002svn \\u4e0d\\u53ef\\u7528\\u65f6\\u6574\\u4f53\\u8df3\\u8fc7\\u5e76\\u7ed9\\u51fa\\u8b66\\u544a\\u3002\\n653: \\n654:     Returns:\\n655:         (\\u5f85\\u52a0\\u5165\\u7684\\u6587\\u4ef6\\u540d\\u5217\\u8868, \\u8b66\\u544a\\u5217\\u8868)\\u3002\\n656:     \\\"\\\"\\\"\\n657:     pending, warnings = [], []\\n658:     for name in ENTRY_FILES:\\n659:         if not exists(root / name):\\n660:             continue\\n661:         try:\\n662:             current = svn_changelist(root, name)\\n663:         except WorkspaceError as error:\\n664:             return [], [f\\\"\\u672a\\u80fd\\u628a\\u5165\\u53e3\\u6587\\u4ef6\\u52a0\\u5165 {IGNORE_ON_COMMIT}\\uff1a{error}\\\"]\\n665:         if current == \\\"\\\":\\n666:             pending.append(name)\\n667:         elif current not in (None, IGNORE_ON_COMMIT):\\n668:             warnings.append(f\\\"{name} \\u5df2\\u5728\\u53d8\\u66f4\\u5217\\u8868 {current} \\u4e2d\\uff0c\\u672a\\u79fb\\u5165 {IGNORE_ON_COMMIT}\\\")\\n669:     return pending, warnings\\n670: \\n671: \\n672: def apply_ignore_on_commit(root, names):\\n673:     \\\"\\\"\\\"\\u628a\\u6587\\u4ef6\\u52a0\\u5165 ignore-on-commit \\u53d8\\u66f4\\u5217\\u8868\\uff08\\u53ea\\u6539\\u672c\\u5730\\u5de5\\u4f5c\\u526f\\u672c\\u5143\\u6570\\u636e\\uff0c\\u4e0d\\u5f71\\u54cd\\u670d\\u52a1\\u5668\\uff09\\u3002\\n674: \\n675:     Returns:\\n676:         \\u8b66\\u544a\\u5217\\u8868\\uff1b\\u5931\\u8d25\\u4e0d\\u629b\\u51fa\\uff0c\\u56e0\\u4e3a\\u914d\\u7f6e\\u6587\\u4ef6\\u6b64\\u65f6\\u5df2\\u7ecf\\u5199\\u5165\\u3002\\n677:     \\\"\\\"\\\"\\n678:     if not names:\\n679:         return []\\n680:     try:\\n681:         completed = subprocess.run([\\\"svn\\\", \\\"changelist\\\", IGNORE_ON_COMMIT, \\\"--non-interactive\\\", *names],\\n682:                                    cwd=root, capture_output=True, timeout=20)\\n683:     except (OSError, subprocess.SubprocessError) as error:\\n684:         return [f\\\"\\u672a\\u80fd\\u628a {', '.join(names)} \\u52a0\\u5165 {IGNORE_ON_COMMIT}\\uff1a{error}\\\"]\\n685:     if completed.returncode:\\n686:         detail = decode_output(completed.stderr).strip()\\n687:         return [f\\\"\\u672a\\u80fd\\u628a {', '.join(names)} \\u52a0\\u5165 {IGNORE_ON_COMMIT}\\uff1a{detail}\\\"]\\n688:     return []\\n689: \\n690: \\n691: def read_index_state(personal):\\n692:     \\\"\\\"\\\"\\u8bfb\\u53d6\\u7d22\\u5f15\\u6536\\u5f55\\u72b6\\u6001\\uff1b\\u7f3a\\u5931\\u65f6\\u4ee5\\u5f53\\u524d\\u65f6\\u95f4\\u4e3a\\u8d77\\u70b9\\u65b0\\u5efa\\uff0c\\u540d\\u5355\\u4e3a\\u7a7a\\u3002\\n693: \\n694:     \\u4ece 0.2.x \\u5347\\u7ea7\\u65f6\\uff0c\\u65e7\\u7248\\u624b\\u5199\\u7d22\\u5f15\\u91cc\\u767b\\u8bb0\\u8fc7\\u7684 spec \\u8def\\u5f84\\u4f1a\\u8fc1\\u5165\\u540d\\u5355\\uff0c\\u907f\\u514d\\u4e22\\u5931\\u3002\\n695: \\n696:     Returns:\\n697:         (\\u72b6\\u6001\\u6587\\u4ef6\\u8def\\u5f84, \\u539f\\u59cb\\u5b57\\u8282\\u6216 None, \\u72b6\\u6001)\\u3002\\u72b6\\u6001\\u542b since\\uff08\\u5e26\\u65f6\\u533a\\u7684 ISO \\u65f6\\u95f4\\uff09\\u3001\\n698:         specs\\uff08\\u6536\\u5f55\\u540d\\u5355\\uff09\\u548c excluded\\uff08\\u7528\\u6237\\u79fb\\u51fa\\u3001\\u4e0d\\u518d\\u81ea\\u52a8\\u6536\\u5f55\\u7684\\u540d\\u5355\\uff09\\uff0c\\u8def\\u5f84\\u90fd\\u76f8\\u5bf9\\u9879\\u76ee\\u6839\\u3002\\n699:         0.3.18 \\u53ca\\u4e4b\\u524d\\u5199\\u5165\\u7684\\u72b6\\u6001\\u6ca1\\u6709 excluded\\uff0c\\u6309\\u7a7a\\u540d\\u5355\\u8bfb\\u53d6\\u3002\\n700: \\n701:     Raises:\\n702:         WorkspaceError: \\u72b6\\u6001\\u6587\\u4ef6\\u635f\\u574f\\u3002\\n703:     \\\"\\\"\\\"\\n704:     path = personal / INDEX_STATE\\n705:     old = read_bytes(path)\\n706:     if old is not None:\\n707:         state = parse_json(old, path)\\n708:         state.setdefault(\\\"excluded\\\", [])\\n709:         if (set(state) != {\\\"since\\\", \\\"specs\\\", \\\"excluded\\\"}\\n710:                 or not all(isinstance(state[key], list) and all(isinstance(item, str) for item in state[key])\\n711:                            for key in (\\\"specs\\\", \\\"excluded\\\"))):\\n712:             raise WorkspaceError(f\\\"\\u7d22\\u5f15\\u72b6\\u6001\\u7ed3\\u6784\\u65e0\\u6548\\uff1a{path}\\\")\\n713:         try:\\n714:             datetime.fromisoformat(state[\\\"since\\\"]).timestamp()\\n715:         except (TypeError, ValueError):\\n716:             raise WorkspaceError(f\\\"\\u7d22\\u5f15\\u72b6\\u6001\\u8d77\\u70b9\\u65f6\\u95f4\\u65e0\\u6548\\uff1a{path}\\\") from None\\n717:         return path, old, state\\n718:     specs = []\\n719:     legacy = read_bytes(personal / INDEX_FILE)\\n720:     if legacy is not None:\\n721:         text = decode_document(legacy)[0]\\n722:         if not text.startswith(INDEX_HEADER):\\n723:             specs = re.findall(r\\\"^\\\\s*-\\\\s*(spec/.+?\\\\.md)\\\\s*[\\uff1a:]\\\", text, re.M)\\n724:     return path, None, {\\\"since\\\": datetime.now().astimezone().isoformat(timespec=\\\"seconds\\\"),\\n725:                         \\\"specs\\\": specs, \\\"excluded\\\": []}\\n726: \\n727: \\n728: def render_index(since, entries):\\n729:     \\\"\\\"\\\"\\u628a\\u6536\\u5f55\\u6761\\u76ee\\u6e32\\u67d3\\u4e3a\\u7d22\\u5f15 Markdown\\uff1b\\u540c\\u6837\\u7684\\u540d\\u5355\\u548c spec \\u5185\\u5bb9\\u603b\\u662f\\u5f97\\u5230\\u76f8\\u540c\\u5b57\\u8282\\u3002\\\"\\\"\\\"\\n730:     lines = [INDEX_HEADER + \\\"\\u6536\\u5f55\\u540d\\u5355\\u89c1 index-state.json\\uff1b\\u624b\\u5de5\\u4fee\\u6539\\u672c\\u6587\\u4ef6\\u4f1a\\u88ab\\u8986\\u76d6\\u3002 -->\\\",\\n731:              f\\\"\\u6536\\u5f55 {since} \\u4e4b\\u540e\\u65b0\\u5efa\\u6216\\u4fee\\u6539\\u7684 spec\\uff0c\\u5171 {len(entries)} \\u7bc7\\u3002\\u6309\\u7ec4\\u540d\\uff08spec/ \\u4e00\\u7ea7\\u5b50\\u76ee\\u5f55\\uff09\\u3001\\u6807\\u9898\\u6216\\u6458\\u8981\\u641c\\u7d22\\u5b9a\\u4f4d\\u3002\\\", \\\"\\\"]\\n732:     for group, items in itertools.groupby(entries, key=lambda entry: entry[0]):\\n733:         items = list(items)\\n734:         lines.append(f\\\"# {group or 'spec \\u6839\\u76ee\\u5f55'}\\uff08{len(items)}\\uff09\\\")\\n735:         lines.extend(f\\\"- {path}\\uff1a{title}\\\" + (f\\\" \\u2014 {summary}\\\" if summary else \\\"\\\") for _, path, title, summary in items)\\n736:         lines.append(\\\"\\\")\\n737:     return \\\"\\\\n\\\".join(lines).encode(\\\"utf-8\\\")\\n738: \\n739: \\n740: def mtime(path):\\n741:     \\\"\\\"\\\"\\u8fd4\\u56de\\u6587\\u4ef6\\u4fee\\u6539\\u65f6\\u95f4\\uff1b\\u6587\\u4ef6\\u5df2\\u4e0d\\u5b58\\u5728\\uff08\\u4f8b\\u5982\\u521a\\u88ab\\u5220\\u9664\\u6216\\u6539\\u540d\\uff09\\u65f6\\u8fd4\\u56de None\\u3002\\\"\\\"\\\"\\n742:     try:\\n743:         return path.stat().st_mtime\\n744:     except FileNotFoundError:\\n745:         return None\\n746: \\n747: \\n748: def plan_index(root, personal, add=(), remove=(), scan=True, written=()):\\n749:     \\\"\\\"\\\"\\u8ba1\\u7b97\\u65b0\\u7684\\u6536\\u5f55\\u540d\\u5355\\u4e0e\\u7d22\\u5f15\\u5185\\u5bb9\\uff0c\\u53ea\\u8fd4\\u56de\\u53d8\\u66f4\\uff0c\\u4e0d\\u5199\\u5165\\u3002\\n750: \\n751:     \\u540d\\u5355\\u53ea\\u589e\\u4e0d\\u51cf\\u3002\\u65b0\\u589e\\u6765\\u6e90\\uff1a\\n752:     - add\\uff1a\\u7528\\u6237\\u624b\\u52a8\\u6536\\u5f55\\uff0c\\u4e0d\\u53d7\\u8d77\\u70b9\\u9650\\u5236\\uff0c\\u540c\\u65f6\\u4ece\\u6392\\u9664\\u540d\\u5355\\u4e2d\\u53bb\\u6389\\uff1b\\n753:     - written\\uff1ahook \\u62a5\\u544a\\u521a\\u5199\\u5165\\u7684 spec\\uff0c\\u4e0d\\u53d7\\u8d77\\u70b9\\u9650\\u5236\\uff1b\\n754:     - scan \\u65f6\\u201c\\u8d77\\u70b9\\u4e4b\\u540e\\u4fee\\u6539\\u3001\\u4e14 svn \\u663e\\u793a\\u672c\\u5730\\u6709\\u6539\\u52a8\\u201d\\u7684 spec\\u3002svn update \\u62c9\\u4e0b\\u7684\\u4ed6\\u4eba spec\\n755:       \\u5728\\u672c\\u5730\\u65e0\\u6539\\u52a8\\uff0c\\u56e0\\u6b64\\u4e0d\\u4f1a\\u88ab\\u6536\\u5f55\\uff1b\\u6709\\u672a\\u63d0\\u4ea4\\u7684\\u5408\\u5e76\\u65f6\\u8df3\\u8fc7\\u8fd9\\u4e00\\u6765\\u6e90\\uff08\\u89c1 svn_local_changes\\uff09\\u3002\\n756:     remove \\u4e2d\\u7684\\u6761\\u76ee\\u79fb\\u51fa\\u540d\\u5355\\u5e76\\u8bb0\\u5165\\u6392\\u9664\\u540d\\u5355\\uff0cwritten \\u548c scan \\u4e0d\\u4f1a\\u518d\\u6536\\u5f55\\u5b83\\u4eec\\u3002\\u6587\\u4ef6\\u5df2\\u4e0d\\u5b58\\u5728\\u7684\\n757:     \\u6761\\u76ee\\u4ece\\u4e24\\u4e2a\\u540d\\u5355\\u4e2d\\u79fb\\u51fa\\u3002\\n758: \\n759:     Returns:\\n760:         (changes, stats, entries)\\u3002changes \\u53ef\\u4ea4\\u7ed9 apply_changes\\uff1bentries \\u4e3a\\u6309\\u7ec4\\u6392\\u5e8f\\u7684\\n761:         [(\\u7ec4\\u540d, \\u8def\\u5f84, \\u6807\\u9898, \\u6458\\u8981)]\\u3002\\n762:     \\\"\\\"\\\"\\n763:     state_path, old_state, state = read_index_state(personal)\\n764:     since = datetime.fromisoformat(state[\\\"since\\\"]).timestamp()\\n765:     excluded = (set(state[\\\"excluded\\\"]) | set(remove)) - set(add)\\n766:     members = set(state[\\\"specs\\\"]) | set(add) | (set(written) - excluded)\\n767:     svn = \\\"skipped\\\"\\n768:     if scan:\\n769:         svn, changed = svn_local_changes(root)\\n770:         members |= {rel for rel in changed - excluded if (mtime(root / rel) or 0) > since}\\n771: \\n772:     def present(rel):\\n773:         return (root / rel).is_file() and not is_link(root / rel)\\n774:     members = sorted(rel for rel in members - excluded if present(rel))\\n775:     excluded = sorted(rel for rel in excluded if present(rel))\\n776:     entries = sorted((Path(rel).parts[1] if len(Path(rel).parts) > 2 else \\\"\\\", rel, *spec_summary(root / rel))\\n777:                      for rel in members)\\n778:     index_path = personal / INDEX_FILE\\n779:     new_state = {\\\"since\\\": state[\\\"since\\\"], \\\"specs\\\": members, \\\"excluded\\\": excluded}\\n780:     candidates = ((state_path, old_state, json_bytes(new_state)),\\n781:                   (index_path, read_bytes(index_path), render_index(state[\\\"since\\\"], entries)))\\n782:     changes = [change for change in candidates if change[1] != change[2]]\\n783:     stats = {\\\"path\\\": f\\\"{DIRECTORY}/{INDEX_FILE}\\\", \\\"specs\\\": len(members), \\\"since\\\": state[\\\"since\\\"], \\\"svn\\\": svn}\\n784:     return changes, stats, entries\\n785: \\n786: \\n787: def refresh_index(root, personal, add=(), remove=(), scan=True, written=()):\\n788:     \\\"\\\"\\\"\\u6309 plan_index \\u66f4\\u65b0\\u6536\\u5f55\\u540d\\u5355\\u548c\\u7d22\\u5f15\\uff0c\\u65e0\\u53d8\\u5316\\u4e0d\\u5199\\u5165\\uff1b\\u8fd4\\u56de (\\u7edf\\u8ba1\\u4fe1\\u606f, entries)\\u3002\\\"\\\"\\\"\\n789:     changes, stats, entries = plan_index(root, personal, add, remove, scan, written)\\n790:     apply_changes(changes)\\n791:     return {**stats, \\\"updated\\\": bool(changes)}, entries\\n792: \\n793: \\n794: def require_initialized(root):\\n795:     \\\"\\\"\\\"\\u53ea\\u6709 sync \\u80fd\\u521d\\u59cb\\u5316\\u5de5\\u4f5c\\u533a\\uff1b\\u5176\\u4ed6\\u4f1a\\u5199\\u4e2a\\u4eba\\u76ee\\u5f55\\u7684\\u547d\\u4ee4\\u8981\\u6c42\\u6839\\u76ee\\u5f55 AGENTS.md \\u5df2\\u6709\\u53d7\\u7ba1\\u533a\\u6bb5\\u3002\\n796: \\n797:     \\u9632\\u6b62\\u4ece\\u5b50\\u76ee\\u5f55\\u4f20 `--root \\\".\\\"` \\u65f6\\u5728\\u9519\\u8bef\\u7684\\u4f4d\\u7f6e\\u65b0\\u5efa `.mhxy-workspace/`\\u3002\\n798: \\n799:     Raises:\\n800:         WorkspaceError: AGENTS.md \\u4e0d\\u5b58\\u5728\\u3001\\u65e0\\u6cd5\\u89e3\\u7801\\u6216\\u6ca1\\u6709\\u53d7\\u7ba1\\u533a\\u6bb5\\u3002\\n801:     \\\"\\\"\\\"\\n802:     if block_info(decode_document(read_bytes(root / ENTRY_FILES[0]))[0]) is None:\\n803:         raise WorkspaceError(f\\\"{root} \\u4e0d\\u662f\\u5df2\\u521d\\u59cb\\u5316\\u7684\\u5de5\\u4f5c\\u533a\\uff08AGENTS.md \\u4e2d\\u6ca1\\u6709 {NAME} \\u53d7\\u7ba1\\u533a\\u6bb5\\uff09\\uff1b\\\"\\n804:                              \\\"\\u8bf7\\u628a --root \\u6307\\u5411\\u9879\\u76ee\\u6839\\u76ee\\u5f55\\uff0c\\u6216\\u5148\\u6309 SKILL.md \\u521d\\u59cb\\u5316\\\")\\n805: \\n806: \\n807: def query_index(root_arg, global_arg, terms=(), add=(), remove=(), limit=50):\\n808:     \\\"\\\"\\\"\\u5237\\u65b0\\u7d22\\u5f15\\uff0c\\u53ef\\u540c\\u65f6\\u624b\\u52a8\\u6536\\u5f55\\u6216\\u79fb\\u51fa spec\\uff0c\\u518d\\u6309\\u5173\\u952e\\u8bcd\\uff08\\u5168\\u90e8\\u547d\\u4e2d\\u3001\\u4e0d\\u533a\\u5206\\u5927\\u5c0f\\u5199\\uff09\\u5339\\u914d\\u3002\\n809: \\n810:     Raises:\\n811:         WorkspaceError: \\u5de5\\u4f5c\\u533a\\u672a\\u521d\\u59cb\\u5316\\uff1badd\\uff0fremove \\u7684\\u8def\\u5f84\\u4e0d\\u662f spec/ \\u4e0b\\u7684 Markdown\\uff0c\\n812:             \\u6216\\u8981\\u6536\\u5f55\\u7684\\u6587\\u4ef6\\u4e0d\\u5b58\\u5728\\u3002\\n813:     \\\"\\\"\\\"\\n814:     root, personal, _ = paths(root_arg, global_arg)\\n815:     require_initialized(root)\\n816:     normalized = {}\\n817:     for label, values in ((\\\"add\\\", add), (\\\"remove\\\", remove)):\\n818:         normalized[label] = []\\n819:         for value in values:\\n820:             rel = spec_relative(root, value)\\n821:             if rel is None or (label == \\\"add\\\" and not (root / rel).is_file()):\\n822:                 raise WorkspaceError(f\\\"\\u4e0d\\u662f\\u5df2\\u5b58\\u5728\\u7684 spec/ \\u4e0b Markdown \\u6587\\u4ef6\\uff1a{value}\\\")\\n823:             normalized[label].append(rel)\\n824:     stats, entries = refresh_index(root, personal, normalized[\\\"add\\\"], normalized[\\\"remove\\\"])\\n825:     needles = [term.lower() for term in terms if term.strip()]\\n826:     matches = [f\\\"{path}\\uff1a{title}\\\" + (f\\\" \\u2014 {summary}\\\" if summary else \\\"\\\")\\n827:                for group, path, title, summary in entries\\n828:                if all(n in f\\\"{group} {path} {title} {summary}\\\".lower() for n in needles)]\\n829:     return {\\\"index\\\": stats, \\\"matches\\\": matches[:limit], \\\"truncated\\\": len(matches) > limit}\\n830: \\n831: \\n832: def record_hook_write(root_arg, global_arg, payload):\\n833:     \\\"\\\"\\\"Claude Code PostToolUse hook\\uff1a\\u5de5\\u5177\\u521a\\u5199\\u5165 spec/ \\u4e0b\\u7684 Markdown \\u65f6\\u6536\\u5f55\\u8be5\\u6587\\u4ef6\\u3002\\n834: \\n835:     \\u5176\\u4ed6\\u6587\\u4ef6\\u76f4\\u63a5\\u5ffd\\u7565\\uff1b\\u7528\\u6237\\u79fb\\u51fa\\u8fc7\\u7684 spec \\u4e0d\\u518d\\u6536\\u5f55\\u3002\\u53ea\\u66f4\\u65b0\\u540d\\u5355\\u548c\\u7d22\\u5f15\\uff0c\\u4e0d\\u8fd0\\u884c svn\\u3002\\n836:     \\\"\\\"\\\"\\n837:     tool_input = payload.get(\\\"tool_input\\\") if isinstance(payload, dict) else None\\n838:     file_path = tool_input.get(\\\"file_path\\\") if isinstance(tool_input, dict) else None\\n839:     if not isinstance(file_path, str):\\n840:         return\\n841:     root, personal, _ = paths(root_arg, global_arg)\\n842:     rel = spec_relative(root, file_path)\\n843:     if rel and (root / rel).is_file():\\n844:         require_initialized(root)\\n845:         refresh_index(root, personal, scan=False, written=[rel])\\n846: \\n847: \\n848: def context(root_arg, global_arg):\\n849:     \\\"\\\"\\\"\\u4f1a\\u8bdd\\u5f00\\u59cb\\u65f6\\u4e00\\u6b21\\u6027\\u52a0\\u8f7d\\uff1a\\u5f53\\u524d\\u5206\\u652f\\u3001\\u8131\\u654f\\u914d\\u7f6e\\u3001\\u8ffd\\u8e2a\\u5de5\\u5355\\u3001\\u8986\\u76d6\\u7387\\u8eab\\u4efd\\u548c\\u6700\\u8fd1\\u7684 spec\\u3002\\n850: \\n851:     \\u5404\\u90e8\\u5206\\u72ec\\u7acb\\u8bfb\\u53d6\\uff0c\\u67d0\\u90e8\\u5206\\u5931\\u8d25\\u53ea\\u8bb0\\u5165 problems\\uff0c\\u4e0d\\u5f71\\u54cd\\u5176\\u4f59\\u90e8\\u5206\\u3002\\u4e0d\\u521b\\u5efa\\u914d\\u7f6e\\u6216\\u8ffd\\u8e2a\\u6587\\u4ef6\\uff1b\\n852:     \\u7d22\\u5f15\\u72b6\\u6001\\u7f3a\\u5931\\uff08\\u9996\\u6b21\\u6216\\u6e05\\u7406\\u540e\\uff09\\u65f6\\u4ee5\\u5f53\\u524d\\u65f6\\u95f4\\u4e3a\\u8d77\\u70b9\\u65b0\\u5efa\\u7a7a\\u540d\\u5355\\u3002branch \\u4e3a None \\u8868\\u793a\\n853:     svn \\u4e0d\\u53ef\\u7528\\u6216\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\u3002\\n854: \\n855:     Raises:\\n856:         WorkspaceError: \\u5de5\\u4f5c\\u533a\\u672a\\u521d\\u59cb\\u5316\\uff08\\u89c1 require_initialized\\uff09\\uff0c\\u6b64\\u65f6\\u4e0d\\u5199\\u5165\\u4efb\\u4f55\\u6587\\u4ef6\\u3002\\n857:     \\\"\\\"\\\"\\n858:     root, personal, _ = paths(root_arg, global_arg)\\n859:     require_initialized(root)\\n860:     result, problems = {\\\"root\\\": str(root), \\\"branch\\\": svn_branch(root)}, []\\n861:     try:\\n862:         result[\\\"effective_config\\\"] = masked_config(load_config(root_arg, global_arg))\\n863:     except (WorkspaceError, OSError) as error:\\n864:         problems.append(f\\\"\\u914d\\u7f6e\\uff1a{error}\\\")\\n865:     try:\\n866:         tracking = read_tracking(personal)[2]\\n867:         result[\\\"tracked_tasks\\\"] = tracking[\\\"tracked_tasks\\\"]\\n868:         result[\\\"coverage_tasks\\\"] = tracking[\\\"coverage_tasks\\\"]\\n869:     except (WorkspaceError, OSError) as error:\\n870:         problems.append(f\\\"\\u8ffd\\u8e2a\\uff1a{error}\\\")\\n871:     try:\\n872:         stats, entries = refresh_index(root, personal)\\n873:         recent = sorted(entries, key=lambda entry: mtime(root / entry[1]) or 0, reverse=True)\\n874:         stats[\\\"recent\\\"] = [f\\\"{path}\\uff1a{title}\\\" for _, path, title, _ in recent[:INDEX_RECENT_LIMIT]]\\n875:         result[\\\"index\\\"] = stats\\n876:     except (WorkspaceError, OSError) as error:\\n877:         problems.append(f\\\"\\u7d22\\u5f15\\uff1a{error}\\\")\\n878:     result[\\\"problems\\\"] = problems\\n879:     return result\\n880: \\n881: \\n882: def claude_hook_change(root, script):\\n883:     \\\"\\\"\\\"\\u751f\\u6210\\u5728\\u5de5\\u4f5c\\u533a .claude/settings.local.json \\u4e2d\\u767b\\u8bb0\\u672c skill hooks \\u7684\\u53d8\\u66f4\\u3002\\n884: \\n885:     - SessionStart\\uff1a\\u4f1a\\u8bdd\\u5f00\\u59cb\\u3001\\u6062\\u590d\\u3001\\u6e05\\u7a7a\\u548c\\u4e0a\\u4e0b\\u6587\\u538b\\u7f29\\u540e\\u8fd0\\u884c `context`\\uff0c\\u628a\\u7ed3\\u679c\\u6ce8\\u5165\\u4e0a\\u4e0b\\u6587\\u3002\\n886:     - PostToolUse\\uff08Write/Edit/MultiEdit\\uff09\\uff1a\\u5199\\u5165 spec/ \\u4e0b\\u7684 Markdown \\u540e\\u7acb\\u5373\\u6536\\u5f55\\u8fdb\\u7d22\\u5f15\\u3002\\n887: \\n888:     \\u53ea\\u589e\\u6539\\u547d\\u4ee4\\u4e2d\\u5e26 HOOK_FLAG \\u7684\\u672c skill \\u6761\\u76ee\\uff0c\\u4fdd\\u7559\\u5176\\u4ed6\\u8bbe\\u7f6e\\uff1b\\u5df2\\u662f\\u6700\\u65b0\\u65f6\\u8fd4\\u56de None\\u3002\\n889:     \\\"\\\"\\\"\\n890:     path = root / \\\".claude\\\" / \\\"settings.local.json\\\"\\n891:     old = read_bytes(path)\\n892:     settings = parse_json(old, path) if old is not None else {}\\n893:     hooks = settings.get(\\\"hooks\\\", {})\\n894:     if not isinstance(hooks, dict):\\n895:         raise WorkspaceError(f\\\"\\u65e0\\u6cd5\\u8bc6\\u522b\\u7684 hooks \\u7ed3\\u6784\\uff1a{path}\\\")\\n896:     prefix = f'python \\\"{script.as_posix()}\\\"'\\n897:     root_arg = f'--root \\\"{root.as_posix()}\\\" {HOOK_FLAG}'\\n898:     desired = {\\n899:         \\\"SessionStart\\\": {\\\"hooks\\\": [{\\\"type\\\": \\\"command\\\", \\\"command\\\": f\\\"{prefix} context {root_arg}\\\", \\\"timeout\\\": 30}]},\\n900:         \\\"PostToolUse\\\": {\\\"matcher\\\": \\\"Write|Edit|MultiEdit\\\",\\n901:                         \\\"hooks\\\": [{\\\"type\\\": \\\"command\\\", \\\"command\\\": f\\\"{prefix} index {root_arg}\\\", \\\"timeout\\\": 30}]},\\n902:     }\\n903: \\n904:     def is_ours(hook):\\n905:         command = str(hook.get(\\\"command\\\", \\\"\\\")) if isinstance(hook, dict) else \\\"\\\"\\n906:         return HOOK_FLAG in command and \\\"workspace.py\\\" in command\\n907: \\n908:     new_hooks = dict(hooks)\\n909:     for event, ours in desired.items():\\n910:         entries = hooks.get(event, [])\\n911:         if not isinstance(entries, list):\\n912:             raise WorkspaceError(f\\\"\\u65e0\\u6cd5\\u8bc6\\u522b\\u7684 hooks \\u7ed3\\u6784\\uff1a{path}\\\")\\n913:         # \\u53ea\\u79fb\\u9664\\u672c skill \\u7684\\u547d\\u4ee4\\u5bf9\\u8c61\\uff1b\\u7528\\u6237\\u7684\\u547d\\u4ee4\\u4e0e\\u4e4b\\u540c\\u5728\\u4e00\\u4e2a\\u6761\\u76ee\\u65f6\\u4fdd\\u7559\\u8be5\\u6761\\u76ee\\u548c\\u7528\\u6237\\u547d\\u4ee4\\u3002\\n914:         # \\u65b0\\u6761\\u76ee\\u653e\\u5728\\u7b2c\\u4e00\\u6b21\\u51fa\\u73b0\\u672c skill \\u547d\\u4ee4\\u7684\\u4f4d\\u7f6e\\uff0c\\u6ca1\\u6709\\u51fa\\u73b0\\u8fc7\\u65f6\\u8ffd\\u52a0\\u5230\\u672b\\u5c3e\\u3002\\n915:         updated, position = [], None\\n916:         for entry in entries:\\n917:             commands = entry.get(\\\"hooks\\\") if isinstance(entry, dict) else None\\n918:             kept = [hook for hook in commands if not is_ours(hook)] if isinstance(commands, list) else None\\n919:             if kept is None or len(kept) == len(commands):\\n920:                 updated.append(entry)\\n921:                 continue\\n922:             if position is None:\\n923:                 position = len(updated)\\n924:             if kept:\\n925:                 updated.append({**entry, \\\"hooks\\\": kept})\\n926:         updated.insert(len(updated) if position is None else position, ours)\\n927:         new_hooks[event] = updated\\n928:     if new_hooks == hooks:\\n929:         return None\\n930:     return path, old, json_bytes({**settings, \\\"hooks\\\": new_hooks})\\n931: \\n932: \\n933: def validate_coverage(task):\\n934:     \\\"\\\"\\\"\\u6821\\u9a8c\\u5df2\\u7ecf\\u6838\\u5b9e\\u5b58\\u5728\\u7684\\u8fdc\\u7aef\\u8986\\u76d6\\u7387\\u8eab\\u4efd\\uff0c\\u4e0d\\u4ee3\\u8868\\u672c\\u8f6e\\u901a\\u8fc7\\u3002\\\"\\\"\\\"\\n935:     if set(task) != {\\\"task_name\\\", \\\"branch\\\", \\\"redmine_id\\\", \\\"coder_name\\\", \\\"created\\\"} or task[\\\"created\\\"] is not True:\\n936:         raise WorkspaceError(\\\"\\u8986\\u76d6\\u7387\\u4efb\\u52a1\\u5b57\\u6bb5\\u65e0\\u6548\\\")\\n937:     for key in (\\\"task_name\\\", \\\"branch\\\", \\\"redmine_id\\\", \\\"coder_name\\\"):\\n938:         if not isinstance(task[key], str) or not task[key] or any(c in task[key] for c in \\\"\\\\r\\\\n\\\\x00`\\\"):\\n939:             raise WorkspaceError(f\\\"\\u8986\\u76d6\\u7387\\u4efb\\u52a1\\u5b57\\u6bb5\\u65e0\\u6548\\uff1a{key}\\\")\\n940:     validate_issue_id(task[\\\"redmine_id\\\"])\\n941: \\n942: \\n943: def validate_issue_id(issue_id):\\n944:     \\\"\\\"\\\"\\u5de5\\u5355\\u53f7\\u540c\\u65f6\\u7528\\u4f5c\\u76ee\\u5f55\\u540d\\uff0c\\u53ea\\u63a5\\u53d7\\u6b63\\u6574\\u6570\\u5b57\\u7b26\\u4e32\\u3002\\\"\\\"\\\"\\n945:     if not isinstance(issue_id, str) or not re.fullmatch(r\\\"[1-9][0-9]*\\\", issue_id):\\n946:         raise WorkspaceError(\\\"\\u5de5\\u5355\\u53f7\\u5fc5\\u987b\\u4e3a\\u6b63\\u6574\\u6570\\\")\\n947: \\n948: \\n949: def issue_entry(issue_id, title):\\n950:     \\\"\\\"\\\"\\u751f\\u6210\\u4e0d\\u542b\\u6b63\\u6587\\u7684\\u5de5\\u5355\\u5b9a\\u4f4d\\u4fe1\\u606f\\uff0c\\u8def\\u5f84\\u59cb\\u7ec8\\u76f8\\u5bf9\\u4e8e\\u9879\\u76ee\\u6839\\u76ee\\u5f55\\u3002\\\"\\\"\\\"\\n951:     validate_issue_id(issue_id)\\n952:     if not isinstance(title, str) or not title.strip() or any(c in title for c in \\\"\\\\r\\\\n\\\\x00\\\"):\\n953:         raise WorkspaceError(\\\"\\u5de5\\u5355\\u6807\\u9898\\u5fc5\\u987b\\u4e3a\\u975e\\u7a7a\\u5355\\u884c\\u6587\\u672c\\\")\\n954:     return {\\\"issue_id\\\": issue_id, \\\"title\\\": title,\\n955:             \\\"description_path\\\": f\\\"{DIRECTORY}/tasks/{issue_id}/issue.md\\\"}\\n956: \\n957: \\n958: def read_tracking(personal):\\n959:     \\\"\\\"\\\"\\u8bfb\\u53d6\\u672c\\u5730\\u8ffd\\u8e2a\\u72b6\\u6001\\uff1b\\u7f3a\\u5931\\u8868\\u793a\\u7a7a\\u72b6\\u6001\\uff0c\\u4e0d\\u9690\\u5f0f\\u521b\\u5efa\\u6587\\u4ef6\\u3002\\\"\\\"\\\"\\n960:     path = personal / \\\"tracking.json\\\"\\n961:     old = read_bytes(path)\\n962:     value = parse_json(old, path) if old is not None else {\\\"tracked_tasks\\\": [], \\\"coverage_tasks\\\": []}\\n963:     if set(value) != {\\\"tracked_tasks\\\", \\\"coverage_tasks\\\"} or any(\\n964:             not isinstance(value[key], list) for key in value):\\n965:         raise WorkspaceError(\\\"tracking.json \\u7ed3\\u6784\\u65e0\\u6548\\\")\\n966:     seen = set()\\n967:     for task in value[\\\"tracked_tasks\\\"]:\\n968:         if not isinstance(task, dict) or task != issue_entry(task.get(\\\"issue_id\\\"), task.get(\\\"title\\\")):\\n969:             raise WorkspaceError(\\\"\\u8ffd\\u8e2a\\u5de5\\u5355\\u5b57\\u6bb5\\u65e0\\u6548\\\")\\n970:         if task[\\\"issue_id\\\"] in seen:\\n971:             raise WorkspaceError(\\\"\\u8ffd\\u8e2a\\u5de5\\u5355\\u91cd\\u590d\\\")\\n972:         seen.add(task[\\\"issue_id\\\"])\\n973:     identities = set()\\n974:     for task in value[\\\"coverage_tasks\\\"]:\\n975:         if not isinstance(task, dict):\\n976:             raise WorkspaceError(\\\"\\u8986\\u76d6\\u7387\\u4efb\\u52a1\\u5b57\\u6bb5\\u65e0\\u6548\\\")\\n977:         validate_coverage(task)\\n978:         identity = (task[\\\"redmine_id\\\"], task[\\\"branch\\\"])\\n979:         if identity in identities:\\n980:             raise WorkspaceError(\\\"\\u540c\\u5de5\\u5355\\u540c\\u5206\\u652f\\u7684\\u8986\\u76d6\\u7387\\u8eab\\u4efd\\u91cd\\u590d\\\")\\n981:         identities.add(identity)\\n982:     return path, old, value\\n983: \\n984: \\n985: def save_tracking(path, old, value, action, apply):\\n986:     \\\"\\\"\\\"\\u65e0\\u5dee\\u5f02\\u4e0d\\u5199\\u5165\\uff1b\\u6cbf\\u7528\\u6587\\u4ef6\\u5e76\\u53d1\\u68c0\\u67e5\\u548c\\u5931\\u8d25\\u6062\\u590d\\u3002\\\"\\\"\\\"\\n987:     new = json_bytes(value)\\n988:     changes = [(path, old, new)] if old != new else []\\n989:     if apply:\\n990:         apply_changes(changes)\\n991:     return {\\\"action\\\": action, \\\"applied\\\": apply, \\\"tracking\\\": value,\\n992:             \\\"changes\\\": [str(item[0]) for item in changes]}\\n993: \\n994: \\n995: def track_tasks(root_arg, global_arg, issue_ids, replace=False, remove=False, apply=False):\\n996:     \\\"\\\"\\\"\\u4ece\\u811a\\u672c\\u67e5\\u8be2\\u6e05\\u5355\\u8ffd\\u52a0\\u6216\\u66ff\\u6362\\u7528\\u6237\\u9009\\u4e2d\\u7684\\u5de5\\u5355\\uff1b\\u53d6\\u6d88\\u8ffd\\u8e2a\\u4e0d\\u5220\\u9664\\u6b63\\u6587\\u3002\\\"\\\"\\\"\\n997:     root, personal, _ = paths(root_arg, global_arg)\\n998:     if not issue_ids:\\n999:         raise WorkspaceError(\\\"\\u8bf7\\u6307\\u5b9a\\u81f3\\u5c11\\u4e00\\u4e2a --issue-id\\\")\\n1000:     for issue_id in issue_ids:\\n1001:         validate_issue_id(issue_id)\\n1002:     path, old, value = read_tracking(personal)\\n1003:     if remove:\\n1004:         value[\\\"tracked_tasks\\\"] = [t for t in value[\\\"tracked_tasks\\\"] if t[\\\"issue_id\\\"] not in issue_ids]\\n1005:     else:\\n1006:         index_path = personal / \\\"tasks/index.json\\\"\\n1007:         raw = read_bytes(index_path)\\n1008:         if raw is None:\\n1009:             raise WorkspaceError(\\\"\\u8bf7\\u5148\\u83b7\\u53d6\\u5f53\\u524d\\u4efb\\u52a1\\uff0c\\u751f\\u6210\\u672c\\u5730\\u5de5\\u5355\\u6e05\\u5355\\\")\\n1010:         index = parse_json(raw, index_path)\\n1011:         if not isinstance(index.get(\\\"tasks\\\"), list):\\n1012:             raise WorkspaceError(\\\"\\u5de5\\u5355\\u6e05\\u5355\\u7f3a\\u5c11 tasks \\u5217\\u8868\\\")\\n1013:         available = {}\\n1014:         for item in index[\\\"tasks\\\"]:\\n1015:             if not isinstance(item, dict):\\n1016:                 raise WorkspaceError(\\\"\\u5de5\\u5355\\u6e05\\u5355\\u6761\\u76ee\\u65e0\\u6548\\\")\\n1017:             entry = issue_entry(item.get(\\\"issue_id\\\"), item.get(\\\"title\\\"))\\n1018:             if item != entry:\\n1019:                 raise WorkspaceError(\\\"\\u5de5\\u5355\\u6e05\\u5355\\u6761\\u76ee\\u65e0\\u6548\\\")\\n1020:             available[entry[\\\"issue_id\\\"]] = entry\\n1021:         selected = {} if replace else {t[\\\"issue_id\\\"]: t for t in value[\\\"tracked_tasks\\\"]}\\n1022:         for issue_id in issue_ids:\\n1023:             if issue_id not in available or read_bytes(root / available[issue_id][\\\"description_path\\\"]) is None:\\n1024:                 raise WorkspaceError(f\\\"\\u5de5\\u5355 {issue_id} \\u4e0d\\u5728\\u5f53\\u524d\\u6e05\\u5355\\u6216\\u6b63\\u6587\\u7f3a\\u5931\\uff0c\\u8bf7\\u91cd\\u65b0\\u83b7\\u53d6\\\")\\n1025:             selected[issue_id] = available[issue_id]\\n1026:         value[\\\"tracked_tasks\\\"] = list(selected.values())\\n1027:     return save_tracking(path, old, value, \\\"untrack\\\" if remove else \\\"track\\\", apply)\\n1028: \\n1029: \\n1030: def record_coverage_task(root_arg, global_arg, task, apply=False):\\n1031:     \\\"\\\"\\\"\\u6309\\u5de5\\u5355\\u548c\\u5206\\u652f\\u767b\\u8bb0\\u8986\\u76d6\\u7387\\u8eab\\u4efd\\uff0c\\u4ec5\\u5199\\u4e2a\\u4eba\\u76ee\\u5f55\\uff0c\\u4e0d\\u66f4\\u65b0\\u5165\\u53e3\\u6587\\u4ef6\\u3002\\\"\\\"\\\"\\n1032:     validate_coverage(task)\\n1033:     _, personal, _ = paths(root_arg, global_arg)\\n1034:     path, old, value = read_tracking(personal)\\n1035:     value[\\\"coverage_tasks\\\"] = [t for t in value[\\\"coverage_tasks\\\"]\\n1036:                                if (t[\\\"redmine_id\\\"], t[\\\"branch\\\"]) != (task[\\\"redmine_id\\\"], task[\\\"branch\\\"])]\\n1037:     value[\\\"coverage_tasks\\\"].append(task)\\n1038:     value[\\\"coverage_tasks\\\"].sort(key=lambda t: (t[\\\"redmine_id\\\"], t[\\\"branch\\\"]))\\n1039:     return save_tracking(path, old, value, \\\"coverage-task\\\", apply)\\n1040: \\n1041: \\n1042: def busy_codex_jobs(personal):\\n1043:     \\\"\\\"\\\"\\u8fd4\\u56de\\u4e0d\\u80fd\\u6e05\\u7406\\u7684 codex-cli \\u4efb\\u52a1\\uff1a\\u4ecd\\u5728\\u8fd0\\u884c\\uff08starting\\uff0frunning\\uff09\\uff0c\\u6216 test \\u4efb\\u52a1\\u7684\\u8bbe\\u5907\\u5c1a\\u672a release\\u3002\\n1044: \\n1045:     state.json \\u65e0\\u6cd5\\u8bfb\\u53d6\\u65f6\\u4e5f\\u7b97\\u5728\\u5185\\uff0c\\u7531\\u7528\\u6237\\u6838\\u5b9e\\u540e\\u518d\\u6e05\\u7406\\u3002\\n1046:     \\\"\\\"\\\"\\n1047:     jobs = personal / CODEX_JOBS\\n1048:     no_links(jobs)\\n1049:     if not jobs.is_dir():\\n1050:         return []\\n1051:     busy = []\\n1052:     for job in sorted(jobs.iterdir()):\\n1053:         state_path = job / \\\"state.json\\\"\\n1054:         try:\\n1055:             raw = read_bytes(state_path)\\n1056:             if raw is None:\\n1057:                 continue\\n1058:             state = parse_json(raw, state_path)\\n1059:         except (WorkspaceError, OSError) as error:\\n1060:             busy.append(f\\\"{job.name}\\uff08state.json \\u65e0\\u6cd5\\u8bfb\\u53d6\\uff1a{error}\\uff09\\\")\\n1061:             continue\\n1062:         status = state.get(\\\"status\\\")\\n1063:         if isinstance(status, str) and status.startswith(CODEX_ACTIVE):\\n1064:             busy.append(f\\\"{job.name}\\uff08{status}\\uff09\\\")\\n1065:         elif state.get(\\\"kind\\\") == \\\"test\\\" and state.get(\\\"released\\\") is not True:\\n1066:             busy.append(f\\\"{job.name}\\uff08test \\u4efb\\u52a1\\u5c1a\\u672a release\\uff09\\\")\\n1067:     return busy\\n1068: \\n1069: \\n1070: def clean(root_arg, global_arg, apply=False):\\n1071:     \\\"\\\"\\\"\\u6e05\\u7a7a\\u4e2a\\u4eba\\u76ee\\u5f55\\uff1bcodex-cli \\u6709\\u672a\\u7ed3\\u675f\\u6216\\u672a release \\u7684\\u4efb\\u52a1\\u65f6\\u62d2\\u7edd\\uff0c\\u4e0d\\u5220\\u9664\\u4efb\\u4f55\\u5185\\u5bb9\\u3002\\\"\\\"\\\"\\n1072:     root, personal, global_config = paths(root_arg, global_arg)\\n1073:     if not exists(personal):\\n1074:         return {\\\"action\\\": \\\"clean\\\", \\\"applied\\\": apply, \\\"target\\\": str(personal), \\\"entries\\\": []}\\n1075:     busy = busy_codex_jobs(personal)\\n1076:     if busy:\\n1077:         raise WorkspaceError(\\\"codex-cli \\u8fd8\\u6709\\u672a\\u7ed3\\u675f\\u6216\\u672a release \\u7684\\u4efb\\u52a1\\uff0c\\u8bf7\\u5148\\u7b49\\u5f85\\u5b8c\\u6210\\u3001\\u53d6\\u6d88\\u6216 release \\u540e\\u518d\\u6e05\\u7406\\uff1a\\\"\\n1078:                              + \\\"\\u3001\\\".join(busy))\\n1079:     identity = personal.stat()\\n1080:     items = []\\n1081: \\n1082:     def scan(directory):\\n1083:         for path in sorted(directory.iterdir()):\\n1084:             no_links(path)\\n1085:             if not path.is_relative_to(personal):\\n1086:                 raise WorkspaceError(f\\\"\\u8d8a\\u754c\\u8def\\u5f84\\uff1a{path}\\\")\\n1087:             info = path.lstat()\\n1088:             if stat.S_ISDIR(info.st_mode):\\n1089:                 scan(path)\\n1090:             elif not stat.S_ISREG(info.st_mode):\\n1091:                 raise WorkspaceError(f\\\"\\u62d2\\u7edd\\u7279\\u6b8a\\u6587\\u4ef6\\uff1a{path}\\\")\\n1092:             items.append((path, info))\\n1093: \\n1094:     scan(personal)  # Complete preflight before any deletion.\\n1095:     entries = [str(path.relative_to(personal)) for path in sorted(personal.iterdir())]\\n1096:     if apply:\\n1097:         try:\\n1098:             for path, before in items:\\n1099:                 no_links(personal)\\n1100:                 current_root = personal.stat()\\n1101:                 if (identity.st_dev, identity.st_ino) != (current_root.st_dev, current_root.st_ino):\\n1102:                     raise WorkspaceError(\\\"\\u4e2a\\u4eba\\u76ee\\u5f55\\u8eab\\u4efd\\u53d1\\u751f\\u53d8\\u5316\\\")\\n1103:                 no_links(path)\\n1104:                 now = path.lstat()\\n1105:                 if (before.st_dev, before.st_ino, before.st_mode) != (now.st_dev, now.st_ino, now.st_mode):\\n1106:                     raise WorkspaceError(f\\\"\\u5f85\\u6e05\\u7406\\u5bf9\\u8c61\\u5df2\\u53d8\\u5316\\uff1a{path}\\\")\\n1107:                 if stat.S_ISDIR(now.st_mode):\\n1108:                     path.rmdir()\\n1109:                 else:\\n1110:                     if (before.st_size, before.st_mtime_ns) != (now.st_size, now.st_mtime_ns):\\n1111:                         raise WorkspaceError(f\\\"\\u5f85\\u6e05\\u7406\\u6587\\u4ef6\\u5df2\\u53d8\\u5316\\uff1a{path}\\\")\\n1112:                     path.unlink()\\n1113:             if any(personal.iterdir()):\\n1114:                 raise WorkspaceError(\\\"\\u6e05\\u7406\\u671f\\u95f4\\u51fa\\u73b0\\u65b0\\u6587\\u4ef6\\\")\\n1115:         except Exception as error:\\n1116:             raise WorkspaceError(f\\\"\\u6e05\\u7406\\u4e2d\\u6b62\\uff0c\\u53ef\\u80fd\\u5df2\\u90e8\\u5206\\u6e05\\u7406\\uff1a{error}\\\") from error\\n1117:     return {\\\"action\\\": \\\"clean\\\", \\\"applied\\\": apply, \\\"target\\\": str(personal), \\\"entries\\\": entries}\\n1118: \\n1119: \\n1120: def main():\\n1121:     for stream in (sys.stdout, sys.stderr):\\n1122:         if hasattr(stream, \\\"reconfigure\\\"):\\n1123:             stream.reconfigure(encoding=\\\"utf-8\\\")\\n1124:     parser = argparse.ArgumentParser(description=__doc__)\\n1125:     parser.add_argument(\\\"action\\\", choices=(\\\"sync\\\", \\\"context\\\", \\\"index\\\", \\\"clean\\\", \\\"coverage-task\\\", \\\"config\\\",\\n1126:                                            \\\"show-config\\\", \\\"track\\\", \\\"untrack\\\"))\\n1127:     parser.add_argument(\\\"--query\\\", action=\\\"append\\\", default=[], help=\\\"index\\uff1a\\u6309\\u5173\\u952e\\u8bcd\\u8fc7\\u6ee4\\uff0c\\u53ef\\u91cd\\u590d\\uff0c\\u5168\\u90e8\\u547d\\u4e2d\\\")\\n1128:     parser.add_argument(\\\"--add\\\", action=\\\"append\\\", default=[], help=\\\"index\\uff1a\\u624b\\u52a8\\u6536\\u5f55 spec\\uff0c\\u53ef\\u91cd\\u590d\\\")\\n1129:     parser.add_argument(\\\"--remove\\\", action=\\\"append\\\", default=[], help=\\\"index\\uff1a\\u79fb\\u51fa spec\\uff0c\\u53ef\\u91cd\\u590d\\\")\\n1130:     parser.add_argument(HOOK_FLAG, dest=\\\"from_hook\\\", action=\\\"store_true\\\",\\n1131:                         help=\\\"context\\uff0findex\\uff1a\\u7531 Claude Code hook \\u8c03\\u7528\\uff08context \\u8f93\\u51fa\\u6ce8\\u5165\\u683c\\u5f0f\\uff0cindex \\u4ece stdin \\u8bfb\\u53d6\\u5199\\u5165\\u4e8b\\u4ef6\\uff09\\\")\\n1132:     parser.add_argument(\\\"--issue-id\\\", action=\\\"append\\\", default=[])\\n1133:     parser.add_argument(\\\"--replace\\\", action=\\\"store_true\\\", help=\\\"\\u66ff\\u6362\\u8ffd\\u8e2a\\u5217\\u8868\\uff1b\\u9ed8\\u8ba4\\u8ffd\\u52a0\\\")\\n1134:     parser.add_argument(\\\"--prompt-password\\\", action=\\\"store_true\\\")\\n1135:     parser.add_argument(\\\"--task-name\\\")\\n1136:     parser.add_argument(\\\"--branch\\\", help=\\\"coverage-task\\uff1a\\u4ed3\\u5e93\\u76f8\\u5bf9\\u8def\\u5f84\\uff08\\u5982 branchs/2026_dev/x\\uff09\\uff0c\\u7701\\u7565\\u65f6\\u4ece svn \\u63a8\\u65ad\\\")\\n1137:     parser.add_argument(\\\"--redmine-id\\\")\\n1138:     parser.add_argument(\\\"--coder-name\\\")\\n1139:     parser.add_argument(\\\"--root\\\", default=os.getcwd())\\n1140:     parser.add_argument(\\\"--global-config\\\", default=str(Path.home() / DIRECTORY / \\\"config.json\\\"))\\n1141:     parser.add_argument(\\\"--set-global\\\", action=\\\"append\\\", default=[])\\n1142:     parser.add_argument(\\\"--set-local\\\", action=\\\"append\\\", default=[])\\n1143:     parser.add_argument(\\\"--apply\\\", action=\\\"store_true\\\")\\n1144:     args = parser.parse_args()\\n1145:     try:\\n1146:         if args.replace and args.action != \\\"track\\\":\\n1147:             raise WorkspaceError(\\\"--replace \\u4ec5\\u7528\\u4e8e track\\\")\\n1148:         if args.issue_id and args.action not in (\\\"track\\\", \\\"untrack\\\"):\\n1149:             raise WorkspaceError(\\\"--issue-id \\u4ec5\\u7528\\u4e8e track \\u6216 untrack\\\")\\n1150:         if args.action not in (\\\"sync\\\", \\\"config\\\") and (args.set_global or args.set_local):\\n1151:             raise WorkspaceError(\\\"\\u6b64\\u64cd\\u4f5c\\u4e0d\\u63a5\\u53d7 --set-global \\u6216 --set-local\\\")\\n1152:         if args.action != \\\"config\\\" and args.prompt_password:\\n1153:             raise WorkspaceError(\\\"--prompt-password \\u4ec5\\u7528\\u4e8e config\\\")\\n1154:         if args.action == \\\"config\\\" and args.set_local:\\n1155:             raise WorkspaceError(\\\"config \\u4ec5\\u66f4\\u65b0\\u7528\\u6237\\u7ea7\\u914d\\u7f6e\\\")\\n1156:         if (args.query or args.add or args.remove) and args.action != \\\"index\\\":\\n1157:             raise WorkspaceError(\\\"--query\\u3001--add\\u3001--remove \\u4ec5\\u7528\\u4e8e index\\\")\\n1158:         if args.from_hook and args.action not in (\\\"context\\\", \\\"index\\\"):\\n1159:             raise WorkspaceError(f\\\"{HOOK_FLAG} \\u4ec5\\u7528\\u4e8e context \\u6216 index\\\")\\n1160:         if args.action == \\\"index\\\" and args.from_hook:\\n1161:             # \\u5199\\u5165\\u540e\\u7684 hook \\u4e0d\\u5f97\\u5e72\\u6270\\u5de5\\u5177\\u8c03\\u7528\\uff1a\\u9759\\u9ed8\\u5904\\u7