    kernel = ctypes.WinDLL(\\\"kernel32\\\", use_last_error=True)\\n530:         kernel.OpenProcess.restype = ctypes.c_void_p\\n531:         kernel.OpenProcess.argtypes = [ctypes.c_uint32, ctypes.c_int, ctypes.c_uint32]\\n532:         kernel.GetExitCodeProcess.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint32)]\\n533:         kernel.CloseHandle.argtypes = [ctypes.c_void_p]\\n534:         handle = kernel.OpenProcess(0x1000, False, pid)\\n535:         if not handle:\\n536:             return ctypes.get_last_error() == 5\\n537:         code = ctypes.c_uint32()\\n538:         try:\\n539:             return bool(kernel.GetExitCodeProcess(handle, ctypes.byref(code))) and code.value == 259\\n540:         finally:\\n541:             kernel.CloseHandle(handle)\\n542:     try:\\n543:         os.kill(pid, 0)\\n544:         return True\\n545:     except ProcessLookupError:\\n546:         return False\\n547:     except PermissionError:\\n548:         return True\\n549: \\n550: \\n551: def release(job):\\n552:     \\\"\\\"\\\"test \\u4efb\\u52a1\\u7ec8\\u6b62\\u5e76\\u7531\\u4e3b\\u7ebf\\u7a0b\\u6838\\u5bf9\\u6062\\u590d\\u540e\\uff0c\\u5220\\u9664\\u8bbe\\u5907\\u9501\\u5e76\\u6807\\u8bb0 released\\u3002\\\"\\\"\\\"\\n553:     state = status(job)\\n554:     if state.get(\\\"kind\\\") != \\\"test\\\":\\n555:         raise ValueError(\\\"\\u53ea\\u6709 test \\u4efb\\u52a1\\u9700\\u8981 release\\\")\\n556:     if state[\\\"status\\\"] not in TERMINAL:\\n557:         raise ValueError(\\\"\\u4efb\\u52a1\\u7ec8\\u6b62\\u5e76\\u6838\\u5bf9\\u6062\\u590d\\u540e\\u624d\\u53ef release --restored\\\")\\n558:     lock = Path(state[\\\"lock\\\"])\\n559:     if lock.exists():\\n560:         if read_json(lock)[\\\"job\\\"] != str(job):\\n561:             raise ValueError(\\\"\\u8bbe\\u5907\\u9501\\u4e0d\\u5c5e\\u4e8e\\u672c\\u4efb\\u52a1\\\")\\n562:         lock.unlink()\\n563:     state.update(restoration=\\\"restored\\\", released=True)\\n564:     write_json(job / \\\"state.json\\\", state)\\n565:     return state\\n566: \\n567: \\n568: def main():\\n569:     \\\"\\\"\\\"\\u547d\\u4ee4\\u884c\\u5165\\u53e3\\uff1b\\u72b6\\u6001\\u4f7f\\u7528 JSON\\uff0c\\u9519\\u8bef\\u4e0d\\u6253\\u5370\\u542b\\u51ed\\u636e\\u7684\\u547d\\u4ee4\\u6216\\u914d\\u7f6e\\u3002\\\"\\\"\\\"\\n570:     parser = argparse.ArgumentParser(description=__doc__)\\n571:     parser.add_argument(\\\"command\\\", choices=[\\\"start\\\", \\\"status\\\", \\\"wait\\\", \\\"cancel\\\", \\\"release\\\", \\\"_worker\\\"])\\n572:     parser.add_argument(\\\"--root\\\")\\n573:     parser.add_argument(\\\"--kind\\\", choices=KINDS)\\n574:     parser.add_argument(\\\"--task-file\\\")\\n575:     parser.add_argument(\\\"--resume\\\")\\n576:     parser.add_argument(\\\"--job\\\")\\n577:     parser.add_argument(\\\"--timeout\\\", type=float, default=None)\\n578:     parser.add_argument(\\\"--restored\\\", action=\\\"store_true\\\")\\n579:     args = parser.parse_args()\\n580:     try:\\n581:         if args.command == \\\"start\\\":\\n582:             if not args.root or not args.kind or not args.task_file:\\n583:                 raise ValueError(\\\"start \\u9700\\u8981 --root\\u3001--kind \\u548c --task-file\\\")\\n584:             result = start(args.root, args.kind, args.task_file, args.resume)\\n585:         else:\\n586:             if not args.job:\\n587:                 raise ValueError(\\\"\\u9700\\u8981 --job\\\")\\n588:             job = Path(args.job).resolve()\\n589:             if args.command == \\\"_worker\\\":\\n590:                 return worker(job)\\n591:             if args.command == \\\"release\\\":\\n592:                 if not args.restored:\\n593:                     raise ValueError(\\\"release \\u9700\\u8981 --restored\\uff0c\\u8868\\u793a\\u5df2\\u6838\\u5bf9\\u5e76\\u6062\\u590d\\u5ba2\\u6237\\u7aef\\\")\\n594:                 result = release(job)\\n595:             else:\\n596:                 result = status(job)\\n597:             if args.command == \\\"wait\