\\n190:     \\\"\\\"\\\"\\u6784\\u9020\\u56fa\\u5b9a\\u6a21\\u578b\\u3001\\u6309\\u7c7b\\u578b\\u9650\\u5236\\u6c99\\u7bb1\\u548c MCP\\u3001\\u7981\\u7528\\u5b50\\u4ee3\\u7406\\u7684\\u6267\\u884c\\u547d\\u4ee4\\u3002\\n191: \\n192:     Args:\\n193:         job: \\u4efb\\u52a1\\u76ee\\u5f55\\u3002\\n194:         task: \\u4efb\\u52a1\\u6587\\u4ef6\\u5185\\u5bb9\\u3002\\n195:         state: \\u4efb\\u52a1\\u72b6\\u6001\\uff0c\\u63d0\\u4f9b kind\\u3001root \\u548c resume \\u7684\\u4f1a\\u8bdd ID\\u3002\\n196: \\n197:     Returns:\\n198:         \\u53c2\\u6570\\u5217\\u8868\\uff1b\\u53ef\\u80fd\\u542b\\u8ba4\\u8bc1\\u914d\\u7f6e\\uff0c\\u4e0d\\u5f97\\u5199\\u5165\\u65e5\\u5fd7\\u6216\\u8f93\\u51fa\\u3002\\n199:     \\\"\\\"\\\"\\n200:     config = user_config()\\n201:     kind = state[\\\"kind\\\"]\\n202:     sandbox = \\\"workspace-write\\\" if kind == \\\"test\\\" else \\\"read-only\\\"\\n203:     options = [\\\"--ignore-user-config\\\", \\\"--skip-git-repo-check\\\", \\\"-m\\\", MODEL,\\n204:                \\\"-c\\\", f'model_reasoning_effort=\\\"{EFFORT}\\\"', \\\"-c\\\", 'approval_policy=\\\"never\\\"',\\n205:                \\\"-c\\\", f'sandbox_mode=\\\"{sandbox}\\\"', \\\"-c\\\", \\\"agents.enabled=false\\\",\\n206:                \\\"-c\\\", \\\"features.multi_agent=false\\\", \\\"-c\\\", \\\"features.hooks=false\\\", \\\"-c\\\", \\\"plugins={}\\\",\\n207:                \\\"-c\\\", \\\"mcp_servers=\\\" + toml_value(mcp_servers(task, config) if kind == \\\"test\\\" else {}),\\n208:                \\\"--json\\\", \\\"--output-schema\\\", str(job / \\\"schema.json\\\"), \\\"-o\\\", str(job / \\\"result.json\\\")]\\n209:     if os.name == \\\"nt\\\":\\n210:         # \\u7528\\u6237\\u914d\\u7f6e\\u7684 elevated \\u6c99\\u7bb1\\u5728\\u975e\\u4ea4\\u4e92\\u540e\\u53f0\\u8fdb\\u7a0b\\u91cc\\u521d\\u59cb\\u5316\\u5931\\u8d25\\uff0c\\u4e0d\\u8bbe\\u7f6e\\u65f6\\u547d\\u4ee4\\u4e00\\u5f8b\\u88ab\\u7b56\\u7565\\u62d2\\u7edd\\u3002\\n211:         options += [\\\"-c\\\", 'windows.sandbox=\\\"unelevated\\\"']\\n212:     # \\u53ea\\u590d\\u7528\\u6a21\\u578b\\u8fde\\u63a5\\u914d\\u7f6e\\uff0c\\u907f\\u514d\\u52a0\\u8f7d\\u5bbf\\u4e3b\\u63d2\\u4ef6\\u3001hooks \\u548c\\u65e0\\u5173 MCP\\uff1b\\u4e0d\\u8bb0\\u5f55\\u542b\\u8ba4\\u8bc1\\u7684\\u547d\\u4ee4\\u3002\\n213:     for key in PROVIDER_KEYS:\\n214:         if key in config:\\n215:             options += [\\\"-c\\\", key + \\\"=\\\" + toml_value(config[key])]\\n216:     if state.get(\\\"resume_session\\\"):\\n217:         # resume \\u4e0d\\u63a5\\u53d7 --sandbox\\uff0f-C\\uff1a\\u6c99\\u7bb1\\u7528 -c \\u8986\\u76d6\\uff0c\\u76ee\\u5f55\\u7531\\u8fdb\\u7a0b cwd \\u51b3\\u5b9a\\u3002\\n218:         return cli_prefix() + [\\\"exec\\\", \\\"resume\\\", *options, state[\\\"resume_session\\\"], \\\"-\\\"]\\n219:     options += [\\\"--sandbox\\\", sandbox, \\\"-C\\\", str(job if kind == \\\"test\\\" else state[\\\"root\\\"])]\\n220:     for directory in task.get(\\\"write_dirs\\\", []):\\n221:         options += [\\\"--add-dir\\\", directory]\\n222:     return cli_prefix() + [\\\"exec\\\", *options, \\\"-\\\"]\\n223: \\n224: \\n225: def stop_tree(process):\\n226:     \\\"\\\"\\\"\\u7ec8\\u6b62\\u6240\\u6301\\u6709\\u7684 CLI \\u8fdb\\u7a0b\\u6811\\uff1b\\u4e0d\\u6062\\u590d\\u8fdc\\u7aef\\u5ba2\\u6237\\u7aef\\u72b6\\u6001\\u3002\\\"\\\"\\\"\\n227:     if process.poll() is not None:\\n228:         return\\n229:     if os.name == \\\"nt\\\":\\n230:         subprocess.run([\\\"taskkill\\\", \\\"/PID\\\", str(process.pid), \\\"/T\\\", \\\"/F\\\"],\\n231:                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)\\n232:     else:\\n233:         try:\\n234:             os.killpg(process.pid, signal.SIGKILL)\\n235:         except ProcessLookupError:\\n236:             pass\\n237:     process.wait(timeout=10)\\n238: \\n239: \\n240: def session_id(job):\\n241:     \\\"\\\"\\\"\\u4ece --json \\u4e8b\\u4ef6\\u6d41\\u91cc\\u53d6 thread.started \\u7684\\u4f1a\\u8bdd ID\\uff0c\\u4f9b\\u4e0b\\u4e00\\u8f6e review \\u7eed\\u63a5\\u3002\\\"\\\"\\\"\\n242:     try:\\n243:         lines = (job / \\\"stdout.jsonl\\\").read_text(encoding=\\\"utf-8\\\", errors=\\\"replace\\\").splitlines()\\n244:     except OSError:\\n245:         return None\\n246:     for line in lines:\\n247:         try:\\n248:             event = json.loads(line)\\n249:         except ValueError:\\n250:             continue\\n251:         if isinstance(event, dict) and event.get(\\\"type\\\") == \\\"thread.started\\\" and event.get(\\\"thread_id\\\"):\\n252:             return event[\\\"thread_id\\\"]\\n253:     return None\\n254: \\n255: \\n256: def format_review(result):\\n257:     \\\"\\\"\\\"\\u628a review \\u7ed3\\u679c\\u6392\\u6210 code-review.md \\u7684\\u9010\\u6761\\u683c\\u5f0f\\u3002\\\"\\\"\\\"\\n258:     return [f\\\"[{i['level']}] {i['location']} \\u2014\\u2014 {i['problem']}\\uff1b{i['basis']}\\uff1b{i['suggestion']}\\\"\\n259:             for i in result[\\\"items\\\"]]\\n260: \\n261: \\n262: def finish(job, state, returncode):\\n263:     \\\"\\\"\\\"CLI \\u6b63\\u5e38\\u9000\\u51fa\\u540e\\u6821\\u9a8c\\u7ed3\\u6784\\u5316\\u7ed3\\u679c\\uff1b\\u9000\\u51fa\\u7801\\u4e3a 0 \\u4f46\\u7ed3\\u679c\\u4e0d\\u5b8c\\u6574\\u4ecd\\u662f failed\\u3002\\\"\\\"\\\"\\n264:     state[\\\"exit_code\\\"] = returncode\\n265:     try:\\n266:         result = read_json(job / \\\"result.json\\\")\\n267:         valid = matches(result, SCHEMAS[state[\\\"kind\\\"]])\\n268:     except (OSError, ValueError):\\n269:         valid = False\\n270:     state[\\\"status\\\"] = \\\"completed\\\" if returncode == 0 and valid else \\\"failed\\\"\\n271:     if valid:\\n272:         state[\\\"result\\\"] = result\\n273:         if state[\\\"kind\\\"] == \\\"test\\\":\\n274:             state[\\\"restoration\\\"] = result[\\\"restoration\\\"]\\n275:         if state[\\\"kind\\\"] == \\\"review\\\":\\n276:             state[\\\"formatted\\\"] = format_review(result)\\n277:             state[\\\"must_fix\\\"] = sum(i[\\\"level\\\"] == \\\"\\u5fc5\\u987b\\u4fee\\u6539\\\" for i in result[\\\"items\\\"])\\n278:     else:\\n279:         state[\\\"error\\\"] = \\\"CLI \\u672a\\u8fd4\\u56de\\u5b8c\\u6574\\u7684\\u7ed3\\u6784\\u5316\\u7ed3\\u679c\\\"\\n280: \\n281: \\n282: def monitor(job, command, idle_seconds=IDLE_SECONDS):\\n283:     \\\"\\\"\\\"\\u6301\\u7eed\\u6392\\u7a7a\\u4e24\\u8def\\u8f93\\u51fa\\uff1b\\u53ea\\u6709 CLI \\u5b57\\u8282\\u8f93\\u51fa\\u5237\\u65b0\\u9759\\u9ed8\\u8ba1\\u65f6\\uff0c\\u65e0\\u603b\\u65f6\\u957f\\u4e0a\\u9650\\u3002\\\"\\\"\\\"\\n284:     state = read_json(job / \\\"state.json\\\")\\n285:     state.update(status=\\\"running\\\", monitor_pid=os.getpid())\\n286:     write_json(job / \\\"state.json\\\", state)\\n287:     process = None\\n288:     streams = queue.Queue()\\n289:     last_output = time.monotonic()\\n290:     published = 0.0\\n291:     ended = 0\\n292: \\n293:     def pump(pipe, name):\\n294:         \\\"\\\"\\\"\\u8bfb\\u53d6\\u975e\\u6362\\u884c\\u8f93\\u51fa\\uff0c\\u907f\\u514d\\u957f\\u884c\\u6216 stderr \\u6d3b\\u8dc3\\u88ab\\u8bef\\u5224\\u4e3a\\u9759\\u9ed8\\u3002\\\"\\\"\\\"\\n295:         try:\\n296:             while True:\\n297:                 data = os.read(pipe.fileno(), 4096)\\n298:                 if not data:\\n299:                     break\\n300:                 streams.put((name, data, time.monotonic()))\\n301:         finally:\\n302:             pipe.close()\\n303:             streams.put((name, None, time.monotonic()))\\n304: \\n305:     try:\\n306:         if (job / \\\"cancel\\\").exists():\\n307:             state[\\\"status\\\"] = \\\"cancelled\\\"\\n308:             return\\n309:         with open(job / \\\"prompt.txt\\\", \\\"rb\\\") as prompt:\\n310:             process = subprocess.Popen(command, stdin=prompt, stdout=subprocess.PIPE,\\n311:                                        stderr=subprocess.PIPE, cwd=state.get(\\\"cwd\\\", job), env=child_env(),\\n312:                                        start_new_session=os.name != \\\"nt\\\",\\n313:                                        creationflags=(subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.CREATE_NO_WINDOW)\\n314:                                        if os.name == \\\"nt\\\" else 0)\\n315:         state[\\\"cli_pid\\\"] = process.pid\\n316:         state[\\\"last_output_at\\\"] = time.time()\\n317:         write_json(job / \\\"state.json\\\", state)\\n318:         for pipe, name in ((process.stdout, \\\"stdout\\\"), (process.stderr, \\\"stderr\\\")):\\n319:             threading.Thread(target=pump, args=(pipe, name), daemon=True).start()\\n320:         with open(job / \\\"stdout.jsonl\\\", \\\"ab\\\") as stdout, open(job / \\\"stderr.log\\\", \\\"ab\\\") as stderr:\\n321:             while True:\\n322:                 try:\\n323:                     name, data, timestamp = streams.get(timeout=0.05)\\n324:                     if data is None:\\n325:                         ended += 1\\n326:                     else:\\n327:                         (stdout if name == \\\"stdout\\\" else stderr).write(data)\\n328:                         (stdout if name == \\\"stdout\\\" else stderr).flush()\\n329:                         last_output = max(last_output, timestamp)\\n330:                         if time.time() - published >= 1:\\n331:                             # \\u9650\\u5236\\u5199\\u9891\\u7387\\uff0c\\u51cf\\u5c11\\u4e0e\\u67e5\\u8be2\\u8fdb\\u7a0b\\u4e89\\u7528 state.json\\u3002\\n332:                             published = state[\\\"last_output_at\\\"] = time.time()\\n333:                             write_json(job / \\\"state.json\\\", state)\\n334:                 except queue.Empty:\\n335:                     pass\\n336:                 if (job / \\\"cancel\\\").exists():\\n337:                     state[\\\"status\\\"] = \\\"cancelled\\\"\\n338:                     stop_tree(process)\\n339:                     break\\n340:                 if time.monotonic() - last_output >= idle_seconds:\\n341:                     state[\\\"status\\\"] = \\\"timed_out\\\"\\n342:                     stop_tree(process)\\n343:                     break\\n344:                 if process.poll() is not None and ended == 2:\\n345:                     finish(job, state, process.returncode)\\n346:                     break\\n347:     except Exception as error:\\n348:         state.update(status=\\\"failed\\\", error=type(error).__name__ + \\\": \\u6267\\u884c\\u5931\\u8d25\\uff0c\\u68c0\\u67e5\\u65e5\\u5fd7\\u548c\\u8fd0\\u884c\\u73af\\u5883\\\")\\n349:         if process is not None:\\n350:             try:\\n351:                 stop_tree(process)\\n352:             except Exception:\\n353:                 state[\\\"error\\\"] += \\\"\\uff1b\\u8fdb\\u7a0b\\u7ec8\\u6b62\\u5931\\u8d25\\\"\\n354:     finally:\\n355:         if process is not None:\\n356:             state[\\\"exit_code\\\"] = process.poll()\\n357:         state[\\\"session_id\\\"] = session_id(job) or state.get(\\\"resume_session\\\")\\n358:         state[\\\"finished_at\\\"] = time.time()\\n359:         write_json(job / \\\"state.json\\\", state)\\n360: \\n361: \\n362: def worker(job):\\n363:     \\\"\\\"\\\"\\u540e\\u53f0\\u76d1\\u63a7\\u5165\\u53e3\\uff1b\\u53ea\\u5728\\u4efb\\u52a1\\u4ecd\\u4e3a starting \\u4e14\\u6ca1\\u6709\\u5b58\\u6d3b\\u7684\\u76d1\\u63a7\\uff0fCLI \\u65f6\\u8fd0\\u884c\\uff0c\\u9632\\u6b62\\u91cd\\u590d\\u542f\\u52a8\\u3002\\\"\\\"\\\"\\n364:     try:\\n365:         with (job / \\\"worker.claim\\\").open(\\\"x\\\", encoding=\\\"utf-8\\\") as handle:\\n366:             handle.write(str(os.getpid()))\\n367:     except FileExistsError:\\n368:         return 1\\n369:     state = read_json(job / \\\"state.json\\\")\\n370:     pids = [state.get(\\\"cli_pid\\\"), state.get(\\\"monitor_pid\\\")]\\n371:     if state[\\\"status\\\"] != \\\"starting\\\" or any(pid and pid != os.getpid() and alive(pid) for pid in pids):\\n372:         return 1\\n373:     state[\\\"monitor_pid\\\"] = os.getpid()\\n374:     write_json(job / \\\"state.json\\\", state)\\n375:     try:\\n376:         command = cli_command(job, read_json(job / \\\"task.json\\\"), state)\\n377:     except Exception:\\n378:         state.update(status=\\\"failed\\\", error=\\\"CLI \\u542f\\u52a8\\u914d\\u7f6e\\u4e0d\\u53ef\\u7528\\\", finished_at=time.time())\\n379:         write_json(job / \\\"state.json\\\", state)\\n380:         return 2\\n381:     monitor(job, command)\\n382:     return 0\\n383: \\n384: \\n385: def references(root, kind, task):\\n386:     \\\"\\\"\\\"\\u9ed8\\u8ba4\\u89c4\\u8303\\u5728\\u524d\\uff0c\\u4efb\\u52a1\\u8ffd\\u52a0\\u7684 references \\u5728\\u540e\\uff0c\\u53bb\\u91cd\\u4f46\\u4e0d\\u8986\\u76d6\\u9ed8\\u8ba4\\u9879\\u3002\\\"\\\"\\\"\\n387:     refs = [str(root / \\\"AGENTS.md\\\")] if (root / \\\"AGENTS.md\\\").exists() else []\\n388:     refs += [str(SKILL / \\\"references\\\" / name) for name in DEFAULT_REFS[kind]]\\n389:     extra = task.get(\\\"references\\\", [])\\n390:     if not isinstance(extra, list) or any(not isinstance(p, str) for p in extra):\\n391:         raise ValueError(\\\"references \\u5fc5\\u987b\\u662f\\u8def\\u5f84\\u5b57\\u7b26\\u4e32\\u5217\\u8868\\\")\\n392:     return list(dict.fromkeys(refs + extra))\\n393: \\n394: \\n395: def acquire_lock(devid, job):\\n396:     \\\"\\\"\\\"\\u5168\\u673a\\u8bbe\\u5907\\u9501\\uff1a\\u4e0d\\u540c\\u5de5\\u4f5c\\u533a\\u4e5f\\u4e0d\\u80fd\\u540c\\u65f6\\u59d4\\u6d3e\\u540c\\u4e00\\u4e2a\\u5ba2\\u6237\\u7aef\\uff1b\\u9501\\u53ea\\u7531 release --restored \\u5220\\u9664\\u3002\\\"\\\"\\\"\\n397:     locks = Path(os.environ.get(\\\"LOCALAPPDATA\\\", str(Path.home() / \\\".cache\\\"))) / \\\"mhxy-cli-testing/locks\\\"\\n398:     locks.mkdir(parents=True, exist_ok=True)\\n399:     lock = locks / (hashlib.sha256(devid.encode()).hexdigest() + \\\".json\\\")\\n400:     try:\\n401:         with lock.open(\\\"x\\\", encoding=\\\"utf-8\\\") as handle:\\n402:             json.dump({\\\"job\\\": str(job), \\\"devid\\\": devid}, handle)\\n403:     except FileExistsError:\\n404:         raise ValueError(\\\"\\u8bbe\\u5907\\u5df2\\u6709\\u4efb\\u52a1\\u6216\\u5f85\\u6062\\u590d\\u72b6\\u6001\\uff1a\\\" + str(read_json(lock).get(\\\"job\\\"))) from None\\n405:     return lock\\n406: \\n407: \\n408: def prepare(root, kind, task, resume):\\n409:     \\\"\\\"\\\"\\u6821\\u9a8c\\u4efb\\u52a1\\u6587\\u4ef6\\uff0c\\u8865\\u9f50 kind \\u76f8\\u5173\\u5b57\\u6bb5\\uff1b\\u8fd4\\u56de (task, \\u7eed\\u63a5\\u7684\\u4f1a\\u8bdd ID)\\u3002\\\"\\\"\\\"\\n410:     if kind not in KINDS:\\n411:         raise ValueError(\\\"kind \\u5fc5\\u987b\\u662f investigate\\u3001review \\u6216 test\\\")\\n412:     if not isinstance(task, dict) or not isinstance(task.get(\\\"instructions\\\"), str) or not task[\\\"instructions\\\"].strip():\\n413:         raise ValueError(\\\"\\u4efb\\u52a1\\u5fc5\\u987b\\u6709 instructions\\\")\\n414:     session = None\\n415:     if resume:\\n416:         if kind != \\\"review\\\":\\n417:             raise ValueError(\\\"--resume \\u53ea\\u7528\\u4e8e review\\\")\\n418:         previous = read_json(Path(resume) / \\\"state.json\\\")\\n419:         if previous.get(\\\"kind\\\") != \\\"review\\\" or previous.get(\\\"status\\\") not in TERMINAL or not previous.get(\\\"session_id\\\"):\\n420:             raise ValueError(\\\"--resume \\u9700\\u8981\\u5df2\\u7ed3\\u675f\\u4e14\\u8bb0\\u5f55\\u4e86\\u4f1a\\u8bdd ID \\u7684 review \\u4efb\\u52a1\\\")\\n421:         session = previous[\\\"session_id\\\"]\\n422:     if kind == \\\"test\\\":\\n423:         if not isinstance(task.get(\\\"devid\\\"), str) or not task[\\\"devid\\\"].strip():\\n424:             raise ValueError(\\\"test \\u4efb\\u52a1\\u5fc5\\u987b\\u6709\\u5df2\\u9009\\u5b9a\\u7684\\u975e\\u7a7a devid\\\")\\n425:         base = root / \\\".mhxy-workspace\\\"\\n426:         task[\\\"write_dirs\\\"] = [str(checked_directory(Path(p), base)) for p in task.get(\\\"write_dirs\\\", [])]\\n427:     elif task.get(\\\"write_dirs\\\") or task.get(\\\"mcp_tools\\\") or task.get(\\\"devid\\\"):\\n428:         raise ValueError(\\\"\\u53ea\\u6709 test \\u4efb\\u52a1\\u53ef\\u4ee5\\u8bbe\\u7f6e devid\\u3001mcp_tools \\u548c write_dirs\\\")\\n429:     return task, session\\n430: \\n431: \\n432: def start(root, kind, task_file, resume=None):\\n433:     \\\"\\\"\\\"\\u521b\\u5efa\\u4efb\\u52a1\\u76ee\\u5f55\\uff0ctest \\u4efb\\u52a1\\u72ec\\u5360\\u8bbe\\u5907\\uff0c\\u542f\\u52a8\\u8131\\u79bb\\u63a7\\u5236\\u53f0\\u7684\\u540e\\u53f0 worker \\u540e\\u7acb\\u5373\\u8fd4\\u56de\\u3002\\\"\\\"\\\"\\n434:     if os.environ.get(GUARD):\\n435:         raise ValueError(\\\"\\u5f53\\u524d\\u8fdb\\u7a0b\\u662f\\u88ab\\u59d4\\u6d3e\\u7684\\u5b50 Codex\\uff0c\\u4e0d\\u5f97\\u518d\\u59d4\\u6d3e\\\")\\n436:     root = Path(root).resolve()\\n437:     if not root.is_dir():\\n438:         raise ValueError(\\\"\\u9879\\u76ee\\u6839\\u76ee\\u5f55\\u4e0d\\u5b58\\u5728\\\")\\n439:     task, session = prepare(root, kind, read_json(task_file), resume)\\n440:     base = root / \\\".mhxy-workspace\\\"\\n441:     jobs = checked_directory(base / \\\"codex-cli\\\", base)\\n442:     jobs.mkdir(parents=True, exist_ok=True)\\n443:     for directory in task.get(\\\"write_dirs\\\", []):\\n444:         Path(directory).mkdir(parents=True, exist_ok=True)\\n445:     job = jobs / (time.strftime(\\\"%Y%m%d-%H%M%S-\\\") + kind + \\\"-\\\" + uuid.uuid4().hex[:8])\\n446:     job.mkdir()\\n447:     lock = acquire_lock(task[\\\"devid\\\"], job) if kind == \\\"test\\\" else None\\n448:     published = False\\n449:     try:\\n450:         refs = references(root, kind, task)\\n451:         write_json(job / \\\"task.json\\\", task)\\n452:         write_json(job / \\\"schema.json\\\", SCHEMAS[kind])\\n453:         payload = {**task, \\\"root\\\": str(root), \\\"kind\\\": kind, \\\"references\\\": refs}\\n454:         prompt = COMMON + ROLE[kind] + \\\"\\\\n\\\" + json.dumps(payload, ensure_ascii=False, indent=2)\\n455:         if session:\\n456:             prompt = \\\"\\u8fd9\\u662f\\u540c\\u4e00\\u5ba1\\u67e5\\u4f1a\\u8bdd\\u7684\\u4e0b\\u4e00\\u8f6e\\u3002\\u6309\\u65b0\\u7684\\u4efb\\u52a1\\u8bf4\\u660e\\u91cd\\u65b0\\u5ba1\\u67e5\\uff0c\\u91cd\\u70b9\\u68c0\\u67e5\\u4e0a\\u8f6e\\u610f\\u89c1\\u7684\\u5904\\u7406\\u3002\\\\n\\\" + prompt\\n457:         (job / \\\"prompt.txt\\\").write_text(prompt, encoding=\\\"utf-8\\\")\\n458:         state = {\\\"job\\\": str(job), \\\"kind\\\": kind, \\\"status\\\": \\\"starting\\\", \\\"model\\\": MODEL, \\\"effort\\\": EFFORT,\\n459:                  \\\"root\\\": str(root), \\\"cwd\\\": str(job if kind == \\\"test\\\" else root),\\n460:                  \\\"idle_seconds\\\": IDLE_SECONDS, \\\"started_at\\\": time.time()}\\n461:         if session:\\n462:             state.update(resume_session=session, resume_from=str(Path(resume).resolve()))\\n463:         if lock:\\n464:             state.update(lock=str(lock), devid=task[\\\"devid\\\"], restoration=\\\"unknown\\\", released=False)\\n465:         write_json(job / \\\"state.json\\\", state)\\n466:         cli_command(job, task, state)  # \\u542f\\u52a8\\u524d\\u68c0\\u67e5 CLI \\u4e0e\\u670d\\u52a1\\u914d\\u7f6e\\uff0c\\u4e0d\\u8f93\\u51fa\\u53ef\\u80fd\\u542b\\u8ba4\\u8bc1\\u5934\\u7684 argv\\u3002\\n467:         with open(job / \\\"monitor.log\\\", \\\"ab\\\") as log:\\n468:             process = subprocess.Popen([sys.executable, \\\"-X\\\", \\\"utf8\\\", str(Path(__file__).resolve()),\\n469:                                         \\\"_worker\\\", \\\"--job\\\", str(job)], stdin=subprocess.DEVNULL,\\n470:                                        stdout=log, stderr=log, start_new_session=os.name != \\\"nt\\\",\\n471:                                        creationflags=(subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP\\n472:                                                       | subprocess.CREATE_NO_WINDOW) if os.name == \\\"nt\\\" else 0)\\n473:         (job / \\\"worker.pid\\\").write_text(str(process.pid), encoding=\\\"utf-8\\\")\\n474:         deadline = time.monotonic() + START_SECONDS\\n475:         while time.monotonic() < deadline:\\n476:             state = read_json(job / \\\"state.json\\\")\\n477:             if state.get(\\\"monitor_pid\\\") or state[\\\"status\\\"] in TERMINAL:\\n478:                 published = True\\n479:                 break\\n480:             if process.poll() is not None:\\n481:                 state = read_json(job / \\\"state.json\\\")\\n482:                 published = bool(state.get(\\\"monitor_pid\\\"))\\n483:                 if not published:\\n484:                     # worker \\u5df2\\u9000\\u51fa\\u4e14\\u4ece\\u672a\\u63a5\\u624b\\uff0c\\u8fd9\\u91cc\\u662f\\u552f\\u4e00\\u5199\\u8005\\uff0c\\u53ef\\u4ee5\\u5b89\\u5168\\u8bb0\\u4e3a\\u5931\\u8d25\\u5e76\\u91ca\\u653e\\u8bbe\\u5907\\u9501\\u3002\\n485:                     state = update_state(job, status=\\\"failed\\\", error=\\\"\\u540e\\u53f0 worker \\u672a\\u6210\\u529f\\u542f\\u52a8\\\", finished_at=time.time())\\n486:                     if lock:\\n487:                         lock.unlink(missing_ok=True)\\n488:                 break\\n489:             time.sleep(0.05)\\n490:         # \\u8d85\\u65f6\\u4ecd\\u672a\\u53d1\\u5e03\\u65f6 worker \\u53ef\\u80fd\\u4ecd\\u5728\\u542f\\u52a8\\uff1a\\u4e0d\\u5199 failed\\uff0c\\u4e0d\\u5220\\u9501\\uff0c\\u4ea4\\u7ed9 status\\uff0fwait \\u5224\\u65ad\\u3002\\n491:         result = {\\\"job\\\": str(job), \\\"kind\\\": kind, \\\"status\\\": state[\\\"status\\\"]}\\n492:         if not published and state[\\\"status\\\"] == \\\"starting\\\":\\n493:             result[\\\"note\\\"] = \\\"\\u540e\\u53f0 worker \\u5c1a\\u672a\\u63a5\\u624b\\uff0c\\u7528 status\\uff0fwait \\u7ee7\\u7eed\\u67e5\\u8be2\\\"\\n494:         return result\\n495:     except Exception:\\n496:         if not published and not (job / \\\"worker.pid\\\").exists():\\n497:             # worker \\u672a\\u542f\\u52a8\\uff1a\\u5220