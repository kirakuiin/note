\s*=\\\\s*(?!self\\\\.|cls\\\\.)[A-Za-z_]\\\\w*(?:\\\\.\\\\w+)+\\\\s*$\\\"),\\n45:               \\\"\\u7591\\u4f3c Mock \\u4fdd\\u5b58\\u7684\\u539f\\u51fd\\u6570\\\"))\\n46: LIST_LIMIT = 50  # \\u6bcf\\u7c7b\\u8def\\u5f84\\u6700\\u591a\\u5217\\u51fa\\u7684\\u6570\\u91cf\\uff0c\\u907f\\u514d\\u8f93\\u51fa\\u8fc7\\u957f\\u3002\\n47: REVIEW_MARK = \\\"review-mark.json\\\"  # \\u4f4d\\u4e8e\\u4e2a\\u4eba\\u76ee\\u5f55\\uff0c\\u8bb0\\u5f55 review \\u901a\\u8fc7\\u65f6\\u5404\\u6587\\u4ef6\\u7684\\u6307\\u7eb9\\u3002\\n48: \\n49: \\n50: class PrecheckError(Exception):\\n51:     \\\"\\\"\\\"\\u81ea\\u68c0\\u65e0\\u6cd5\\u5b8c\\u6210\\uff08svn \\u4e0d\\u53ef\\u7528\\u3001\\u4e0d\\u662f\\u5de5\\u4f5c\\u526f\\u672c\\u7b49\\uff09\\u3002\\\"\\\"\\\"\\n52: \\n53: \\n54: class SvnTimeout(PrecheckError):\\n55:     \\\"\\\"\\\"svn \\u547d\\u4ee4\\u8d85\\u65f6\\uff1a\\u547d\\u4ee4\\u53ef\\u80fd\\u4ecd\\u5728\\u6267\\u884c\\u6216\\u5df2\\u90e8\\u5206\\u751f\\u6548\\uff0c\\u8c03\\u7528\\u65b9\\u4e0d\\u80fd\\u628a\\u5b83\\u5f53\\u4f5c\\u201csvn \\u4e0d\\u53ef\\u7528\\u201d\\u3002\\\"\\\"\\\"\\n56: \\n57: \\n58: def decode_output(data):\\n59:     \\\"\\\"\\\"\\u89e3\\u7801 svn \\u8f93\\u51fa\\uff1a\\u5148\\u6309 UTF-8\\uff0c\\u5931\\u8d25\\u518d\\u6309 GB18030\\uff08\\u4e2d\\u6587 Windows \\u4e0a svn \\u7684\\u63d0\\u793a\\u7528\\u7cfb\\u7edf\\u4ee3\\u7801\\u9875\\uff09\\u3002\\\"\\\"\\\"\\n60:     try:\\n61:         return data.decode(\\\"utf-8\\\")\\n62:     except UnicodeDecodeError:\\n63:         return data.decode(\\\"gb18030\\\", \\\"replace\\\")\\n64: \\n65: \\n66: def svn_process(cwd, *args, timeout=120):\\n67:     \\\"\\\"\\\"\\u8fd0\\u884c svn\\uff08\\u81ea\\u52a8\\u52a0 --non-interactive\\uff09\\uff0c\\u8fd4\\u56de CompletedProcess\\uff0c\\u7531\\u8c03\\u7528\\u65b9\\u5224\\u65ad\\u9000\\u51fa\\u7801\\u548c\\u8f93\\u51fa\\u3002\\n68: \\n69:     \\u5176\\u4ed6\\u811a\\u672c\\u9700\\u8981\\u81ea\\u5df1\\u89e3\\u91ca\\u5931\\u8d25\\u539f\\u56e0\\u65f6\\u7528\\u5b83\\uff1b\\u53ea\\u5173\\u5fc3\\u6210\\u529f\\u8f93\\u51fa\\u65f6\\u7528 run_svn\\u3002\\n70: \\n71:     Raises:\\n72:         SvnTimeout: \\u8d85\\u8fc7 timeout \\u79d2\\u672a\\u7ed3\\u675f\\u3002\\n73:         PrecheckError: svn \\u4e0d\\u53ef\\u7528\\u3002\\n74:     \\\"\\\"\\\"\\n75:     try:\\n76:         return subprocess.run([\\\"svn\\\", *map(str, args), \\\"--non-interactive\\\"], cwd=cwd,\\n77:                               capture_output=True, timeout=timeout)\\n78:     except subprocess.TimeoutExpired:\\n79:         raise SvnTimeout(f\\\"svn {args[0] if args else ''} \\u8d85\\u8fc7 {timeout} \\u79d2\\u672a\\u7ed3\\u675f\\\") from None\\n80:     except (OSError, subprocess.SubprocessError) as error:\\n81:         raise PrecheckError(f\\\"svn \\u4e0d\\u53ef\\u7528\\uff1a{error}\\\") from None\\n82: \\n83: \\n84: def run_svn(root, *args, timeout=120):\\n85:     \\\"\\\"\\\"\\u5728\\u5de5\\u4f5c\\u526f\\u672c\\u6839\\u76ee\\u5f55\\u8fd0\\u884c\\u53ea\\u8bfb svn \\u547d\\u4ee4\\u5e76\\u8fd4\\u56de\\u6807\\u51c6\\u8f93\\u51fa\\u5b57\\u8282\\uff1b\\u5931\\u8d25\\u65f6\\u629b\\u51fa PrecheckError\\u3002\\\"\\\"\\\"\\n86:     completed = svn_process(root, *args, timeout=timeout)\\n87:     if completed.returncode:\\n88:         raise PrecheckError(decode_output(completed.stderr).strip() or f\\\"svn {args[0]} \\u5931\\u8d25\\\")\\n89:     if b\\\"155007\\\" in completed.stderr:  # \\u975e\\u5de5\\u4f5c\\u526f\\u672c\\u65f6 svn status \\u53ea\\u7ed9\\u8b66\\u544a\\u4e14\\u9000\\u51fa\\u7801\\u4e3a 0\\uff0c\\u4e0d\\u80fd\\u5f53\\u4f5c\\u201c\\u6ca1\\u6709\\u6539\\u52a8\\u201d\\n90:         raise PrecheckError(f\\\"\\u4e0d\\u662f SVN \\u5de5\\u4f5c\\u526f\\u672c\\uff1a{root}\\\")\\n91:     return completed.stdout\\n92: \\n93: \\n94: def svn_status(root):\\n95:     \\\"\\\"\\\"\\u8fd4\\u56de\\u4e3b\\u5de5\\u4f5c\\u526f\\u672c\\uff08\\u4e0d\\u542b\\u5916\\u94fe\\uff09\\u7684\\u72b6\\u6001\\u6761\\u76ee\\u5217\\u8868\\u3002\\n96: \\n97:     Returns:\\n98:         [{\\\"path\\\": \\u76f8\\u5bf9\\u8def\\u5f84\\uff08/ \\u5206\\u9694\\uff09, \\\"item\\\": \\u72b6\\u6001, \\\"props\\\": \\u5c5e\\u6027\\u72b6\\u6001,\\n99:           \\\"tree_conflict\\\": bool, \\\"changelist\\\": \\u53d8\\u66f4\\u5217\\u8868\\u540d\\u6216 None}]\\n100:     \\\"\\\"\\\"\\n101:     tree = ElementTree.fromstring(run_svn(root, \\\"status\\\", \\\"--xml\\\", \\\"--ignore-externals\\\", \\\".\\\"))\\n102:     entries = []\\n103:     for parent in list(tree.iter(\\\"target\\\")) + list(tree.iter(\\\"changelist\\\")):\\n104:         changelist = parent.get(\\\"name\\\") if parent.tag == \\\"changelist\\\" else None\\n105:         for entry in parent.findall(\\\"entry\\\"):\\n106:             status = entry.find(\\\"wc-status\\\")\\n107:             if status is None:\\n108:                 continue\\n109:             entries.append({\\\"path\\\": entry.get(\\\"path\\\", \\\"\\\").replace(\\\"\\\\\\\\\\\", \\\"/\\\"), \\\"item\\\": status.get(\\\"item\\\"),\\n110:                             \\\"props\\\": status.get(\\\"props\\\"), \\\"tree_conflict\\\": status.get(\\\"tree-conflicted\\\") == \\\"true\\\",\\n111:                             \\\"changelist\\\": changelist})\\n112:     return entries\\n113: \\n114: \\n115: def in_scope(entry):\\n116:     \\\"\\\"\\\"\\u6761\\u76ee\\u662f\\u5426\\u5c5e\\u4e8e\\u53ef\\u80fd\\u63d0\\u4ea4\\u7684\\u8303\\u56f4\\uff1a\\u4e0d\\u662f\\u672c\\u5730\\u8f85\\u52a9\\u6587\\u4ef6\\u3001\\u5bfc\\u8868\\u6570\\u636e\\uff0c\\u4e5f\\u4e0d\\u5728 ignore-on-commit \\u53d8\\u66f4\\u5217\\u8868\\u4e2d\\u3002\\\"\\\"\\\"\\n117:     first = entry[\\\"path\\\"].split(\\\"/\\\", 1)[0]\\n118:     return (first not in LOCAL_ONLY and first != DATA_DIRECTORY\\n119:             and entry.get(\\\"changelist\\\") != workspace.IGNORE_ON_COMMIT)\\n120: \\n121: \\n122: def classify(entries):\\n123:     \\\"\\\"\\\"\\u628a\\u72b6\\u6001\\u6761\\u76ee\\u5206\\u4e3a\\u5f85\\u63d0\\u4ea4\\u3001\\u6392\\u9664\\u3001\\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\u3001\\u5c5e\\u6027\\u6539\\u52a8\\u548c\\u963b\\u65ad\\u95ee\\u9898\\u3002\\\"\\\"\\\"\\n124:     result = {\\\"commit\\\": [], \\\"excluded_local_only\\\": [], \\\"excluded_data\\\": [], \\\"ignore_on_commit\\\": [],\\n125:               \\\"unversioned\\\": [], \\\"property_changes\\\": [], \\\"blocking\\\": []}\\n126:     for entry in entries:\\n127:         path, item = entry[\\\"path\\\"], entry[\\\"item\\\"]\\n128:         first = path.split(\\\"/\\\", 1)[0]\\n129:         if item in (\\\"external\\\", \\\"ignored\\\", \\\"normal\\\", \\\"none\\\") and entry[\\\"props\\\"] not in (\\\"modified\\\", \\\"conflicted\\\"):\\n130:             continue\\n131:         if item in BLOCKING_ITEMS or entry[\\\"tree_conflict\\\"] or entry[\\\"props\\\"] == \\\"conflicted\\\":\\n132:             result[\\\"blocking\\\"].append(f\\\"{path}\\uff1a\\u72b6\\u6001\\u4e3a {item}{'\\uff08\\u6811\\u51b2\\u7a81\\uff09' if entry['tree_conflict'] else ''}\\uff0c\\u5148\\u89e3\\u51b3\\u518d\\u63d0\\u4ea4\\\")\\n133:             continue\\n134:         if first in LOCAL_ONLY:\\n135:             result[\\\"excluded_local_only\\\"].append(path)\\n136:         elif first == DATA_DIRECTORY:\\n137:             result[\\\"excluded_data\\\"].append(path)\\n138:         elif entry.get(\\\"changelist\\\") == workspace.IGNORE_ON_COMMIT:\\n139:             result[\\\"ignore_on_commit\\\"].append(f\\\"{path}\\uff08{item if item in CHANGED_ITEMS else '\\u5c5e\\u6027\\u4fee\\u6539'}\\uff09\\\")\\n140:             continue\\n141:         elif item == \\\"unversioned\\\":\\n142:             result[\\\"unversioned\\\"].append(path)\\n143:         elif item in CHANGED_ITEMS:\\n144:             result[\\\"commit\\\"].append(f\\\"{path}\\uff08{item}\\uff09\\\")\\n145:         elif entry[\\\"props\\\"] == \\\"modified\\\":\\n146:             result[\\\"commit\\\"].append(f\\\"{path}\\uff08\\u5c5e\\u6027\\u4fee\\u6539\\uff09\\\")\\n147:         if entry[\\\"props\\\"] == \\\"modified\\\" and first not in LOCAL_ONLY:\\n148:             result[\\\"property_changes\\\"].append(path)\\n149:     return result\\n150: \\n151: \\n152: def source_targets(root, entries):\\n153:     \\\"\\\"\\\"\\u5f85\\u68c0\\u67e5\\u7684\\u6e90\\u7801\\uff1a[(\\u8def\\u5f84, \\u72b6\\u6001)]\\u3002\\u5305\\u62ec\\u5f85\\u63d0\\u4ea4\\u7684\\u4fee\\u6539\\uff0f\\u65b0\\u589e\\u6587\\u4ef6\\uff0c\\u4ee5\\u53ca\\u672a\\u7eb3\\u5165\\u7248\\u672c\\u63a7\\u5236\\u7684\\u6e90\\u7801\\uff08\\u542b\\u672a\\u7eb3\\u7ba1\\u76ee\\u5f55\\u4e2d\\u7684\\uff09\\u3002\\n154: \\n155:     \\u7f16\\u7801\\u68c0\\u67e5\\u548c\\u8c03\\u8bd5\\u6b8b\\u7559\\u626b\\u63cf\\u5171\\u7528\\u8fd9\\u4efd\\u6e05\\u5355\\uff0c\\u8303\\u56f4\\u4fdd\\u6301\\u4e00\\u81f4\\u3002\\u5df2\\u52a0\\u5165\\u7248\\u672c\\u63a7\\u5236\\u7684\\u76ee\\u5f55\\u4e2d\\uff0c\\u5b50\\u6587\\u4ef6\\u5404\\u81ea\\u662f\\u72ec\\u7acb\\u7684\\u72b6\\u6001\\u6761\\u76ee\\u3002\\n156:     \\\"\\\"\\\"\\n157:     targets = {}\\n158:     for entry in entries:\\n159:         if not in_scope(entry) or entry[\\\"item\\\"] not in (\\\"modified\\\", \\\"added\\\", \\\"replaced\\\", \\\"unversioned\\\"):\\n160:             continue\\n161:         path = root / entry[\\\"path\\\"]\\n162:         candidates = path.rglob(\\\"*\\\") if entry[\\\"item\\\"] == \\\"unversioned\\\" and path.is_dir() else [path]\\n163:         for candidate in candidates:\\n164:             if candidate.is_file() and candidate.suffix in SOURCE_SUFFIXES:\\n165:                 targets[candidate] = entry[\\\"item\\\"]\\n166:     return sorted(targets.items())\\n167: \\n168: \\n169: def source_files(root, entries):\\n170:     \\\"\\\"\\\"\\u9700\\u8981\\u68c0\\u67e5\\u7f16\\u7801\\u548c\\u8bed\\u6cd5\\u7684\\u6e90\\u7801\\u6587\\u4ef6\\uff08\\u89c1 source_targets\\uff09\\u3002\\\"\\\"\\\"\\n171:     return [path for path, _ in source_targets(root, entries)]\\n172: \\n173: \\n174: def check_sources(root, files):\\n175:     \\\"\\\"\\\"\\u68c0\\u67e5\\u7f16\\u7801\\u4e0e\\u8bed\\u6cd5\\u3002\\u9879\\u76ee\\u6709\\u7f16\\u7801\\u68c0\\u67e5\\u5de5\\u5177\\u65f6\\u4ee5\\u5b83\\u4e3a\\u51c6\\uff08--expect-utf8 --compile\\uff09\\uff0c\\u5426\\u5219\\u7528\\u5185\\u7f6e\\u68c0\\u67e5\\u3002\\n176: \\n177:     Returns:\\n178:         (\\u963b\\u65ad\\u95ee\\u9898, \\u8b66\\u544a, \\u4f7f\\u7528\\u7684\\u68c0\\u67e5\\u65b9\\u5f0f)\\n179:     \\\"\\\"\\\"\\n180:     blocking, warnings = [], []\\n181:     if not files:\\n182:         return blocking, warnings, \\\"\\u65e0\\u9700\\u68c0\\u67e5\\\"\\n183:     relative = [p.relative_to(root).as_posix() for p in files]\\n184:     for path, rel in zip(files, relative):\\n185:         data = path.read_bytes()\\n186:         if b\\\"\\\\r\\\\n\\\" in data and data.replace(b\\\"\\\\r\\\\n\\\", b\\\"\\\").count(b\\\"\\\\n\\\"):\\n187:             warnings.append(f\\\"{rel}\\uff1a\\u6df7\\u7528 CRLF \\u548c LF \\u6362\\u884c\\\")\\n188:     tool = root / ENCODING_TOOL\\n189:     if tool.is_file():\\n190:         try:\\n191:             completed = subprocess.run([sys.executable, \\\"-B\\\", str(tool), \\\"--root\\\", \\\".\\\", \\\"--expect-utf8\\\", \\\"--compile\\\",\\n192:                                         *relative], cwd=root, capture_output=True, timeout=300)\\n193:         except subprocess.TimeoutExpired:\\n194:             raise PrecheckError(f\\\"{ENCODING_TOOL} \\u8d85\\u8fc7 300 \\u79d2\\u672a\\u7ed3\\u675f\\\") from None\\n195:         output = completed.stdout.decode(\\\"utf-8\\\", \\\"replace\\\").splitlines()\\n196:         issues = [line for line in output if line.strip() and not line.startswith(\\\"OK\\\")]\\n197:         if completed.returncode:\\n198:             blocking += issues or [f\\\"{ENCODING_TOOL} \\u8fd4\\u56de {completed.returncode}\\\"]\\n199:         else:\\n200:             warnings += issues\\n201:         return blocking, warnings, ENCODING_TOOL\\n202:     for path, rel in zip(files, relative):\\n203:         data = path.read_bytes()\\n204:         try:\\n205:             text = data.decode(\\\"utf-8-sig\\\")\\n206:         except UnicodeDecodeError as error:\\n207:             blocking.append(f\\\"{rel}\\uff1a\\u4e0d\\u662f\\u6709\\u6548\\u7684 UTF-8\\uff08{error.reason}\\uff0c\\u4f4d\\u7f6e {error.start}\\uff09\\\")\\n208:             continue\\n209:         header = re.search(r\\\"coding[:=]\\\\s*([-\\\\w.]+)\\\", \\\"\\\\n\\\".join(text.splitlines()[:2]))\\n210:         if header and header[1].lower().replace(\\\"_\\\", \\\"-\\\") not in (\\\"utf-8\\\", \\\"utf8\\\"):\\n211:             blocking.append(f\\\"{rel}\\uff1a\\u7f16\\u7801\\u58f0\\u660e\\u4e3a {header[1]}\\uff0c\\u5e94\\u4e3a utf-8\\\")\\n212:         if path.suffix == \\\".py\\\":\\n213:             try:\\n214:                 compile(text, rel, \\\"exec\\\", dont_inherit=True)\\n215:             except SyntaxError as error:\\n216:                 blocking.append(f\\\"{rel}:{error.lineno}\\uff1a\\u8bed\\u6cd5\\u9519\\u8bef\\uff1a{error.msg}\\\")\\n217:     return blocking, warnings, \\\"\\u5185\\u7f6e\\u68c0\\u67e5\\uff08\\u9879\\u76ee\\u6ca1\\u6709\\u7f16\\u7801\\u68c0\\u67e5\\u5de5\\u5177\\uff09\\\"\\n218: \\n219: \\n220: def decode_line(data):\\n221:     \\\"\\\"\\\"\\u89e3\\u7801\\u5355\\u884c\\u6216\\u5355\\u4e2a\\u6587\\u4ef6\\uff1a\\u5148 UTF-8\\uff0c\\u5931\\u8d25\\u518d\\u6309 GB18030\\uff08\\u517c\\u5bb9\\u7cfb\\u7edf\\u4ee3\\u7801\\u9875 cp936\\uff09\\uff0c\\u65e0\\u6cd5\\u89e3\\u7801\\u7684\\u5b57\\u8282\\u66ff\\u6362\\u6389\\u3002\\\"\\\"\\\"\\n222:     try:\\n223:         return data.decode(\\\"utf-8-sig\\\")\\n224:     except UnicodeDecodeError:\\n225:         return data.decode(\\\"gb18030\\\", \\\"replace\\\")\\n226: \\n227: \\n228: def diff_added_lines(data):\\n229:     \\\"\\\"\\\"\\u4ece svn diff \\u7684\\u539f\\u59cb\\u5b57\\u8282\\u4e2d\\u53d6\\u51fa\\u65b0\\u589e\\u884c\\u3002\\n230: \\n231:     svn diff \\u7684\\u6587\\u4ef6\\u5934\\uff08Index:\\u3001---\\u3001+++\\uff09\\u7528\\u7cfb\\u7edf\\u4ee3\\u7801\\u9875\\u8f93\\u51fa\\uff0c\\u5185\\u5bb9\\u884c\\u662f\\u6587\\u4ef6\\u539f\\u59cb\\u5b57\\u8282\\uff08\\u901a\\u5e38 UTF-8\\uff09\\uff0c\\n232:     \\u6574\\u6bb5\\u89e3\\u7801\\u4f1a\\u56e0\\u7f16\\u7801\\u6df7\\u7528\\u800c\\u5931\\u8d25\\uff0c\\u56e0\\u6b64\\u9010\\u884c\\u89e3\\u7801\\u3002\\u53ea\\u628a @@ \\u5757\\u5185\\u4ee5 + \\u5f00\\u5934\\u7684\\u884c\\u7b97\\u4f5c\\u65b0\\u589e\\uff1b\\n233:     Index: \\u6216 Property changes on: \\u5f00\\u59cb\\u65b0\\u7684\\u5934\\u90e8\\uff0c\\u5c5e\\u6027\\u5757\\uff08## \\u5f00\\u5934\\uff09\\u4e2d\\u7684\\u884c\\u4e0d\\u7b97\\u6e90\\u7801\\u65b0\\u589e\\u3002\\n234:     \\\"\\\"\\\"\\n235:     lines, in_hunk = [], False\\n236:     for raw in data.splitlines():\\n237:         if raw.startswith((b\\\"Index: \\\", b\\\"Property changes on: \\\")):\\n238:             in_hunk = False\\n239:         elif raw.startswith(b\\\"@@\\\"):\\n240:             in_hunk = True\\n241:         elif in_hunk and raw.startswith(b\\\"+\\\"):\\n242:             lines.append(decode_line(raw[1:]))\\n243:     return lines\\n244: \\n245: \\n246: def added_lines(root, relative, item):\\n247:     \\\"\\\"\\\"\\u8fd4\\u56de\\u672c\\u6b21\\u65b0\\u589e\\u7684\\u884c\\uff1a\\u4fee\\u6539\\u7684\\u6587\\u4ef6\\u53d6 svn diff \\u7684\\u65b0\\u589e\\u884c\\uff0c\\u65b0\\u6587\\u4ef6\\u53d6\\u5168\\u6587\\u3002\\\"\\\"\\\"\\n248:     path = root / relative\\n249:     if item in (\\\"added\\\", \\\"unversioned\\\"):\\n250:         return decode_line(path.read_bytes()).splitlines() if path.is_file() else []\\n251:     return diff_added_lines(run_svn(root, \\\"diff\\\", \\\"--internal-diff\\\", relative))\\n252: \\n253: \\n254: def check_leftovers(root, entries):\\n255:     \\\"\\\"\\\"\\u626b\\u63cf\\u5f85\\u63d0\\u4ea4\\u6e90\\u7801\\u65b0\\u589e\\u884c\\u4e2d\\u7684\\u7591\\u4f3c\\u8c03\\u8bd5\\u6b8b\\u7559\\uff0c\\u53ea\\u8fd4\\u56de\\u8b66\\u544a\\uff1b\\u8303\\u56f4\\u4e0e\\u7f16\\u7801\\u68c0\\u67e5\\u76f8\\u540c\\uff08\\u89c1 source_targets\\uff09\\u3002\\\"\\\"\\\"\\n256:     warnings = []\\n257:     for path, item in source_targets(root, entries):\\n258:         relative = path.relative_to(root).as_posix()\\n259:         for line in added_lines(root, relative, item):\\n260:             for pattern, label in LEFTOVERS:\\n261:                 if pattern.search(line):\\n262:                     warnings.append(f\\\"{relative}\\uff1a{label}\\uff1a{line.strip()[:80]}\\\")\\n263:     return warnings\\n264: \\n265: \\n266: def review_fingerprints(root, entries):\\n267:     \\\"\\\"\\\"\\u53ef\\u80fd\\u63d0\\u4ea4\\u7684\\u5404\\u6587\\u4ef6\\u6307\\u7eb9\\uff1a{\\u76f8\\u5bf9\\u8def\\u5f84: \\\"\\u72b6\\u6001/\\u5c5e\\u6027\\u72b6\\u6001:\\u5185\\u5bb9 sha256\\\"}\\u3002\\n268: \\n269:     \\u8303\\u56f4\\u4e0e classify \\u5217\\u51fa\\u7684\\u6539\\u52a8\\u76f8\\u540c\\uff08\\u4e0d\\u542b\\u672c\\u5730\\u8f85\\u52a9\\u6587\\u4ef6\\u3001\\u5bfc\\u8868\\u6570\\u636e\\u548c ignore-on-commit\\uff09\\uff1b\\n270:     \\u672a\\u7eb3\\u7ba1\\u76ee\\u5f55\\u5c55\\u5f00\\u4e3a\\u5176\\u4e2d\\u7684\\u6587\\u4ef6\\uff0c\\u5df2\\u5220\\u9664\\u6216\\u7f3a\\u5931\\u7684\\u6587\\u4ef6\\u5185\\u5bb9\\u8bb0\\u4e3a \\\"-\\\"\\u3002\\n271:     \\\"\\\"\\\"\\n272:     result = {}\\n273:     for entry in entries:\\n274:         item, props = entry[\\\"item\\\"], entry.get(\\\"props\\\")\\n275:         if not in_scope(entry) or (item in (\\\"external\\\", \\\"ignored\\\", \\\"normal\\\", \\\"none\\\")\\n276:                                    and props not in (\\\"modified\\\", \\\"conflicted\\\")):\\n277:             continue\\n278:         path = root / entry[\\\"path\\\"]\\n279:         if item == \\\"unversioned\\\" and path.is_dir():\\n280:             files = [(p, p.relative_to(root).as_posix()) for p in path.rglob(\\\"*\\\") if p.is_file()]\\n281:         else:\\n282:             files = [(path, entry[\\\"path\\\"])]\\n283:         for file, relative in files:\\n284:             digest = hashlib.sha256(file.read_bytes()).hexdigest() if file.is_file() else \\\"-\\\"\\n285:             result[relative] = f\\\"{item}/{props}:{digest}\\\"\\n286:     return result\\n287: \\n288: \\n289: def mark_reviewed(root_arg):\\n290:     \\\"\\\"\\\"\\u8bb0\\u5f55 review \\u901a\\u8fc7\\u65f6\\u7684\\u6307\\u7eb9\\u5230\\u4e2a\\u4eba\\u76ee\\u5f55\\u7684 review-mark.json\\uff0c\\u8986\\u76d6\\u65e7\\u8bb0\\u5f55\\u3002\\\"\\\"\\\"\\n291:     root = Path(root_arg).resolve()\\n292:     workspace.require_initialized(root)  # \\u4e0d\\u5728\\u672a\\u521d\\u59cb\\u5316\\u7684\\u76ee\\u5f55\\u91cc\\u65b0\\u5efa\\u4e2a\\u4eba\\u76ee\\u5f55\\n293:     files = review_fingerprints(root, svn_status(root))\\n294:     marked_at = datetime.now().astimezone().isoformat(timespec=\\\"seconds\\\")\\n295:     path = root / workspace.DIRECTORY / REVIEW_MARK\\n296:     workspace.apply_changes([(path, workspace.read_bytes(path),\\n297:                               workspace.json_bytes({\\\"marked_at\\\": marked_at, \\\"files\\\": files}))])\\n298:     return {\\\"root\\\": str(root), \\\"review_mark\\\": marked_at, \\\"files\\\": len(files), \\\"path\\\": str(path)}\\n299: \\n300: \\n301: def review_delta(root, entries):\\n302:     \\\"\\\"\\\"\\u4e0e review \\u8bb0\\u5f55\\u6bd4\\u8f83\\uff1a\\u8fd4\\u56de (\\u8bb0\\u5f55\\u65f6\\u95f4\\u6216 None, review \\u540e\\u53d8\\u5316\\u7684\\u6587\\u4ef6, \\u8b66\\u544a)\\u3002\\n303: \\n304:     \\u53d8\\u5316\\u5305\\u62ec\\u5185\\u5bb9\\u6216\\u72b6\\u6001\\u4e0d\\u540c\\u3001\\u8bb0\\u5f55\\u540e\\u65b0\\u51fa\\u73b0\\u7684\\u6539\\u52a8\\uff0c\\u4ee5\\u53ca\\u8bb0\\u5f55\\u4e2d\\u6709\\u3001\\u73b0\\u5728\\u5df2\\u6ca1\\u6709\\u6539\\u52a8\\u7684\\u6587\\u4ef6\\u3002\\n305:     \\\"\\\"\\\"\\n306:     path = root / workspace.DIRECTORY / REVIEW_MARK\\n307:     try:\\n308:         raw = workspace.read_bytes(path)\\n309:         if raw is None:\\n310:             return None, [], []\\n311:         mark = workspace.parse_json(raw, path)\\n312:         if not isinstance(mark.get(\\\"marked_at\\\"), str) or not isinstance(mark.get(\\\"files\\\"), dict):\\n313:             raise workspace.WorkspaceError(f\\\"\\u7ed3\\u6784\\u65e0\\u6548\\uff1a{path}\\\")\\n314:     except (workspace.WorkspaceError, OSError) as error:\\n315:         return None, [], [f\\\"review \\u8bb0\\u5f55\\u65e0\\u6cd5\\u8bfb\\u53d6\\uff0c\\u6309\\u6ca1\\u6709\\u8bb0\\u5f55\\u5904\\u7406\\uff1a{error}\\\"]\\n316:     current, old = review_fingerprints(root, entries), mark[\\\"files\\\"]\\n317:     changed = sorted(name for name in current.keys() | old.keys() if current.get(name) != old.get(name))\\n318:     return mark[\\\"marked_at\\\"], changed, []\\n319: \\n320: \\n321: def precheck(root_arg):\\n322:     \\\"\\\"\\\"\\u6267\\u884c\\u5168\\u90e8\\u81ea\\u68c0\\u5e76\\u8fd4\\u56de\\u7ed3\\u679c\\u5b57\\u5178\\uff08\\u89c1\\u6a21\\u5757\\u8bf4\\u660e\\uff09\\u3002\\\"\\\"\\\"\\n323:     root = Path(root_arg).resolve()\\n324:     entries = svn_status(root)\\n325:     result = classify(entries)\\n326:     blocking, warnings, method = check_sources(root, source_files(root, entries))\\n327:     result[\\\"blocking\\\"] += blocking\\n328:     result[\\\"warnings\\\"] = warnings + check_leftovers(root, entries)\\n329:     result[\\\"review_mark\\\"], result[\\\"changed_since_review\\\"], mark_warnings = review_delta(root, entries)\\n330:     result[\\\"warnings\\\"] += mark_warnings\\n331:     if result[\\\"property_changes\\\"]:\\n332:         result[\\\"warnings\\\"].append(\\\"\\u6709\\u5c5e\\u6027\\u6539\\u52a8\\uff08\\u53ef\\u80fd\\u662f\\u5916\\u94fe\\u66f4\\u65b0\\uff09\\uff1a\\u5efa\\u8bae\\u4e0e\\u4ee3\\u7801\\u5206\\u5f00\\u63d0\\u4ea4\\uff0c\\u5e76\\u5728\\u8bf4\\u660e\\u672b\\u5c3e\\u52a0 [NO MERGE]\\\")\\n333:     if result[\\\"excluded_data\\\"]:\\n334:         result[\\\"warnings\\\"].append(\\\"\\u5bfc\\u8868\\u6570\\u636e\\u9ed8\\u8ba4\\u4e0d\\u63d0\\u4ea4\\uff0c\\u5df2\\u4ece\\u5f85\\u63d0\\u4ea4\\u6e05\\u5355\\u6392\\u9664\\uff0c\\u8bf7\\u81ea\\u884c\\u5904\\u7406\\\")\\n335:     for key in (\\\"commit\\\", \\\"excluded_local_only\\\", \\\"excluded_data\\\", \\\"ignore_on_commit\\\", \\\"unversioned\\\", \\\"property_changes\\\",\\n336:                 \\\"changed_since_review\\\", \\\"warnings\\\"):\\n337:         if len(result[key]) > LIST_LIMIT:\\n338:             result[key] = result[key][:LIST_LIMIT] + [f\\\"\\u2026\\u2026\\u53e6\\u6709 {len(result[key]) - LIST_LIMIT} \\u9879\\u672a\\u5217\\u51fa\\\"]\\n339:     return {\\\"root\\\": str(root), \\\"branch\\\": workspace.svn_branch(root), \\\"source_check\\\": method, **result}\\n340: \\n341: \\n342: def main():\\n343:     for stream in (sys.stdout, sys.stderr):\\n344:         if hasattr(stream, \\\"reconfigure\\\"):\\n345:             stream.reconfigure(encoding=\\\"utf-8\\\")\\n346:     parser = argparse.ArgumentParser(description=__doc__)\\n347:     parser.add_argument(\\\"--root\\\", default=\\\".\\\")\\n348:     parser.add_argument(\\\"--mark-reviewed\\\", action=\\\"store_true\\\",\\n349:                         help=\\\"\\u53ea\\u8bb0\\u5f55\\u5f53\\u524d\\u6539\\u52a8\\u7684 review \\u6307\\u7eb9\\uff08\\u5199 .mhxy-workspace/review-mark.json\\uff09\\uff0c\\u4e0d\\u505a\\u81ea\\u68c0\\\")\\n350:     args = parser.parse_args()\\n351:     try:\\n352:         if args.mark_reviewed:\\n353:             print(json.dumps(mark_reviewed(args.root), ensure_ascii=False, indent=2))\\n354:             return 0\\n355:         result = precheck(args.root)\\n356:     except (PrecheckError, workspace.WorkspaceError, OSError, ElementTree.ParseError,\\n357:             subprocess.SubprocessError) as error:\\n358:         print(json.dumps({\\\"error\\\": str(error)}, ensure_ascii=False), file=sys.stderr)\\n359:         return 1\\n360:     print(json.dumps(result, ensure_ascii=False, indent=2))\\n361:     return 2 if result[\\\"blocking\\\"] else 0\\n362: \\n363: \\n364: if __name__ == \\\"__main__\\\":\\n365:     sys.exit(main())\", \"references/exec-check.md\": \"1: # \\u6539\\u52a8\\u6267\\u884c\\u68c0\\u67e5\\